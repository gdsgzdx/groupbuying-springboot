# 应用基本配置  
PORT=5000# 服务器运行的端口

# 数据库配置
DB_HOST=localhost# 数据库主机地址
DB_PORT=3306# 数据库端口号
DB_USER=root# 数据库用户
DB_PASSWORD=jiusan87# 数据库密码
DB_NAME=groupbuyingsystem# 数据库名
DB_DIALECT=mysql# 数据库方言，可能为 postgres, mysql, sqlite 等

# JWT 配置
JWT_SECRET=your_jwt_secret_key# JWT 加密秘钥，确保转存到安全的地方
JWT_EXPIRATION=1h# JWT 过期时间

# 邮件服务配置
MAIL_HOST=smtp.example.com# 邮件服务地址
MAIL_PORT=587# 邮件服务端口
MAIL_USER=youremail@example.com#发件人邮箱
MAIL_PASSWORD=your-email-password# 邮件服务密码（考虑使用应用专用密码）
MAIL_FROM=youremail@example.com# 发件人邮箱

# 腾讯云 API 密钥
TENCENT_CLOUD_SECRET_ID=your_tencent_cloud_secret_id# API 密钥 ID
TENCENT_CLOUD_SECRET_KEY=your_tencent_cloud_secret_key# API 密钥
TENCENT_CLOUD_SMS_APP_ID=your_sms_sdk_app_id# 短信应用 ID
TENCENT_CLOUD_SMS_TEMPLATE_ID=your_sms_template_id# 短信模板 ID
TENCENT_CLOUD_SMS_SIGN=your_sms_sign# 短信签名

# 其他配置
DEBUG=true# 启用调试模式