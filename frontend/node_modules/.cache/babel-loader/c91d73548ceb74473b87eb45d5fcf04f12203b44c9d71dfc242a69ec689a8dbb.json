{"ast":null,"code":"import { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport request from \"@/utils/request\";\nconst logo = \"/assets/logo.png\";\nexport default {\n  __name: 'LoginPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loginFormRef = ref(null);\n    const router = useRouter();\n\n    // 登录表单数据\n    const loginForm = reactive({\n      username: \"\",\n      password: \"\"\n    });\n\n    // 表单验证规则\n    const loginRules = {\n      username: [{\n        required: true,\n        message: \"请输入用户名\",\n        trigger: \"blur\"\n      }],\n      password: [{\n        required: true,\n        message: \"请输入密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        message: \"密码不能少于6位\",\n        trigger: \"blur\"\n      }]\n    };\n\n    // 加载状态\n    const isLoading = ref(false);\n\n    // 登录处理\n    const handleLogin = () => {\n      loginFormRef.value.validate(async valid => {\n        if (valid) {\n          try {\n            isLoading.value = true;\n            console.log(\"发送登录请求:\", {\n              username: loginForm.username,\n              password: loginForm.password\n            });\n            const response = await request({\n              url: \"/api/auth/login\",\n              method: \"post\",\n              data: {\n                username: loginForm.username,\n                password: loginForm.password\n              }\n            });\n            console.log(\"登录响应:\", response);\n            if (response.code === 200) {\n              const token = response.data;\n              localStorage.setItem(\"token\", token);\n              ElMessage.success(\"登录成功\");\n              router.push(\"/\");\n            }\n          } catch (error) {\n            console.error(\"登录错误:\", error);\n            ElMessage.error(error.response?.data?.message || \"登录失败\");\n          } finally {\n            isLoading.value = false;\n          }\n        }\n      });\n    };\n\n    // 注册处理\n    const handleRegister = () => {\n      router.push({\n        name: \"Register\"\n      });\n    };\n\n    // 找回密码处理\n    const handleForgotPassword = () => {\n      router.push({\n        name: \"ForgetPassword\"\n      });\n    };\n    const __returned__ = {\n      logo,\n      loginFormRef,\n      router,\n      loginForm,\n      loginRules,\n      isLoading,\n      handleLogin,\n      handleRegister,\n      handleForgotPassword,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get request() {\n        return request;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","ElMessage","request","logo","loginFormRef","router","loginForm","username","password","loginRules","required","message","trigger","min","isLoading","handleLogin","value","validate","valid","console","log","response","url","method","data","code","token","localStorage","setItem","success","push","error","handleRegister","name","handleForgotPassword"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/login/LoginPage.vue"],"sourcesContent":["<!-- frontend/src/views/login/LoginPage.vue -->\n<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">团团赚拼购</h1>\n      </div>\n\n      <El-form\n        ref=\"loginFormRef\"\n        :model=\"loginForm\"\n        :rules=\"loginRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"username\">\n          <El-input\n            v-model=\"loginForm.username\"\n            prefix-icon=\"User\"\n            placeholder=\"用户名\"\n            clearable\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"password\">\n          <El-input\n            v-model=\"loginForm.password\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"密码\"\n            show-password\n            @keyup.enter=\"handleLogin\"\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button\n            type=\"primary\"\n            class=\"login-btn\"\n            :loading=\"isLoading\"\n            :disabled=\"isLoading\"\n            @click=\"handleLogin\"\n          >\n            登录\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"handleRegister\">立即注册</El-link>\n          <El-link type=\"info\" @click=\"handleForgotPassword\">忘记密码</El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport request from \"@/utils/request\";\n\nconst logo = \"/assets/logo.png\";\nconst loginFormRef = ref(null);\nconst router = useRouter();\n\n// 登录表单数据\nconst loginForm = reactive({\n  username: \"\",\n  password: \"\",\n});\n\n// 表单验证规则\nconst loginRules = {\n  username: [\n    {\n      required: true,\n      message: \"请输入用户名\",\n      trigger: \"blur\",\n    },\n  ],\n  password: [\n    {\n      required: true,\n      message: \"请输入密码\",\n      trigger: \"blur\",\n    },\n    {\n      min: 6,\n      message: \"密码不能少于6位\",\n      trigger: \"blur\",\n    },\n  ],\n};\n\n// 加载状态\nconst isLoading = ref(false);\n\n// 登录处理\nconst handleLogin = () => {\n  loginFormRef.value.validate(async (valid) => {\n    if (valid) {\n      try {\n        isLoading.value = true;\n        console.log(\"发送登录请求:\", {\n          username: loginForm.username,\n          password: loginForm.password,\n        });\n\n        const response = await request({\n          url: \"/api/auth/login\",\n          method: \"post\",\n          data: {\n            username: loginForm.username,\n            password: loginForm.password,\n          },\n        });\n\n        console.log(\"登录响应:\", response);\n\n        if (response.code === 200) {\n          const token = response.data;\n          localStorage.setItem(\"token\", token);\n          ElMessage.success(\"登录成功\");\n          router.push(\"/\");\n        }\n      } catch (error) {\n        console.error(\"登录错误:\", error);\n        ElMessage.error(error.response?.data?.message || \"登录失败\");\n      } finally {\n        isLoading.value = false;\n      }\n    }\n  });\n};\n\n// 注册处理\nconst handleRegister = () => {\n  router.push({ name: \"Register\" });\n};\n\n// 找回密码处理\nconst handleForgotPassword = () => {\n  router.push({ name: \"ForgetPassword\" });\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(to right, #3494e6, #ec6ead);\n}\n\n.login-wrapper {\n  background: white;\n  padding: 30px;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  width: 400px;\n}\n\n.logo-title-container {\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n.logo {\n  width: 80px;\n  height: 80px;\n  margin-bottom: 10px;\n}\n\n.system-title {\n  font-size: 24px;\n  color: #303133;\n  margin: 0;\n}\n\n.login-form {\n  margin-top: 20px;\n}\n\n.login-btn {\n  width: 100%;\n}\n\n.login-extra {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 15px;\n}\n</style>\n"],"mappings":"AAyDA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,OAAO,MAAM,iBAAiB;AAErC,MAAMC,IAAI,GAAG,kBAAkB;;;;;;;IAC/B,MAAMC,YAAY,GAAGL,GAAG,CAAC,IAAI,CAAC;IAC9B,MAAMM,MAAM,GAAGL,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMM,SAAS,GAAGR,QAAQ,CAAC;MACzBS,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ,CAAC,CAAC;;