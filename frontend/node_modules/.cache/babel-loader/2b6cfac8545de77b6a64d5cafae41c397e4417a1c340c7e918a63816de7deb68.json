{"ast":null,"code":"import { ref } from 'vue'; // 引入 ref\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\n// 定义 registerForm\n\nexport default {\n  __name: 'RegisterPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const registerForm = ref({\n      username: '',\n      phone: '',\n      verifyCode: '',\n      password: '',\n      confirmPassword: ''\n    });\n\n    // [保持原有的逻辑不变]\n\n    const __returned__ = {\n      registerForm,\n      ref,\n      get User() {\n        return User;\n      },\n      get Mobile() {\n        return Mobile;\n      },\n      get Lock() {\n        return Lock;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get logo() {\n        return logo;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","User","Mobile","Lock","ChatDotRound","logo","registerForm","username","phone","verifyCode","password","confirmPassword"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/RegisterPage.vue"],"sourcesContent":["<template>\n  <div class=\"register-container\">\n    <div class=\"register-wrapper\">\n      <div class=\"register-form-container\">\n        <div class=\"register-header\">\n          <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n          <h2>用户注册</h2>\n        </div>\n\n        <El-form\n          ref=\"registerFormRef\"\n          :model=\"registerForm\"\n          :rules=\"registerRules\"\n          class=\"register-form\"\n        >\n          <El-form-item prop=\"username\">\n            <El-input\n              v-model=\"registerForm.username\"\n              placeholder=\"用户名\"\n              clearable\n            >\n              <template #prefix>\n                <El-icon><User /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"phone\">\n            <El-input\n              v-model=\"registerForm.phone\"\n              placeholder=\"手机号\"\n              clearable\n            >\n              <template #prefix>\n                <El-icon><Mobile /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"verifyCode\" class=\"verify-code-item\">\n            <El-input\n              v-model=\"registerForm.verifyCode\"\n              placeholder=\"验证码\"\n              class=\"verify-code-input\"\n            >\n              <template #prefix>\n                <El-icon><ChatDotRound /></El-icon>\n              </template>\n              <template #append>\n                <El-button\n                  :disabled=\"countDown > 0\"\n                  type=\"primary\"\n                  plain\n                  @click=\"sendVerifyCode\"\n                >\n                  {{ countDown > 0 ? `重发(${countDown}s)` : \"获取验证码\" }}\n                </El-button>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"password\">\n            <El-input\n              v-model=\"registerForm.password\"\n              type=\"password\"\n              placeholder=\"密码\"\n              show-password\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"confirmPassword\">\n            <El-input\n              v-model=\"registerForm.confirmPassword\"\n              type=\"password\"\n              placeholder=\"确认密码\"\n              show-password\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item>\n            <El-button\n              type=\"primary\"\n              class=\"register-btn\"\n              round\n              block\n              @click=\"handleRegister\"\n            >\n              注 册\n            </El-button>\n          </El-form-item>\n\n          <div class=\"register-footer\">\n            <El-link type=\"primary\" @click=\"$router.push('/login')\">\n              已有账号？立即登录\n            </El-link>\n          </div>\n        </El-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue';  // 引入 ref\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\n// 定义 registerForm\nconst registerForm = ref({\n  username: '',\n  phone: '',\n  verifyCode: '',\n  password: '',\n  confirmPassword: '',\n});\n\n\n// [保持原有的逻辑不变]\n</script>\n\n<style lang=\"scss\" scoped>\n// [样式保持不变]\n</style>\n"],"mappings":"AA+GA,SAASA,GAAG,QAAQ,KAAK,CAAC,CAAE;AAC5B,SAASC,IAAI,EAAEC,MAAM,EAAEC,IAAI,EAAEC,YAAY,QAAQ,yBAAyB;AAC1E,OAAOC,IAAI,MAAM,mBAAmB;AACpC;;;;;;;;IACA,MAAMC,YAAY,GAAGN,GAAG,CAAC;MACvBO,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,UAAU,EAAE,EAAE;MACdC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE;IACnB,CAAC,CAAC;;IAGF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}