         :min=\"1\"\n            :max=\"scope.row.cartProduct.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.id)\"\n            >删除</El-button\n          >\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>\n        总计: <span class=\"total-price\">¥{{ totalPrice.toFixed(2) }}</span>\n      </h2>\n      <El-button class=\"checkout-button\" type=\"primary\" @click=\"checkout\"\n        >去结算</El-button\n      >\n    </div>\n\n    <p v-if=\"!cartItems.length\" class=\"empty-cart\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nconst userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\nconst cartItems = ref([]); // 初始化购物车项\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n    const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n    return total + price * quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const response = await axios.get(\n      `http://localhost:5000/api/cart/${userId}`,\n    );\n\n    // 确保成功获取，并获取数据\n    if (response.data.success && Array.isArray(response.data.data)) {\n      cartItems.value = response.data.data; // 将数据赋值给购物车项\n    } else {\n      cartItems.value = []; // 赋值为空数组\n    }\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\n// 更新商品数量\nconst updateQuantity = async (item) => {\n  console.log(\"当前 userId:\", userId); // 添加这行代码以调试\n  console.log(\"商品数量更新: \", item);\n  try {\n    const response = await axios.put(\n      `http://localhost:5000/api/cart/${userId}/${item.cartProduct.id}`, // 使用路径参数\n      {\n        quantity: item.quantity, // 提交的新数量\n      },\n    );\n\n    if (response.data.success) {\n      console.log(\"数量更新成功\");\n    } else {\n      console.error(\"数量更新失败:\", response.data.message);\n    }\n  } catch (error) {\n    console.error(\"更新数量失败:\", error);\n  }\n};\n\n// 删除商品\nconst removeItem = async (productId) => {\n  console.log(\"删除按钮被点击，商品 ID:\", productId); // 确认传递的商品 ID\n  console.log(\"当前购物车商品:\", cartItems.value); // 打印当前购物车商品\n\n  // 查找当前商品的索引，将 productId 与 cartItems 中的 product_id 进行比较\n  const index = cartItems.value.findIndex(\n    (item) => item.product_id === Number(productId), // 使用 product_id 查找\n  );\n\n  console.log(\"index值:\", index); // 打印找到的索引值\n\n  if (index !== -1) {\n    try {\n      const response = await axios.delete(\"http://localhost:5000/api/cart\", {\n        data: {\n          userId: localStorage.getItem(\"userId\"),\n          productId: productId, // 传递 productId 作为删除商品的依据\n        },\n      });\n\n      if (response.data.success) {\n        cartItems.value.splice(index, 1); // 从购物车中删除商品\n        console.log(\"商品删除成功\");\n      } else {\n        console.error(\"商品删除失败:\", response.data.message);\n      }\n    } catch (error) {\n      console.error(\"删除商品失败:\", error);\n    }\n  } else {\n    console.error(\"未找到商品，无法删除\");\n  }\n};\nconst checkout = () => {\n  console.log(\"去结算\", cartItems.value);\n  // TODO: 添加结算逻辑\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  background: #f9f9f9; /* 背景颜色 */\n  border-radius: 10px; /* 圆角 */\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  padding: 10px 20px;\n  background: #ffffff; /* 总计背景 */\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.product-name {\n  font-weight: bold;\n  color: #333; /* 商品名称颜色 */\n}\n\n.product-price {\n  color: #e94e77; /* 价格颜色 */\n  font-weight: bold; /* 加粗 */\n}\n\n.total-price {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n\n.checkout-button {\n  padding: 10px 20px; /* 按钮内边距 */\n  font-size: 16px; /* 按钮字体大小 */\n}\n\n.empty-cart {\n  text-align: center;\n  color: #999; /* 空购物车提示颜色 */\n  font-style: italic; /* 斜体 */\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAW;mBADxB;;EAegBA,KAAK,EAAC;AAAc;;EAKpBA,KAAK,EAAC;AAAe;;EAwB5BA,KAAK,EAAC;AAAY;;EAETA,KAAK,EAAC;AAAa;;EA9CrCC,GAAA;EAqDgCD,KAAK,EAAC;;;;;;;uBApDpCE,mBAAA,CAqDM,OArDNC,UAqDM,G,0BApDJC,mBAAA,CAAY,YAAR,KAAG,sBACPC,YAAA,CAuCWC,mBAAA;IAvCAC,IAAI,EAAEC,MAAA,CAAAC,SAAS;IAAEC,MAAM,EAAN;;IAHhCC,OAAA,EAAAC,QAAA,CAIM,MAQkB,CARlBP,YAAA,CAQkBQ,0BAAA;MARDC,IAAI,EAAC,OAAO;MAACC,KAAK,EAAC,MAAM;MAACC,KAAK,EAAC;;MACpCL,OAAO,EAAAC,QAAA,CAKdK,KALqB,KACvBb,mBAAA,CAIE;QAHCc,GAAG,EAAED,KAAK,CAACE,GAAG,CAACC,WAAW,CAACC,QAAQ;QACpCC,GAAG,EAAC,MAAM;QACVtB,KAAK,EAAC;8BATlBuB,UAAA,E;MAAAC,CAAA;QAaMnB,YAAA,CAIkBQ,0BAAA;MAJDC,IAAI,EAAC,MAAM;MAACC,KAAK,EAAC;;MACtBJ,OAAO,EAAAC,QAAA,CACkDK,KAD3C,KACvBb,mBAAA,CAAkE,QAAlEqB,UAAkE,EAAAC,gBAAA,CAApCT,KAAK,CAACE,GAAG,CAACC,WAAW,CAACO,IAAI,iB;MAflEH,CAAA;QAkBMnB,YAAA,CAMkBQ,0BAAA;MANDC,IAAI,EAAC,OAAO;MAACC,KAAK,EAAC,IAAI;MAACC,KAAK,EAAC;;MAClCL,OAAO,EAAAC,QAAA,CAGfK,KAHsB,KACvBb,mBAAA,CAEC,QAFDwB,UAEC,EADE,GAAC,GAAAF,gBAAA,CAAGG,UAAU,CAACZ,KAAK,CAACE,GAAG,CAACC,WAAW,CAACU,KAAK,EAAEC,OAAO,oB;MArBhEP,CAAA;QAyBMnB,YAAA,CASkBQ,0BAAA;MATDC,IAAI,EAAC,UAAU;MAACC,KAAK,EAAC,IAAI;MAACC,KAAK,EAAC;;MACrCL,OAAO,EAAAC,QAAA,CAMdK,KANqB,KACvBZ,YAAA,CAKE2B,0BAAA;QAhCZC,UAAA,EA4BqBhB,KAAK,CAACE,GAAG,CAACe,QAAQ;QA5BvC,uBAAAC,MAAA,IA4BqBlB,KAAK,CAACE,GAAG,CAACe,QAAQ,GAAAC,MAAA;QAC1BC,QAAM,EAAAD,MAAA,IAAE3B,MAAA,CAAA6B,cAAc,CAACpB,KAAK,CAACE,GAAG;QAChCmB,GAAG,EAAE,CAAC;QA