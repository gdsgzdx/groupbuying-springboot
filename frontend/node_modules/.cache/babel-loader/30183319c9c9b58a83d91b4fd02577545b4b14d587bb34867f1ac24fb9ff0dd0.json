{"ast":null,"code":"import { ref, computed } from \"vue\";\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const userName = ref(\"用户\"); // 用户昵称\n    const searchQuery = ref(\"\"); // 搜索查询\n\n    const ads = ref([{\n      image: require(\"@/assets/ad1.png\") // 替换为实际广告图片路径\n    }, {\n      image: require(\"@/assets/ad2.png\") // 替换为实际广告图片路径\n    }, {\n      image: require(\"@/assets/ad3.png\") // 替换为实际广告图片路径\n    }]);\n    const products = ref([{\n      id: 1,\n      title: \"苹果 iPhone 16 Pro\",\n      price: 8999.0,\n      image: require(\"@/assets/苹果手机.png\")\n    }, {\n      id: 2,\n      title: \"哈密瓜\",\n      price: 5299.0,\n      image: require(\"@/assets/哈密瓜.png\")\n    }, {\n      id: 3,\n      title: \"华为 Mate 40 Pro\",\n      price: 7999.0,\n      image: require(\"@/assets/笔记本电脑.png\")\n    }]);\n\n    // 状态管理\n    const selectedCategory = ref(\"\");\n    const selectedSort = ref(\"\");\n    const currentPage = ref(1);\n    const pageSize = ref(8);\n\n    // 计算属性\n    const filteredProducts = computed(() => {\n      let filtered = products.value;\n\n      // 搜索过滤\n      if (searchQuery.value) {\n        filtered = filtered.filter(product => product.title.includes(searchQuery.value));\n      }\n\n      // 分类过滤\n      if (selectedCategory.value) {\n        filtered = filtered.filter(product => product.category === selectedCategory.value);\n      }\n\n      // 排序\n      if (selectedSort.value === \"low-to-high\") {\n        filtered.sort((a, b) => a.price - b.price);\n      } else if (selectedSort.value === \"high-to-low\") {\n        filtered.sort((a, b) => b.price - a.price);\n      }\n\n      // 分页\n      const start = (currentPage.value - 1) * pageSize.value;\n      return filtered.slice(start, start + pageSize.value);\n    });\n\n    // 应用过滤\n    const applyFilters = () => {\n      currentPage.value = 1; // 重置为第一页\n    };\n\n    // 处理分页\n    const handlePageChange = page => {\n      currentPage.value = page;\n    };\n    const addToCart = product => {\n      console.log(\"加入购物车:\", product);\n    };\n\n    // 选择分类\n    const selectCategory = category => {\n      selectedCategory.value = category; // 设置选中的分类\n    };\n    const __returned__ = {\n      userName,\n      searchQuery,\n      ads,\n      products,\n      selectedCategory,\n      selectedSort,\n      currentPage,\n      pageSize,\n      filteredProducts,\n      applyFilters,\n      handlePageChange,\n      addToCart,\n      selectCategory,\n      ref,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","userName","searchQuery","ads","image","require","products","id","title","price","selectedCategory","selectedSort","currentPage","pageSize","filteredProducts","filtered","value","filter","product","includes","category","sort","a","b","start","slice","applyFilters","handlePageChange","page","addToCart","console","log","selectCategory"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <!-- Logo -->\n        <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <!-- 用户功能 -->\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userName }}</span>\n          <span class=\"user-action\">购物车</span>\n          <span class=\"user-action\">我的订单</span>\n          <span class=\"user-action\">店铺关注</span>\n          <span class=\"user-action\">浏览记录</span>\n          <!-- 搜索输入框 -->\n          <input\n            type=\"text\"\n            placeholder=\"搜索商品\"\n            class=\"search-input\"\n            v-model=\"searchQuery\"\n          />\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <!-- 商品分类 -->\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"1\" class=\"category-menu\">\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\"\n            >家用电器</El-menu-item\n          >\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机/通讯/数码')\"\n            >手机/通讯/数码</El-menu-item\n          >\n          <El-menu-item index=\"3\" @click=\"selectCategory('电脑/办公/文具用品')\"\n            >电脑/办公/文具用品</El-menu-item\n          >\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具/家居/厨房')\"\n            >家具/家居/厨房</El-menu-item\n          >\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装/女装/童装/内衣')\"\n            >男装/女装/童装/内衣</El-menu-item\n          >\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆/个护清洁')\"\n            >美妆/个护清洁</El-menu-item\n          >\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋/箱包/珠宝')\"\n            >女鞋/箱包/珠宝</El-menu-item\n          >\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋/运动/户外')\"\n            >男鞋/运动/户外</El-menu-item\n          >\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品/酒类/生鲜')\"\n            >食品/酒类/生鲜</El-menu-item\n          >\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术/礼品花/园艺')\"\n            >艺术/礼品花/园艺</El-menu-item\n          >\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书/文娱/教育')\"\n            >图书/文娱/教育</El-menu-item\n          >\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票/酒店/旅游')\"\n            >机票/酒店/旅游</El-menu-item\n          >\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付/保险/金融')\"\n            >支付/保险/金融</El-menu-item\n          >\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具/乐器')\"\n            >玩具/乐器</El-menu-item\n          >\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <!-- 广告栏 -->\n        <section class=\"ad-banner\">\n          <div class=\"ad-container\">\n            <div class=\"ad-item\" v-for=\"(ad, index) in ads\" :key=\"index\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </div>\n          </div>\n        </section>\n\n        <section class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n          </El-select>\n          <El-button type=\"primary\" @click=\"applyFilters\">应用</El-button>\n        </section>\n\n        <!-- 商品展示 -->\n        <section class=\"products\">\n          <h2 class=\"section-title\">热卖商品</h2>\n          <El-row :gutter=\"20\">\n            <El-col\n              v-for=\"(product, index) in filteredProducts\"\n              :key=\"product.id\"\n              :span=\"6\"\n            >\n              <El-card :body-style=\"{ padding: '10px' }\" class=\"product-card\">\n                <img :src=\"product.image\" class=\"product-image\" />\n                <div class=\"product-info\">\n                  <h3>{{ product.title }}</h3>\n                  <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                  <El-button type=\"primary\" @click=\"addToCart(product)\"\n                    >加入购物车</El-button\n                  >\n                </div>\n              </El-card>\n            </El-col>\n          </El-row>\n          <!-- 分页 -->\n          <El-pagination\n            @current-change=\"handlePageChange\"\n            :current-page=\"currentPage\"\n            :page-size=\"pageSize\"\n            :total=\"filteredProducts.length\"\n          />\n        </section>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\n\nconst userName = ref(\"用户\"); // 用户昵称\nconst searchQuery = ref(\"\"); // 搜索查询\n\nconst ads = ref([\n  {\n    image: require(\"@/assets/ad1.png\"), // 替换为实际广告图片路径\n  },\n  {\n    image: require(\"@/assets/ad2.png\"), // 替换为实际广告图片路径\n  },\n  {\n    image: require(\"@/assets/ad3.png\"), // 替换为实际广告图片路径\n  },\n]);\n\nconst products = ref([\n  {\n    id: 1,\n    title: \"苹果 iPhone 16 Pro\",\n    price: 8999.0,\n    image: require(\"@/assets/苹果手机.png\"),\n  },\n  {\n    id: 2,\n    title: \"哈密瓜\",\n    price: 5299.0,\n    image: require(\"@/assets/哈密瓜.png\"),\n  },\n  {\n    id: 3,\n    title: \"华为 Mate 40 Pro\",\n    price: 7999.0,\n    image: require(\"@/assets/笔记本电脑.png\"),\n  },\n]);\n\n// 状态管理\nconst selectedCategory = ref(\"\");\nconst selectedSort = ref(\"\");\nconst currentPage = ref(1);\nconst pageSize = ref(8);\n\n// 计算属性\nconst filteredProducts = computed(() => {\n  let filtered = products.value;\n\n  // 搜索过滤\n  if (searchQuery.value) {\n    filtered = filtered.filter((product) =>\n      product.title.includes(searchQuery.value),\n    );\n  }\n\n  // 分类过滤\n  if (selectedCategory.value) {\n    filtered = filtered.filter(\n      (product) => product.category === selectedCategory.value,\n    );\n  }\n\n  // 排序\n  if (selectedSort.value === \"low-to-high\") {\n    filtered.sort((a, b) => a.price - b.price);\n  } else if (selectedSort.value === \"high-to-low\") {\n    filtered.sort((a, b) => b.price - a.price);\n  }\n\n  // 分页\n  const start = (currentPage.value - 1) * pageSize.value;\n  return filtered.slice(start, start + pageSize.value);\n});\n\n// 应用过滤\nconst applyFilters = () => {\n  currentPage.value = 1; // 重置为第一页\n};\n\n// 处理分页\nconst handlePageChange = (page) => {\n  currentPage.value = page;\n};\n\nconst addToCart = (product) => {\n  console.log(\"加入购物车:\", product);\n};\n\n// 选择分类\nconst selectCategory = (category) => {\n  selectedCategory.value = category; // 设置选中的分类\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n\n        .search-input {\n          padding: 8px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 200px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4;\n  }\n\n  .category-menu {\n    padding: 10px;\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .ad-banner {\n      margin-bottom: 20px;\n      .ad-container {\n        display: flex; // 在一行中显示\n        justify-content: space-between; // 分隔均匀\n      }\n\n      .ad-item {\n        flex: 1; // 每个小广告栏占 equal space 直到区间\n        margin: 0 10px; // 为了给小广告栏之间的小间距\n        height: 200px; // 确保小广告栏高度一致\n        overflow: hidden; // 避免溢出\n      }\n\n      .ad-image {\n        width: 100%;\n        height: 100%;\n        object-fit: cover; // 保持图像比例\n      }\n    }\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px;\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n\n      .product-image {\n        width: 100%;\n        height: auto;\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 5px;\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AAgIA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IAEnC,MAAMC,QAAQ,GAAGF,GAAG,CAAC,IAAI,CAAC,CAAC,CAAC;IAC5B,MAAMG,WAAW,GAAGH,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE7B,MAAMI,GAAG,GAAGJ,GAAG,CAAC,CACd;MACEK,KAAK,EAAEC,OAAO,CAAC,kBAAkB,CAAC,CAAE;IACtC,CAAC,EACD;MACED,KAAK,EAAEC,OAAO,CAAC,kBAAkB,CAAC,CAAE;IACtC,CAAC,EACD;MACED,KAAK,EAAEC,OAAO,CAAC,kBAAkB,CAAC,CAAE;IACtC,CAAC,CACF,CAAC;IAEF,MAAMC,QAAQ,GAAGP,GAAG,CAAC,CACnB;MACEQ,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,kBAAkB;MACzBC,KAAK,EAAE,MAAM;MACbL,KAAK,EAAEC,OAAO,CAAC,mBAAmB;IACpC,CAAC,EACD;MACEE,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,MAAM;MACbL,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IACnC,CAAC,EACD;MACEE,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,gBAAgB;MACvBC,KAAK,EAAE,MAAM;MACbL,KAAK,EAAEC,OAAO,CAAC,oBAAoB;IACrC,CAAC,CACF,CAAC;;IAEF;IACA,MAAMK,gBAAgB,GAAGX,GAAG,CAAC,EAAE,CAAC;IAChC,MAAMY,YAAY,GAAGZ,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMa,WAAW,GAAGb,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMc,QAAQ,GAAGd,GAAG,CAAC,CAAC,CAAC;;IAEvB;IACA,MAAMe,gBAAgB,GAAGd,QAAQ,CAAC,MAAM;MACtC,IAAIe,QAAQ,GAAGT,QAAQ,CAACU,KAAK;;MAE7B;MACA,IAAId,WAAW,CAACc,KAAK,EAAE;QACrBD,QAAQ,GAAGA,QAAQ,CAACE,MAAM,CAAEC,OAAO,IACjCA,OAAO,CAACV,KAAK,CAACW,QAAQ,CAACjB,WAAW,CAACc,KAAK,CAC1C,CAAC;MACH;;MAEA;MACA,IAAIN,gBAAgB,CAACM,KAAK,EAAE;QAC1BD,QAAQ,GAAGA,QAAQ,CAACE,MAAM,CACvBC,OAAO,IAAKA,OAAO,CAACE,QAAQ,KAAKV,gBAAgB,CAACM,KACrD,CAAC;MACH;;MAEA;MACA,IAAIL,YAAY,CAACK,KAAK,KAAK,aAAa,EAAE;QACxCD,QAAQ,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKD,CAAC,CAACb,KAAK,GAAGc,CAAC,CAACd,KAAK,CAAC;MAC5C,CAAC,MAAM,IAAIE,YAAY,CAACK,KAAK,KAAK,aAAa,EAAE;QAC/CD,QAAQ,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACd,KAAK,GAAGa,CAAC,CAACb,KAAK,CAAC;MAC5C;;MAEA;MACA,MAAMe,KAAK,GAAG,CAACZ,WAAW,CAACI,KAAK,GAAG,CAAC,IAAIH,QAAQ,CAACG,KAAK;MACtD,OAAOD,QAAQ,CAACU,KAAK,CAACD,KAAK,EAAEA,KAAK,GAAGX,QAAQ,CAACG,KAAK,CAAC;IACtD,CAAC,CAAC;;IAEF;IACA,MAAMU,YAAY,GAAGA,CAAA,KAAM;MACzBd,WAAW,CAACI,KAAK,GAAG,CAAC,CAAC,CAAC;IACzB,CAAC;;IAED;IACA,MAAMW,gBAAgB,GAAIC,IAAI,IAAK;MACjChB,WAAW,CAACI,KAAK,GAAGY,IAAI;IAC1B,CAAC;IAED,MAAMC,SAAS,GAAIX,OAAO,IAAK;MAC7BY,OAAO,CAACC,GAAG,CAAC,QAAQ,EAAEb,OAAO,CAAC;IAChC,CAAC;;IAED;IACA,MAAMc,cAAc,GAAIZ,QAAQ,IAAK;MACnCV,gBAAgB,CAACM,KAAK,GAAGI,QAAQ,CAAC,CAAC;IACrC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}