{"ast":null,"code":"import { ref, onMounted } from \"vue\";\nimport { useRoute, useRouter } from \"vue-router\";\nimport { ElButton, ElDialog, ElInput, ElMessage, ElAvatar } from \"element-plus\";\nimport axios from \"axios\";\nconst API_BASE_URL = \"http://localhost:5000\";\nexport default {\n  __name: 'ProductPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const paymentPassword = ref(\"\");\n    const route = useRoute();\n    const router = useRouter();\n    const product = ref({\n      id: null,\n      name: \"\",\n      price: 0,\n      image: \"\",\n      description: \"\",\n      stock: 0\n    });\n    const optionsVisible = ref(false);\n    const isDialogVisible = ref(false);\n    const isPasswordDialogVisible = ref(false);\n    const isGroupBuyDialogVisible = ref(false);\n    const currentGroup = ref(null);\n    const availableGroups = ref([]);\n    const inviteCode = ref(\"\");\n    const groupBuyAction = ref(\"\"); // 'create' or 'join'\n\n    // 获取商品详细信息\n    onMounted(async () => {\n      await fetchProductDetails();\n      await fetchAvailableGroups();\n    });\n    const fetchProductDetails = async () => {\n      const productId = route.params.id;\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/products/${productId}`);\n        if (response.data.code === 200) {\n          product.value = response.data.data;\n          product.value.price = parseFloat(product.value.price) || 0;\n        }\n      } catch (error) {\n        ElMessage.error(\"获取商品详情失败\");\n      }\n    };\n    const fetchAvailableGroups = async () => {\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/group-buys/available?productId=${product.value.id}`);\n        if (response.data.code === 200) {\n          availableGroups.value = response.data.data;\n        }\n      } catch (error) {\n        console.error(\"获取可用拼团失败:\", error);\n      }\n    };\n    const showGroupBuyDialog = () => {\n      isGroupBuyDialogVisible.value = true;\n      optionsVisible.value = false;\n      fetchAvailableGroups();\n    };\n    const createGroup = () => {\n      groupBuyAction.value = \"create\";\n      isPasswordDialogVisible.value = true;\n    };\n    const joinGroup = group => {\n      groupBuyAction.value = \"join\";\n      inviteCode.value = group.inviteCode;\n      isPasswordDialogVisible.value = true;\n    };\n    const joinGroupByCode = () => {\n      if (!inviteCode.value) {\n        ElMessage.error(\"请输入邀请码\");\n        return;\n      }\n      groupBuyAction.value = \"join\";\n      isPasswordDialogVisible.value = true;\n    };\n    const handlePaymentSubmit = async () => {\n      console.log(\"提交支付时的购买方式:\", groupBuyAction.value);\n      if (!paymentPassword.value) {\n        ElMessage.error(\"请输入支付密码\");\n        return;\n      }\n      try {\n        const token = localStorage.getItem(\"token\");\n        if (!token) {\n          ElMessage.error(\"请先登录\");\n          return;\n        }\n        let response;\n        if (groupBuyAction.value === \"create\") {\n          response = await axios.post(`${API_BASE_URL}/api/group-buys/create`, {\n            productId: product.value.id,\n            paymentPassword: paymentPassword.value\n          }, {\n            headers: {\n              Authorization: `Bearer ${token}`\n            }\n          });\n          if (response.data.code === 200) {\n            currentGroup.value = response.data.data;\n            isPasswordDialogVisible.value = false;\n            if (currentGroup.value?.remainingSeconds !== undefined) {\n              startCountdown();\n            }\n            ElMessage.success(\"创建拼团成功！\");\n          }\n        } else if (groupBuyAction.value === \"join\") {\n          response = await axios.post(`${API_BASE_URL}/api/group-buys/join`, {\n            inviteCode: inviteCode.value,\n            paymentPassword: paymentPassword.value\n          }, {\n            headers: {\n              Authorization: `Bearer ${token}`\n            }\n          });\n          if (response.data.code === 200) {\n            currentGroup.value = response.data.data;\n            isPasswordDialogVisible.value = false;\n            if (currentGroup.value?.remainingSeconds !== undefined) {\n              startCountdown();\n            }\n            ElMessage.success(\"加入拼团成功！\");\n          }\n        } else if (groupBuyAction.value === \"purchase\") {\n          // 单独购买的处理逻辑\n          console.log(\"开始处理单独购买...\");\n          response = await axios.post(`${API_BASE_URL}/api/orders`, {\n            productId: product.value.id,\n            quantity: 1,\n            paymentPassword: paymentPassword.value\n          }, {\n            headers: {\n              Authorization: `Bearer ${token}`\n            }\n          });\n          console.log(\"单独购买响应:\", response.data);\n          if (response.data.code === 200) {\n            // 确保先关闭对话框\n            isPasswordDialogVisible.value = false;\n            // 清空支付密码\n            paymentPassword.value = \"\";\n            // 重置购买方式\n            groupBuyAction.value = \"\";\n            // 显示成功消息\n            ElMessage.success(\"购买成功！\");\n            // 最后跳转到订单页面\n            setTimeout(() => {\n              router.push(\"/orders\");\n            }, 500);\n          }\n        } else {\n          ElMessage.error(\"请选择购买方式\");\n          console.error(\"未知的购买方式:\", groupBuyAction.value);\n          return;\n        }\n      } catch (error) {\n        console.error(\"支付失败:\", error);\n        ElMessage.error(error.response?.data?.message || \"支付失败，请稍后重试\");\n      } finally {\n        // 在finally中只清空密码，其他状态在各自的成功处理中清理\n        paymentPassword.value = \"\";\n      }\n    };\n    const copyInviteCode = () => {\n      if (currentGroup.value?.inviteCode) {\n        navigator.clipboard.writeText(currentGroup.value.inviteCode).then(() => ElMessage.success(\"邀请码已复制到剪贴板\")).catch(() => ElMessage.error(\"复制失败，请手动复制\"));\n      }\n    };\n    const formatTime = seconds => {\n      if (seconds == null || isNaN(seconds)) return \"00:00:00\";\n      const hours = Math.floor(seconds / 3600);\n      const minutes = Math.floor(seconds % 3600 / 60);\n      const remainingSeconds = seconds % 60;\n      return `${hours.toString().padStart(2, \"0\")}:${minutes.toString().padStart(2, \"0\")}:${remainingSeconds.toString().padStart(2, \"0\")}`;\n    };\n    const startCountdown = () => {\n      if (!currentGroup.value || currentGroup.value.remainingSeconds === undefined) {\n        return;\n      }\n      const timer = setInterval(() => {\n        if (currentGroup.value && currentGroup.value.remainingSeconds > 0) {\n          currentGroup.value.remainingSeconds--;\n          if (currentGroup.value.remainingSeconds === 0) {\n            clearInterval(timer);\n            ElMessage.warning(\"拼团已结束\");\n            fetchGroupBuyStatus(currentGroup.value.id);\n          }\n        } else {\n          clearInterval(timer);\n        }\n      }, 1000);\n    };\n    const fetchGroupBuyStatus = async groupId => {\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/group-buys/${groupId}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        if (response.data.code === 200) {\n          currentGroup.value = response.data.data;\n        }\n      } catch (error) {\n        console.error(\"获取拼团状态失败:\", error);\n        ElMessage.error(\"获取拼团状态失败\");\n      }\n    };\n    const resetGroupBuyDialog = () => {\n      isGroupBuyDialogVisible.value = false;\n      // 不再重置currentGroup，只在实际拼团结束时重置\n      inviteCode.value = \"\";\n      groupBuyAction.value = \"\";\n    };\n\n    // 加入购物车\n    const addToCart = async () => {\n      const quantity = 1;\n      const token = localStorage.getItem(\"token\");\n      if (!token) {\n        ElMessage.error(\"请先登录\");\n        return;\n      }\n      try {\n        const response = await axios.post(`http://localhost:5000/api/cart?productId=${product.value.id}&quantity=${quantity}`, {}, {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        if (response.data.code === 200) {\n          ElMessage.success(`${product.value.name} 已加入购物车！`);\n        } else {\n          ElMessage.error(\"加入购物车失败: \" + response.data.message);\n        }\n      } catch (error) {\n        console.error(\"加入购物车时发生错误:\", error);\n        ElMessage.error(\"加入购物车失败，请稍后重试。\");\n      }\n    };\n\n    // 显示购买选项\n    const showPurchaseOptions = () => {\n      optionsVisible.value = true; // 显示购买选项\n    };\n\n    // 打开确认购买对话框\n    const askForPurchaseConfirmation = () => {\n      groupBuyAction.value = \"purchase\"; // 设置为单独购买\n      optionsVisible.value = false;\n      isDialogVisible.value = true;\n      console.log(\"设置购买方式为:\", groupBuyAction.value); // 添加调试日志\n    };\n\n    // 重置对话框状态\n    const resetDialog = () => {\n      isDialogVisible.value = false;\n    };\n\n    // 确认购买并打开输入密码对话框\n    const confirmPurchase = () => {\n      isDialogVisible.value = false;\n      isPasswordDialogVisible.value = true;\n      console.log(\"确认购买时的购买方式:\", groupBuyAction.value); // 添加调试日志\n    };\n\n    // 重置密码输入对话框状态\n    const resetPasswordDialog = () => {\n      isPasswordDialogVisible.value = false;\n      paymentPassword.value = \"\"; // 清空密码输入\n    };\n\n    // 在 script setup 部分添加 goHome 方法\n    const goHome = () => {\n      router.push(\"/\");\n    };\n    const getParticipantAvatar = index => {\n      if (!currentGroup.value?.participants) return \"/assets/avatar.png\";\n      const participant = Array.from(currentGroup.value.participants)[index];\n      return participant?.avatar || \"/assets/avatar.png\";\n    };\n    const getParticipantName = index => {\n      if (!currentGroup.value?.participants) return \"用户\";\n      const participant = Array.from(currentGroup.value.participants)[index];\n      return participant?.nickname || \"用户\";\n    };\n    const __returned__ = {\n      API_BASE_URL,\n      paymentPassword,\n      route,\n      router,\n      product,\n      optionsVisible,\n      isDialogVisible,\n      isPasswordDialogVisible,\n      isGroupBuyDialogVisible,\n      currentGroup,\n      availableGroups,\n      inviteCode,\n      groupBuyAction,\n      fetchProductDetails,\n      fetchAvailableGroups,\n      showGroupBuyDialog,\n      createGroup,\n      joinGroup,\n      joinGroupByCode,\n      handlePaymentSubmit,\n      copyInviteCode,\n      formatTime,\n      startCountdown,\n      fetchGroupBuyStatus,\n      resetGroupBuyDialog,\n      addToCart,\n      showPurchaseOptions,\n      askForPurchaseConfirmation,\n      resetDialog,\n      confirmPurchase,\n      resetPasswordDialog,\n      goHome,\n      getParticipantAvatar,\n      getParticipantName,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElDialog() {\n        return ElDialog;\n      },\n      get ElInput() {\n        return ElInput;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElAvatar() {\n        return ElAvatar;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","useRouter","ElButton","ElDialog","ElInput","ElMessage","ElAvatar","axios","API_BASE_URL","paymentPassword","route","router","product","id","name","price","image","description","stock","optionsVisible","isDialogVisible","isPasswordDialogVisible","isGroupBuyDialogVisible","currentGroup","availableGroups","inviteCode","groupBuyAction","fetchProductDetails","fetchAvailableGroups","productId","params","response","get","data","code","value","parseFloat","error","console","showGroupBuyDialog","createGroup","joinGroup","group","joinGroupByCode","handlePaymentSubmit","log","token","localStorage","getItem","post","headers","Authorization","remainingSeconds","undefined","startCountdown","success","quantity","setTimeout","push","message","copyInviteCode","navigator","clipboard","writeText","then","catch","formatTime","seconds","isNaN","hours","Math","floor","minutes","toString","padStart","timer","setInterval","clearInterval","warning","fetchGroupBuyStatus","groupId","resetGroupBuyDialog","addToCart","showPurchaseOptions","askForPurchaseConfirmation","resetDialog","confirmPurchase","resetPasswordDialog","goHome","getParticipantAvatar","index","participants","participant","Array","from","avatar","getParticipantName","nickname"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/product/ProductPage.vue"],"sourcesContent":["<template>\n  <div class=\"product-page\">\n    <div class=\"product-container\">\n      <div class=\"product-header\">\n        <h1>{{ product.name }}</h1>\n        <p class=\"price\">价格: ¥{{ product.price }}</p>\n        <El-button type=\"default\" @click=\"goHome\" class=\"back-home-button\"\n          >返回首页</El-button\n        >\n      </div>\n\n      <div class=\"product-content\">\n        <img :src=\"product.image\" alt=\"商品图片\" class=\"product-image\" />\n\n        <div class=\"product-details\">\n          <p class=\"description\">{{ product.description }}</p>\n          <p class=\"stock\">库存: {{ product.stock }}件</p>\n\n          <div class=\"action-buttons\">\n            <ElButton type=\"primary\" @click=\"addToCart\">\n              <i class=\"el-icon-shopping-cart-full\"></i> 加入购物车\n            </ElButton>\n            <ElButton type=\"danger\" @click=\"showPurchaseOptions\"\n              >立即购买</ElButton\n            >\n          </div>\n\n          <!-- 增加的购买方式选项 -->\n          <div v-if=\"optionsVisible\" class=\"purchase-options\">\n            <p>请选择购买方式：</p>\n            <div class=\"group-buy-tip\">拼团购买享受8折优惠！</div>\n            <ElButton type=\"success\" @click=\"showGroupBuyDialog\"\n              >拼团购买</ElButton\n            >\n            <ElButton type=\"warning\" @click=\"askForPurchaseConfirmation\"\n              >单独购买</ElButton\n            >\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 确认购买对话框 -->\n    <El-dialog\n      title=\"确认购买\"\n      v-model=\"isDialogVisible\"\n      width=\"400px\"\n      @close=\"resetDialog\"\n    >\n      <span>是否确定单独购买此商品？</span>\n      <template #footer>\n        <ElButton @click=\"resetDialog\">否</ElButton>\n        <ElButton type=\"primary\" @click=\"confirmPurchase\">是</ElButton>\n      </template>\n    </El-dialog>\n\n    <!-- 输入支付密码对话框 -->\n    <El-dialog\n      title=\"输入支付密码\"\n      v-model=\"isPasswordDialogVisible\"\n      width=\"400px\"\n      @close=\"resetPasswordDialog\"\n    >\n      <El-input\n        type=\"password\"\n        placeholder=\"请输入支付密码\"\n        v-model=\"paymentPassword\"\n        show-password\n      ></El-input>\n      <template #footer>\n        <ElButton @click=\"resetPasswordDialog\">取消</ElButton>\n        <ElButton type=\"primary\" @click=\"handlePaymentSubmit\"\n          >确认支付</ElButton\n        >\n      </template>\n    </El-dialog>\n\n    <!-- 拼团对话框 -->\n    <El-dialog\n      title=\"拼团详情\"\n      v-model=\"isGroupBuyDialogVisible\"\n      width=\"500px\"\n      @close=\"resetGroupBuyDialog\"\n    >\n      <div class=\"group-buy-container\">\n        <div class=\"group-price\">\n          <span class=\"label\">拼团价：</span>\n          <span class=\"price\">¥{{ (product.price * 0.8).toFixed(2) }}</span>\n          <span class=\"original-price\">原价：¥{{ product.price }}</span>\n        </div>\n\n        <div class=\"member-avatars\">\n          <template v-if=\"currentGroup\">\n            <div\n              v-for=\"i in currentGroup.requiredSize\"\n              :key=\"i\"\n              class=\"avatar-slot\"\n            >\n              <template v-if=\"i <= currentGroup.currentSize\">\n                <el-avatar :src=\"getParticipantAvatar(i - 1)\" />\n                <span class=\"member-name\">{{ getParticipantName(i - 1) }}</span>\n              </template>\n              <template v-else>\n                <el-avatar src=\"/assets/avatar-placeholder.png\" />\n                <span class=\"member-name\">等待加入</span>\n              </template>\n            </div>\n          </template>\n          <template v-else>\n            <div v-for=\"i in 5\" :key=\"i\" class=\"avatar-slot\">\n              <el-avatar src=\"/assets/avatar-placeholder.png\" />\n              <span class=\"member-name\">等待加入</span>\n            </div>\n          </template>\n        </div>\n\n        <div\n          class=\"countdown\"\n          v-if=\"currentGroup && currentGroup.remainingSeconds !== undefined\"\n        >\n          <span class=\"label\">剩余时间：</span>\n          <span class=\"time\">{{\n            formatTime(currentGroup?.remainingSeconds)\n          }}</span>\n        </div>\n\n        <template v-if=\"!currentGroup\">\n          <div class=\"available-groups\" v-if=\"availableGroups.length > 0\">\n            <h3>可加入的拼团：</h3>\n            <div\n              v-for=\"group in availableGroups\"\n              :key=\"group.id\"\n              class=\"group-item\"\n            >\n              <div class=\"group-info\">\n                <el-avatar :src=\"group.leaderAvatar || '/assets/avatar.png'\" />\n                <span class=\"leader-name\">{{ group.leaderName }}的团</span>\n                <span class=\"member-count\"\n                  >{{ group.currentMembers }}/{{\n                    group.requiredMembers\n                  }}人</span\n                >\n              </div>\n              <ElButton type=\"primary\" size=\"small\" @click=\"joinGroup(group)\"\n                >加入拼团</ElButton\n              >\n            </div>\n          </div>\n\n          <div class=\"create-group\">\n            <ElButton type=\"success\" @click=\"createGroup\">创建拼团</ElButton>\n          </div>\n        </template>\n\n        <template v-else>\n          <div class=\"invite-code\">\n            <span class=\"label\">邀请码：</span>\n            <span class=\"code\">{{ currentGroup.inviteCode }}</span>\n            <ElButton type=\"primary\" size=\"small\" @click=\"copyInviteCode\"\n              >复制</ElButton\n            >\n          </div>\n        </template>\n\n        <div class=\"join-group\" v-if=\"!currentGroup\">\n          <div class=\"invite-input\">\n            <El-input\n              type=\"text\"\n              placeholder=\"请输入邀请码\"\n              v-model=\"inviteCode\"\n            ></El-input>\n          </div>\n          <ElButton type=\"primary\" @click=\"joinGroupByCode\">加入拼团</ElButton>\n        </div>\n      </div>\n    </El-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from \"vue\";\nimport { useRoute, useRouter } from \"vue-router\";\nimport { ElButton, ElDialog, ElInput, ElMessage, ElAvatar } from \"element-plus\";\nimport axios from \"axios\";\n\nconst API_BASE_URL = \"http://localhost:5000\";\nconst paymentPassword = ref(\"\");\nconst route = useRoute();\nconst router = useRouter();\n\nconst product = ref({\n  id: null,\n  name: \"\",\n  price: 0,\n  image: \"\",\n  description: \"\",\n  stock: 0,\n});\n\nconst optionsVisible = ref(false);\nconst isDialogVisible = ref(false);\nconst isPasswordDialogVisible = ref(false);\nconst isGroupBuyDialogVisible = ref(false);\nconst currentGroup = ref(null);\nconst availableGroups = ref([]);\nconst inviteCode = ref(\"\");\nconst groupBuyAction = ref(\"\"); // 'create' or 'join'\n\n// 获取商品详细信息\nonMounted(async () => {\n  await fetchProductDetails();\n  await fetchAvailableGroups();\n});\n\nconst fetchProductDetails = async () => {\n  const productId = route.params.id;\n  try {\n    const response = await axios.get(\n      `${API_BASE_URL}/api/products/${productId}`,\n    );\n    if (response.data.code === 200) {\n      product.value = response.data.data;\n      product.value.price = parseFloat(product.value.price) || 0;\n    }\n  } catch (error) {\n    ElMessage.error(\"获取商品详情失败\");\n  }\n};\n\nconst fetchAvailableGroups = async () => {\n  try {\n    const response = await axios.get(\n      `${API_BASE_URL}/api/group-buys/available?productId=${product.value.id}`,\n    );\n    if (response.data.code === 200) {\n      availableGroups.value = response.data.data;\n    }\n  } catch (error) {\n    console.error(\"获取可用拼团失败:\", error);\n  }\n};\n\nconst showGroupBuyDialog = () => {\n  isGroupBuyDialogVisible.value = true;\n  optionsVisible.value = false;\n  fetchAvailableGroups();\n};\n\nconst createGroup = () => {\n  groupBuyAction.value = \"create\";\n  isPasswordDialogVisible.value = true;\n};\n\nconst joinGroup = (group) => {\n  groupBuyAction.value = \"join\";\n  inviteCode.value = group.inviteCode;\n  isPasswordDialogVisible.value = true;\n};\n\nconst joinGroupByCode = () => {\n  if (!inviteCode.value) {\n    ElMessage.error(\"请输入邀请码\");\n    return;\n  }\n  groupBuyAction.value = \"join\";\n  isPasswordDialogVisible.value = true;\n};\n\nconst handlePaymentSubmit = async () => {\n  console.log(\"提交支付时的购买方式:\", groupBuyAction.value);\n  \n  if (!paymentPassword.value) {\n    ElMessage.error(\"请输入支付密码\");\n    return;\n  }\n\n  try {\n    const token = localStorage.getItem(\"token\");\n    if (!token) {\n      ElMessage.error(\"请先登录\");\n      return;\n    }\n\n    let response;\n    if (groupBuyAction.value === \"create\") {\n      response = await axios.post(\n        `${API_BASE_URL}/api/group-buys/create`,\n        {\n          productId: product.value.id,\n          paymentPassword: paymentPassword.value,\n        },\n        {\n          headers: {\n            Authorization: `Bearer ${token}`,\n          },\n        },\n      );\n\n      if (response.data.code === 200) {\n        currentGroup.value = response.data.data;\n        isPasswordDialogVisible.value = false;\n        if (currentGroup.value?.remainingSeconds !== undefined) {\n          startCountdown();\n        }\n        ElMessage.success(\"创建拼团成功！\");\n      }\n    } else if (groupBuyAction.value === \"join\") {\n      response = await axios.post(\n        `${API_BASE_URL}/api/group-buys/join`,\n        {\n          inviteCode: inviteCode.value,\n          paymentPassword: paymentPassword.value,\n        },\n        {\n          headers: {\n            Authorization: `Bearer ${token}`,\n          },\n        },\n      );\n\n      if (response.data.code === 200) {\n        currentGroup.value = response.data.data;\n        isPasswordDialogVisible.value = false;\n        if (currentGroup.value?.remainingSeconds !== undefined) {\n          startCountdown();\n        }\n        ElMessage.success(\"加入拼团成功！\");\n      }\n    } else if (groupBuyAction.value === \"purchase\") {\n      // 单独购买的处理逻辑\n      console.log(\"开始处理单独购买...\");\n      response = await axios.post(\n        `${API_BASE_URL}/api/orders`,\n        {\n          productId: product.value.id,\n          quantity: 1,\n          paymentPassword: paymentPassword.value,\n        },\n        {\n          headers: {\n            Authorization: `Bearer ${token}`,\n          },\n        },\n      );\n\n      console.log(\"单独购买响应:\", response.data);\n      if (response.data.code === 200) {\n        // 确保先关闭对话框\n        isPasswordDialogVisible.value = false;\n        // 清空支付密码\n        paymentPassword.value = \"\";\n        // 重置购买方式\n        groupBuyAction.value = \"\";\n        // 显示成功消息\n        ElMessage.success(\"购买成功！\");\n        // 最后跳转到订单页面\n        setTimeout(() => {\n          router.push(\"/orders\");\n        }, 500);\n      }\n    } else {\n      ElMessage.error(\"请选择购买方式\");\n      console.error(\"未知的购买方式:\", groupBuyAction.value);\n      return;\n    }\n  } catch (error) {\n    console.error(\"支付失败:\", error);\n    ElMessage.error(error.response?.data?.message || \"支付失败，请