{"ast":null,"code":"import { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport logo from \"@/assets/logo.png\";\n\n// 响应式数据\n\nexport default {\n  __name: 'LoginPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loginFormRef = ref(null);\n    const router = useRouter();\n\n    // 登录表单数据\n    const loginForm = reactive({\n      username: \"\",\n      password: \"\"\n    });\n\n    // 表单验证规则\n    const loginRules = {\n      username: [{\n        required: true,\n        message: \"请输入用户名\",\n        trigger: \"blur\"\n      }],\n      password: [{\n        required: true,\n        message: \"请输入密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        message: \"密码不能少于6位\",\n        trigger: \"blur\"\n      }]\n    };\n\n    // 登录处理\n    const handleLogin = () => {\n      loginFormRef.value.validate(valid => {\n        if (valid) {\n          try {\n            if (loginForm.username === \"admin\" && loginForm.password === \"123456\") {\n              ElMessage.success(\"登录成功\");\n\n              // 使用name跳转，确保与路由配置一致\n              router.push({\n                name: \"Home\"\n              }).catch(err => {\n                console.error(\"Navigation error:\", err);\n                ElMessage.error(\"页面跳转失败\");\n              });\n            } else {\n              ElMessage.error(\"用户名或密码错误\");\n            }\n          } catch (error) {\n            ElMessage.error(\"登录失败\");\n          }\n        } else {\n          ElMessage.error(\"请检查输入\");\n          return false;\n        }\n      });\n    };\n\n    // 注册处理\n    const handleRegister = () => {\n      // 直接跳转到注册页面\n      router.push({\n        name: \"Register\"\n      });\n    };\n\n    // 找回密码处理\n    const handleForgotPassword = () => {\n      // 这里会省略提示输入手机号的部分，只留跳转逻辑\n      router.push({\n        name: \"ForgetPassword\"\n      }); // 跳转到找回密码界面\n    };\n    const __returned__ = {\n      loginFormRef,\n      router,\n      loginForm,\n      loginRules,\n      handleLogin,\n      handleRegister,\n      handleForgotPassword,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get logo() {\n        return logo;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","logo","loginFormRef","router","loginForm","username","password","loginRules","required","message","trigger","min","handleLogin","value","validate","valid","ElMessage","success","push","name","catch","err","console","error","handleRegister","handleForgotPassword"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/LoginPage.vue"],"sourcesContent":["<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">团团赚拼购</h1>\n      </div>\n\n      <El-form\n        ref=\"loginFormRef\"\n        :model=\"loginForm\"\n        :rules=\"loginRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"username\">\n          <El-input\n            v-model=\"loginForm.username\"\n            prefix-icon=\"User\"\n            placeholder=\"用户名\"\n            clearable\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"password\">\n          <El-input\n            v-model=\"loginForm.password\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button type=\"primary\" class=\"login-btn\" @click=\"handleLogin\">\n            登录\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"handleRegister\"> 立即注册 </El-link>\n          <El-link type=\"info\" @click=\"handleForgotPassword\">\n            忘记密码\n          </El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport logo from \"@/assets/logo.png\";\n\n// 响应式数据\nconst loginFormRef = ref(null);\nconst router = useRouter();\n\n// 登录表单数据\nconst loginForm = reactive({\n  username: \"\",\n  password: \"\",\n});\n\n// 表单验证规则\nconst loginRules = {\n  username: [\n    {\n      required: true,\n      message: \"请输入用户名\",\n      trigger: \"blur\",\n    },\n  ],\n  password: [\n    {\n      required: true,\n      message: \"请输入密码\",\n      trigger: \"blur\",\n    },\n    {\n      min: 6,\n      message: \"密码不能少于6位\",\n      trigger: \"blur\",\n    },\n  ],\n};\n\n// 登录处理\nconst handleLogin = () => {\n  loginFormRef.value.validate((valid) => {\n    if (valid) {\n      try {\n        if (loginForm.username === \"admin\" && loginForm.password === \"123456\") {\n          ElMessage.success(\"登录成功\");\n\n          // 使用name跳转，确保与路由配置一致\n          router.push({ name: \"Home\" }).catch((err) => {\n            console.error(\"Navigation error:\", err);\n            ElMessage.error(\"页面跳转失败\");\n          });\n        } else {\n          ElMessage.error(\"用户名或密码错误\");\n        }\n      } catch (error) {\n        ElMessage.error(\"登录失败\");\n      }\n    } else {\n      ElMessage.error(\"请检查输入\");\n      return false;\n    }\n  });\n};\n\n// 注册处理\nconst handleRegister = () => {\n  // 直接跳转到注册页面\n  router.push({\n    name: \"Register\",\n  });\n};\n\n// 找回密码处理\nconst handleForgotPassword = () => {\n  // 这里会省略提示输入手机号的部分，只留跳转逻辑\n  router.push({ name: \"ForgetPassword\" }); // 跳转到找回密码界面\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(to right, #3494e6, #ec6ead);\n}\n\n.login-wrapper {\n  width: 400px;\n  padding: 30px;\n  background: white;\n  border-radius: 10px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  text-align: center;\n}\n\n.logo-title-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.logo {\n  width: 140px;\n  height: 80px;\n  margin-bottom: 10px;\n}\n\n.system-title {\n  font-size: 24px;\n  color: #333;\n  font-weight: bold;\n}\n\n.login-form {\n  width: 100%;\n}\n\n.login-btn {\n  width: 100%;\n  margin-top: 10px;\n}\n\n.login-extra {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 10px;\n}\n</style>\n"],"mappings":"AAmDA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,OAAOC,IAAI,MAAM,mBAAmB;;AAEpC;;;;;;;;IACA,MAAMC,YAAY,GAAGH,GAAG,CAAC,IAAI,CAAC;IAC9B,MAAMI,MAAM,GAAGH,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMI,SAAS,GAAGN,QAAQ,CAAC;MACzBO,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,UAAU,GAAG;MACjBF,QAAQ,EAAE,CACR;QACEG,QAAQ,EAAE,IAAI;QACdC,OAAO,EAAE,QAAQ;QACjBC,OAAO,EAAE;MACX,CAAC,CACF;MACDJ,QAAQ,EAAE,CACR;QACEE,QAAQ,EAAE,IAAI;QACdC,OAAO,EAAE,OAAO;QAChBC,OAAO,EAAE;MACX,CAAC,EACD;QACEC,GAAG,EAAE,CAAC;QACNF,OAAO,EAAE,UAAU;QACnBC,OAAO,EAAE;MACX,CAAC;IAEL,CAAC;;IAED;IACA,MAAME,WAAW,GAAGA,CAAA,KAAM;MACxBV,YAAY,CAACW,KAAK,CAACC,QAAQ,CAAEC,KAAK,IAAK;QACrC,IAAIA,KAAK,EAAE;UACT,IAAI;YACF,IAAIX,SAAS,CAACC,QAAQ,KAAK,OAAO,IAAID,SAAS,CAACE,QAAQ,KAAK,QAAQ,EAAE;cACrEU,SAAS,CAACC,OAAO,CAAC,MAAM,CAAC;;cAEzB;cACAd,MAAM,CAACe,IAAI,CAAC;gBAAEC,IAAI,EAAE;cAAO,CAAC,CAAC,CAACC,KAAK,CAAEC,GAAG,IAAK;gBAC3CC,OAAO,CAACC,KAAK,CAAC,mBAAmB,EAAEF,GAAG,CAAC;gBACvCL,SAAS,CAACO,KAAK,CAAC,QAAQ,CAAC;cAC3B,CAAC,CAAC;YACJ,CAAC,MAAM;cACLP,SAAS,CAACO,KAAK,CAAC,UAAU,CAAC;YAC7B;UACF,CAAC,CAAC,OAAOA,KAAK,EAAE;YACdP,SAAS,CAACO,KAAK,CAAC,MAAM,CAAC;UACzB;QACF,CAAC,MAAM;UACLP,SAAS,CAACO,KAAK,CAAC,OAAO,CAAC;UACxB,OAAO,KAAK;QACd;MACF,CAAC,CAAC;IACJ,CAAC;;IAED;IACA,MAAMC,cAAc,GAAGA,CAAA,KAAM;MAC3B;MACArB,MAAM,CAACe,IAAI,CAAC;QACVC,IAAI,EAAE;MACR,CAAC,CAAC;IACJ,CAAC;;IAED;IACA,