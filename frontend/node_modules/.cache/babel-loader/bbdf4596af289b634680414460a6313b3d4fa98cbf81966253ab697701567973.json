e }}</h1>\n        <p class=\"price\">价格: ¥{{ product.price }}</p>\n      </div>\n\n      <div class=\"product-content\">\n        <img :src=\"product.imageUrl\" alt=\"商品图片\" class=\"product-image\" />\n\n        <div class=\"product-details\">\n          <p class=\"description\">{{ product.description }}</p>\n          <p class=\"stock\">库存: {{ product.stock }}件</p>\n\n          <div class=\"action-buttons\">\n            <ElButton type=\"primary\" @click=\"addToCart\">加入购物车</ElButton>\n            <ElButton type=\"danger\" @click=\"showPurchaseOptions\">立即购买</ElButton>\n          </div>\n\n          <!-- 新增的购买方式选项 -->\n          <div v-if=\"optionsVisible\" class=\"purchase-options\">\n            <p>请选择购买方式：</p>\n            <ElButton type=\"success\" @click=\"purchaseAsGroup\">拼团购买</ElButton>\n            <ElButton type=\"warning\" @click=\"purchaseSeparately\">单独购买</ElButton>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ElButton } from \"element-plus\";\n\nconst route = useRoute();\n\nconst product = ref({\n  name: \"\",\n  price: 0,\n  imageUrl: \"\",\n  description: \"\",\n  stock: 0,\n});\nconst optionsVisible = ref(false); // 控制购买选项的显示状态\nconst canvasRef = ref(null); // Canvas 引用\n\n// 获取商品详细信息\nonMounted(async () => {\n  const productId = route.params.id;\n  console.log(`请求商品 ID: ${productId}`);\n\n  const response = await fetch(`http://localhost:5000/api/products/${productId}`);\n\n  if (response.ok) {\n    const productData = await response.json();\n    product.value = productData.data;\n    product.value.price = parseFloat(product.value.price) || 0;\n\n    // 绘制动态背景\n    drawBackground(canvasRef.value);\n  } else {\n    console.error(\"获取商品详情失败，状态码:\", response.status);\n  }\n});\n\n// 加入购物车\nconst addToCart = async () => {\n  const quantity = 1;\n\n  try {\n    const response = await fetch(\"http://localhost:5000/api/cart\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n      },\n      body: JSON.stringify({\n        userId: localStorage.getItem(\"userId\"),\n        productId: product.value.id,\n        quantity: quantity,\n      }),\n    });\n\n    if (response.ok) {\n      alert(`${product.value.name} 已加入购物车！`);\n    } else {\n      console.error(\"加入购物车失败，状态码:\", response.status);\n      const errorData = await response.json();\n      alert(\"加入购物车失败: \" + errorData.message);\n    }\n  } catch (error) {\n    console.error(\"加入购物车时发生错误:\", error);\n    alert(\"加入购物车失败，请稍后重试。\");\n  }\n};\n\n// 显示购买选项\nconst showPurchaseOptions = () => {\n  optionsVisible.value = true; // 显示购买选项\n};\n\n// 拼团购买\nconst purchaseAsGroup = () => {\n  alert(\"选择拼团购买功能！\");\n};\n\n// 单独购买\nconst purchaseSeparately = () => {\n  alert(\"选择单独购买功能！\");\n};\n\n// 动态背景\nconst drawBackground = (canvas) => {\n  if (!canvas) return;\n  const ctx = canvas.getContext(\"2d\");\n  const w = canvas.width = window.innerWidth;\n  const h = canvas.height = window.innerHeight;\n\n  const particles = [];\n  const numberOfParticles = 100;\n\n  // 生成随机粒子\n  for (let i = 0; i < numberOfParticles; i++) {\n    particles.push({\n      x: Math.random() * w,\n      y: Math.random() * h,\n      radius: Math.random() * 5 + 5,\n      color: `hsl(${Math.random() * 360}, 100%, 50%)`,\n      speedX: Math.random() * 2 - 1,\n      speedY: Math.random() * 2 - 1,\n    });\n  }\n\n  const animate = () => {\n    ctx.clearRect(0, 0, w, h);\n    particles.forEach(p => {\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2, false);\n      ctx.fillStyle = p.color;\n      ctx.fill();\n      p.x += p.speedX;\n      p.y += p.speedY;\n\n      // 碰撞检测\n      if (p.x + p.radius > w || p.x - p.radius < 0) p.speedX *= -1;\n      if (p.y + p.radius > h || p.y - p.radius < 0) p.speedY *= -1;\n    });\n    requestAnimationFrame(animate);\n  };\n  animate();\n};\n\n// 组件卸载时清理\nonBeforeUnmount(() => {\n  const canvas = canvasRef.value;\n  if (canvas) {\n    const ctx = canvas.getContext('2d');\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n  }\n});\n</script>\n\n<style scoped>\n.product-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  text-align: left;\n  position: relative; /* 使 Canvas 可以相对定位 */\n}\n\n.background-canvas {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 0; /* 设为底层 */\n}\n\n.product-container {\n  display: flex;\n  flex-direction: column;\n  z-index: 1; /* 设为上层 */\n}\n\n.product-header {\n  margin-bottom: 20px;\n}\n\n.price {\n  font-size: 24px;\n  color: #f65a8b;\n}\n\n.product-content {\n  display: flex;\n  align-items: flex-start;\n}\n\n.product-image {\n  max-width: 400px;\n  height: auto;\n  border-radius: 8px;\n  margin-right: 20px;\n}\n\n.product-details {\n  flex-grow: 1;\n}\n\n.description {\n  font-size: 20px;\n  line-height: 1.5;\n  margin-bottom: 10px;\n}\n\n.stock {\n  font-size: 16px;\n  margin-bottom: 20px;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 10px;\n}\n\n.purchase-options {\n  margin-top: 20px;\n  display: flex;\n  flex-direction: column; /* 垂直排列按钮 */\n  gap: 10px; /* 按钮间距 */\n}\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAc;;EACfC,GAAG,EAAC,QAAQ;EAACD,KAAK,EAAC;;;EACtBA,KAAK,EAAC;AAAmB;;EACvBA,KAAK,EAAC;AAAgB;;EAEtBA,KAAK,EAAC;AAAO;;EAGbA,KAAK,EAAC;AAAiB;mBATlC;;EAYaA,KAAK,EAAC;AAAiB;;EACvBA,KAAK,EAAC;AAAa;;EACnBA,KAAK,EAAC;AAAO;;EAEXA,KAAK,EAAC;AAAgB;;EAhBrCE,GAAA;EAsBqCF,KAAK,EAAC;;;uBArBzCG,mBAAA,CA6BM,OA7BNC,UA6BM,GA5BJC,mBAAA,CAAwD,UAAxDC,UAAwD,+BACxDD,mBAAA,CA0BM,OA1BNE,UA0BM,GAzBJF,mBAAA,CAGM,OAHNG,UAGM,GAFJH,mBAAA,CAA2B,YAAAI,gBAAA,CAApBC,MAAA,CAAAC,OAAO,CAACC,IAAI,kBACnBP,mBAAA,CAA6C,KAA7CQ,UAA6C,EAA5B,OAAK,GAAAJ,gBAAA,CAAGC,MAAA,CAAAC,OAAO,CAACG,KAAK,iB,GAGxCT,mBAAA,CAmBM,OAnBNU,UAmBM,GAlBJV,mBAAA,CAAgE;IAA1DW,GAAG,EAAEN,MAAA,CAAAC,OAAO,CAACM,QAAQ;IAAEC,GAAG,EAAC,MAAM;IAAClB,KAAK,EAAC;0BAVtDmB,UA