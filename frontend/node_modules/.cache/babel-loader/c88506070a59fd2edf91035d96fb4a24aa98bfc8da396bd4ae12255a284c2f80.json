{"ast":null,"code":"import { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport { ElForm } from \"element-plus\";\nconst logo = \"/assets/logo.png\";\nexport default {\n  __name: 'ForgetpasswordPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const forgetFormRef = ref(null);\n    const router = useRouter();\n    const forgetForm = reactive({\n      phone: \"\",\n      verifyCode: \"\",\n      newPassword: \"\",\n      confirmPassword: \"\"\n    });\n    const countDown = ref(0);\n    const forgetRules = {\n      phone: [{\n        required: true,\n        message: \"请输入手机号\",\n        trigger: \"blur\"\n      }, {\n        pattern: /^1[3-9]\\d{9}$/,\n        message: \"请输入正确的手机号\",\n        trigger: \"blur\"\n      }],\n      verifyCode: [{\n        required: true,\n        message: \"请输入验证码\",\n        trigger: \"blur\"\n      }, {\n        len: 6,\n        message: \"验证码为6位数字\",\n        trigger: \"blur\"\n      }],\n      newPassword: [{\n        required: true,\n        message: \"请设置新密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        max: 16,\n        message: \"密码长度6-16位\",\n        trigger: \"blur\"\n      }],\n      confirmPassword: [{\n        required: true,\n        message: \"请确认新密码\",\n        trigger: \"blur\"\n      }, {\n        validator: (rule, value, callback) => {\n          if (value !== forgetForm.newPassword) {\n            callback(new Error(\"两次密码不一致\"));\n          } else {\n            callback();\n          }\n        },\n        trigger: \"blur\"\n      }]\n    };\n    const sendVerifyCode = () => {\n      if (!/^1[3-9]\\d{9}$/.test(forgetForm.phone)) {\n        ElMessage.error(\"请输入正确的手机号\");\n        return;\n      }\n\n      // 模拟发送验证码\n      ElMessage.success(`验证码已发送至 ${forgetForm.phone}`);\n      countDown.value = 60;\n      const timer = setInterval(() => {\n        countDown.value--;\n        if (countDown.value <= 0) {\n          clearInterval(timer);\n        }\n      }, 1000);\n    };\n    const handleResetPassword = () => {\n      forgetFormRef.value.validate(valid => {\n        if (valid) {\n          // 模拟重置密码逻辑\n          ElMessage.success(\"密码重置成功\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"请检查表单\");\n          return false;\n        }\n      });\n    };\n    const __returned__ = {\n      logo,\n      forgetFormRef,\n      router,\n      forgetForm,\n      countDown,\n      forgetRules,\n      sendVerifyCode,\n      handleResetPassword,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElForm() {\n        return ElForm;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","ElMessage","ElForm","logo","forgetFormRef","router","forgetForm","phone","verifyCode","newPassword","confirmPassword","countDown","forgetRules","required","message","trigger","pattern","len","min","max","validator","rule","value","callback","Error","sendVerifyCode","test","error","success","timer","setInterval","clearInterval","handleResetPassword","validate","valid","push"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/ForgetpasswordPage.vue"],"sourcesContent":["<!--src/views/login/ForgetpasswordPage-->\n<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">找回密码</h1>\n      </div>\n\n      <El-form\n        ref=\"forgetFormRef\"\n        :model=\"forgetForm\"\n        :rules=\"forgetRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"phone\">\n          <El-input\n            v-model=\"forgetForm.phone\"\n            prefix-icon=\"Mobile\"\n            placeholder=\"请输入注册手机号\"\n            clearable\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"verifyCode\">\n          <El-input\n            v-model=\"forgetForm.verifyCode\"\n            prefix-icon=\"Chat\"\n            placeholder=\"请输入验证码\"\n          >\n            <template #append>\n              <El-button :disabled=\"countDown > 0\" @click=\"sendVerifyCode\">\n                {{ countDown > 0 ? `重新发送(${countDown}s)` : \"获取验证码\" }}\n              </El-button>\n            </template>\n          </El-input>\n        </El-form-item>\n\n        <El-form-item prop=\"newPassword\">\n          <El-input\n            v-model=\"forgetForm.newPassword\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"请设置新密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"confirmPassword\">\n          <El-input\n            v-model=\"forgetForm.confirmPassword\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"确认新密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button\n            type=\"primary\"\n            class=\"login-btn\"\n            @click=\"handleResetPassword\"\n          >\n            重置密码\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"$router.push('/login')\">\n            返回登录\n          </El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport { ElForm } from \"element-plus\";\nconst logo = \"/assets/logo.png\";\nconst forgetFormRef = ref(null);\nconst router = useRouter();\nconst forgetForm = reactive({\n  phone: \"\",\n  verifyCode: \"\",\n  newPassword: \"\",\n  confirmPassword: \"\",\n});\n\nconst countDown = ref(0);\n\nconst forgetRules = {\n  phone: [\n    { required: true, message: \"请输入手机号\", trigger: \"blur\" },\n    {\n      pattern: /^1[3-9]\\d{9}$/,\n      message: \"请输入正确的手机号\",\n      trigger: \"blur\",\n    },\n  ],\n  verifyCode: [\n    { required: true, message: \"请输入验证码\", trigger: \"blur\" },\n    { len: 6, message: \"验证码为6位数字\", trigger: \"blur\" },\n  ],\n  newPassword: [\n    { required: true, message: \"请设置新密码\", trigger: \"blur\" },\n    { min: 6, max: 16, message: \"密码长度6-16位\", trigger: \"blur\" },\n  ],\n  confirmPassword: [\n    { required: true, message: \"请确认新密码\", trigger: \"blur\" },\n    {\n      validator: (rule, value, callback) => {\n        if (value !== forgetForm.newPassword) {\n          callback(new Error(\"两次密码不一致\"));\n        } else {\n          callback();\n        }\n      },\n      trigger: \"blur\",\n    },\n  ],\n};\n\nconst sendVerifyCode = () => {\n  if (!/^1[3-9]\\d{9}$/.test(forgetForm.phone)) {\n    ElMessage.error(\"请输入正确的手机号\");\n    return;\n  }\n\n  // 模拟发送验证码\n  ElMessage.success(`验证码已发送至 ${forgetForm.phone}`);\n  countDown.value = 60;\n\n  const timer = setInterval(() => {\n    countDown.value--;\n    if (countDown.value <= 0) {\n      clearInterval(timer);\n    }\n  }, 1000);\n};\n\nconst handleResetPassword = () => {\n  forgetFormRef.value.validate((valid) => {\n    if (valid) {\n      // 模拟重置密码逻辑\n      ElMessage.success(\"密码重置成功\");\n      router.push(\"/login\");\n    } else {\n      ElMessage.error(\"请检查表单\");\n      return false;\n    }\n  });\n};\n</script>\n\n<style scoped>\n/* 直接使用login.vue的样式 */\n</style>\n"],"mappings":"AA+EA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,MAAM,QAAQ,cAAc;AACrC,MAAMC,IAAI,GAAG,kBAAkB;;;;;;;IAC/B,MAAMC,aAAa,GAAGL,GAAG,CAAC,IAAI,CAAC;IAC/B,MAAMM,MAAM,GAAGL,SAAS,CAAC,CAAC;IAC1B,MAAMM,UAAU,GAAGR,QAAQ,CAAC;M