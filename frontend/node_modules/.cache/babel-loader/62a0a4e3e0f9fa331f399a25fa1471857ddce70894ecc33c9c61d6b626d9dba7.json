{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport { ElCarousel, ElCarouselItem, ElSelect, ElOption, ElButton, ElRow, ElCol, ElCard, ElPagination, ElMenu, ElMenuItem } from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\nimport axios from \"axios\"; // 引入 axios 请求库\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter(); // 获取路由对象\n    const store = useStore(); // 获取 Vuex store\n    const nickName = ref(\"\"); // 用户昵称\n    const products = ref([]); // 产品数据\n    const searchQuery = ref(\"\"); // 搜索查询\n    const selectedCategory = ref(\"\");\n    const selectedSort = ref(\"\");\n    const currentPage = ref(1);\n    const pageSize = ref(8);\n    const ads = ref([{\n      image: \"/assets/苹果13.png\"\n    }, {\n      image: \"/assets/苹果15Pro.png\"\n    }, {\n      image: \"/assets/微软二合一ipad.png\"\n    }]);\n\n    // 获取用户信息的方法\n    const fetchUserData = () => {\n      nickName.value = store.getters.userNickname; // 设置用户昵称\n    };\n\n    // 新增内容 - 获取产品数据\n    const fetchProducts = async () => {\n      try {\n        const response = await axios.get(\"/api/products\"); // 调用 API\n        products.value = response.data; // 设置产品数据\n      } catch (error) {\n        console.error(\"获取产品失败:\", error); // 处理错误\n      }\n    };\n    const userAvatar = computed(() => {\n      return store.getters.userAvatar || \"/assets/avatar.png\"; // 引入默认头像\n    });\n\n    // 在组件挂载时调用方法\n    onMounted(() => {\n      fetchUserData(); // 获取用户信息\n      fetchProducts(); // 获取产品数据\n    });\n    const userNickname = computed(() => store.getters.userNickname); // 计算属性获取用户昵称\n\n    // 计算属性 - 过滤产品\n    const filteredProducts = computed(() => {\n      let filtered = products.value;\n\n      // 搜索过滤\n      if (searchQuery.value) {\n        filtered = filtered.filter(product => product.title.includes(searchQuery.value));\n      }\n\n      // 分类过滤\n      if (selectedCategory.value) {\n        filtered = filtered.filter(product => product.category === selectedCategory.value);\n      }\n\n      // 排序\n      if (selectedSort.value === \"low-to-high\") {\n        filtered.sort((a, b) => a.price - b.price);\n      } else if (selectedSort.value === \"high-to-low\") {\n        filtered.sort((a, b) => b.price - a.price);\n      } else if (selectedSort.value === \"hot-to-high\") {\n        filtered.sort((a, b) => b.sales - a.sales);\n      }\n\n      // 分页\n      const start = (currentPage.value - 1) * pageSize.value;\n      return filtered.slice(start, start + pageSize.value);\n    });\n\n    // 应用过滤\n    const applyFilters = () => {\n      currentPage.value = 1; // 重置为第一页\n    };\n\n    // 跳转到首页并刷新\n    const goHome = () => {\n      window.location.reload(); // 强制刷新页面\n    };\n\n    // 跳转到商品详情\n    const viewProductDetails = product => {\n      router.push(`/ProductPage/${product.id}`);\n    };\n\n    // 处理分页\n    const handlePageChange = page => {\n      currentPage.value = page;\n    };\n\n    // 选择分类\n    const selectCategory = category => {\n      selectedCategory.value = category;\n    };\n\n    // 退出登录功能\n    const logout = () => {\n      console.log(\"用户已注销\");\n      store.commit(\"clearUser\"); // 清空用户信息\n      router.push({\n        name: \"Login\"\n      }); // 跳转到登录页面\n    };\n\n    // 获取产品数据\n    fetchProducts(); // 初始加载时获取产品数据\n\n    const __returned__ = {\n      router,\n      store,\n      nickName,\n      products,\n      searchQuery,\n      selectedCategory,\n      selectedSort,\n      currentPage,\n      pageSize,\n      ads,\n      fetchUserData,\n      fetchProducts,\n      userAvatar,\n      userNickname,\n      filteredProducts,\n      applyFilters,\n      goHome,\n      viewProductDetails,\n      handlePageChange,\n      selectCategory,\n      logout,\n      ref,\n      computed,\n      onMounted,\n      get ElCarousel() {\n        return ElCarousel;\n      },\n      get ElCarouselItem() {\n        return ElCarouselItem;\n      },\n      get ElSelect() {\n        return ElSelect;\n      },\n      get ElOption() {\n        return ElOption;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElRow() {\n        return ElRow;\n      },\n      get ElCol() {\n        return ElCol;\n      },\n      get ElCard() {\n        return ElCard;\n      },\n      get ElPagination() {\n        return ElPagination;\n      },\n      get ElMenu() {\n        return ElMenu;\n      },\n      get ElMenuItem() {\n        return ElMenuItem;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","ElCarousel","ElCarouselItem","ElSelect","ElOption","ElButton","ElRow","ElCol","ElCard","ElPagination","ElMenu","ElMenuItem","useRouter","useStore","axios","router","store","nickName","products","searchQuery","selectedCategory","selectedSort","currentPage","pageSize","ads","image","fetchUserData","value","getters","userNickname","fetchProducts","response","get","data","error","console","userAvatar","filteredProducts","filtered","filter","product","title","includes","category","sort","a","b","price","sales","start","slice","applyFilters","goHome","window","location","reload","viewProductDetails","push","id","handlePageChange","page","selectCategory","logout","log","commit","name"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <img src=\"/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <El-button class=\"home-button\" @click=\"goHome\">首页</El-button>\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userNickname }}</span>\n          <img\n            v-if=\"userAvatar\"\n            :src=\"userAvatar\"\n            alt=\"用户头像\"\n            class=\"user-avatar\"\n          />\n          <span class=\"user-action\" @click=\"goToProfile\">个人中心</span>\n          <span class=\"user-action\">购物车</span>\n          <span class=\"user-action\">我的订单</span>\n          <span class=\"user-action\">店铺关注</span>\n          <span class=\"user-action\">浏览记录</span>\n          <span class=\"user-action\" @click=\"logout\">退出登录</span>\n          <input\n            v-model=\"searchQuery\"\n            type=\"text\"\n            class=\"search-input\"\n            placeholder=\"搜索商品\"\n          />\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"1\" class=\"category-menu\">\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\"\n            >家用电器</El-menu-item\n          >\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机/通讯/数码')\"\n            >手机/通讯/数码</El-menu-item\n          >\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具/家居/厨房')\"\n          >家具/家居/厨房</El-menu-item\n          >\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装/女装/童装/内衣')\"\n          >男装/女装/童装/内衣</El-menu-item\n          >\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆/个护清洁')\"\n          >美妆/个护清洁</El-menu-item\n          >\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋/箱包/珠宝')\"\n          >女鞋/箱包/珠宝</El-menu-item\n          >\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋/运动/户外')\"\n          >男鞋/运动/户外</El-menu-item\n          >\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品/酒类/生鲜')\"\n          >食品/酒类/生鲜</El-menu-item\n          >\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术/礼品花/园艺')\"\n          >艺术/礼品花/园艺</El-menu-item\n          >\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书/文娱/教育')\"\n          >图书/文娱/教育</El-menu-item\n          >\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票/酒店/旅游')\"\n          >机票/酒店/旅游</El-menu-item\n          >\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付/保险/金融')\"\n          >支付/保险/金融</El-menu-item\n          >\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具/乐器')\"\n            >玩具/乐器</El-menu-item\n          >\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <section class=\"ad-banner\">\n          <div class=\"static-ads\">\n            <img src=\"/assets/车厘子.png\" alt=\"广告1\" class=\"ad-image\" />\n            <img src=\"/assets/广告1.png\" alt=\"广告2\" class=\"ad-image\" />\n          </div>\n          <El-carousel\n            class=\"carousel\"\n            :autoplay=\"true\"\n            interval=\"5000\"\n            arrow=\"always\"\n          >\n            <El-carousel-item v-for=\"ad in ads\" :key=\"ad.image\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </El-carousel-item>\n          </El-carousel>\n        </section>\n\n        <section class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n            <El-option label=\"销量从高到低\" value=\"hot-to-high\"></El-option>\n          </El-select>\n          <El-button type=\"primary\" @click=\"applyFilters\">应用</El-button>\n        </section>\n\n        <section class=\"products\">\n          <h2 class=\"section-title\">热卖商品</h2>\n          <El-row :gutter=\"20\">\n            <El-col\n              v-for=\"product in filteredProducts\"\n              :key=\"product.id\"\n              :span=\"6\"\n            >\n              <El-card :body-style=\"{ padding: '10px' }\" class=\"product-card\">\n                <img :src=\"product.image\" class=\"product-image\" alt=\"\" />\n                <div class=\"product-info\">\n                  <h3>{{ product.title }}</h3>\n                  <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                  <El-button type=\"primary\" @click=\"viewProductDetails(product)\"\n                    >查看商品详情</El-button\n                  >\n                </div>\n              </El-card>\n            </El-col>\n          </El-row>\n          <El-pagination\n            :current-page=\"currentPage\"\n            :page-size=\"pageSize\"\n            :total=\"filteredProducts.length\"\n            @current-change=\"handlePageChange\"\n          />\n        </section>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport {\n  ElCarousel,\n  ElCarouselItem,\n  ElSelect,\n  ElOption,\n  ElButton,\n  ElRow,\n  ElCol,\n  ElCard,\n  ElPagination,\n  ElMenu,\n  ElMenuItem,\n} from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\nimport axios from \"axios\"; // 引入 axios 请求库\n\nconst router = useRouter(); // 获取路由对象\nconst store = useStore(); // 获取 Vuex store\nconst nickName = ref(\"\"); // 用户昵称\nconst products = ref([]); // 产品数据\nconst searchQuery = ref(\"\"); // 搜索查询\nconst selectedCategory = ref(\"\");\nconst selectedSort = ref(\"\");\nconst currentPage = ref(1);\nconst pageSize = ref(8);\nconst ads = ref([\n  { image: \"/assets/苹果13.png\" },\n  { image: \"/assets/苹果15Pro.png\" },\n  { image: \"/assets/微软二合一ipad.png\" },\n]);\n\n// 获取用户信息的方法\nconst fetchUserData = () => {\n  nickName.value = store.getters.userNickname; // 设置用户昵称\n};\n\n// 新增内容 - 获取产品数据\nconst fetchProducts = async () => {\n  try {\n    const response = await axios.get(\"/api/products\"); // 调用 API\n    products.value = response.data; // 设置产品数据\n  } catch (error) {\n    console.error(\"获取产品失败:\", error); // 处理错误\n  }\n};\n\nconst userAvatar = computed(() => {\n  return store.getters.userAvatar || \"/assets/avatar.png\"; // 引入默认头像\n});\n\n// 在组件挂载时调用方法\nonMounted(() => {\n  fetchUserData(); // 获取用户信息\n  fetchProducts(); // 获取产品数据\n});\n\nconst userNickname = computed(() => store.getters.userNickname); // 计算属性获取用户昵称\n\n// 计算属性 - 过滤产品\nconst filteredProducts = computed(() => {\n  let filtered = products.value;\n\n  // 搜索过滤\n  if (searchQuery.value) {\n    filtered = filtered.filter((product) =>\n      product.title.includes(searchQuery.value),\n    );\n  }\n\n  // 分类过滤\n  if (selectedCategory.value) {\n    filtered = filtered.filter(\n      (product) => product.category === selectedCategory.value,\n    );\n  }\n\n  // 排序\n  if (selectedSort.value === \"low-to-high\") {\n    filtered.sort((a, b) => a.price - b.price);\n  } else if (selectedSort.value === \"high-to-low\") {\n    filtered.sort((a, b) => b.price - a.price);\n  } else if (selectedSort.value === \"hot-to-high\") {\n    filtered.sort((a, b) => b.sales - a.sales);\n  }\n\n  // 分页\n  const start = (currentPage.value - 1) * pageSize.value;\n  return filtered.slice(start, start + pageSize.value);\n});\n\n// 应用过滤\nconst applyFilters = () => {\n  currentPage.value = 1; // 重置为第一页\n};\n\n// 跳转到首页并刷新\nconst goHome = () => {\n  window.location.reload(); // 强制刷新页面\n};\n\n// 跳转到商品详情\nconst viewProductDetails = (product) => {\n  router.push(`/ProductPage/${product.id}`);\n};\n\n// 处理分页\nconst handlePageChange = (page) => {\n  currentPage.value = page;\n};\n\n// 选择分类\nconst selectCategory = (category) => {\n  selectedCategory.value = category;\n};\n\n// 退出登录功能\nconst logout = () => {\n  console.log(\"用户已注销\");\n  store.commit(\"clearUser\"); // 清空用户信息\n  router.push({ name: \"Login\" }); // 跳转到登录页面\n};\n\n// 获取产品数据\nfetchProducts(); // 初始加载时获取产品数据\n</script>\n\n<style lang=\"scss\" scoped>\n/* 这里是之前提供的样式代码，保持不变 */\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .home-button {\n        margin-right: 20px; /*为首页按钮添加右边距*/\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n\n        .search-input {\n          padding: 8px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 200px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n  .user-avatar {\n    width: 40px; /* 头像宽度 */\n    height: 40px; /* 头像高度 */\n    border-radius: 50%; /* 圆形头像 */\n    margin-left: 10px; /* 与昵称之间的间距 */\n  }\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4;\n  }\n\n  .category-menu {\n    padding: 10px;\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .ad-banner {\n      display: flex;\n      align-items: center; /* 此时保持广告栏对齐 */\n      margin-bottom: 20px;\n\n      .static-ads {\n        display: flex; /* 使用 flexbox 使广告在同一行 */\n        flex: 1; /* 调整两侧静态广告的宽度 */\n        justify-content: space-between; /* 在广告之间留出间距 */\n        margin-right: 20px; /* 右侧留出间距 */\n      }\n\n      .ad-image {\n        height: 500px; /* 设置每个静态广告的高度 */\n        flex: 1; /* 每个广告等分宽度 */\n        object-fit: cover; /* 保持比例 */\n        margin: 0 10px; /* 设置广告之间的间隙 */\n      }\n\n      .carousel {\n        height: 500px; /* 高度设置为 500px 以对齐 */\n        flex: 2; /* 确保轮播占用更多空间 */\n        position: relative; /* 为了确保图片可以覆盖整个区域 */\n\n        .el-carousel__item {\n          height: 500px; /* 确保每个轮播项的高度为 500px */\n        }\n\n        .ad-image {\n          width: 100%; /* 确保图片宽度100% */\n          height: 100%; /* 确保图片高度为100% */\n          object-fit: cover; /* 确保图片填充，同时保持比例 */\n        }\n      }\n    }\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px;\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n\n      .product-image {\n        width: 100%;\n        height: auto;\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 5px;\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AAyIA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SACEC,UAAU,EACVC,cAAc,EACdC,QAAQ,EACRC,QAAQ,EACRC,QAAQ,EACRC,KAAK,EACLC,KAAK,EACLC,MAAM,EACNC,YAAY,EACZC,MAAM,EACNC,UAAU,QACL,cAAc;AACrB,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;AACjC,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;;;;;;;;IAE3B,MAAMC,MAAM,GAAGH,SAAS,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMI,KAAK,GAAGH,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMI,QAAQ,GAAGnB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC1B,MAAMoB,QAAQ,GAAGpB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC1B,MAAMqB,WAAW,GAAGrB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC7B,MAAMsB,gBAAgB,GAAGtB,GAAG,CAAC,EAAE,CAAC;IAChC,MAAMuB,YAAY,GAAGvB,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMwB,WAAW,GAAGxB,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMyB,QAAQ,GAAGzB,GAAG,CAAC,CAAC,CAAC;IACvB,MAAM0B,GAAG,GAAG1