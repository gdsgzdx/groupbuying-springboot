{"ast":null,"code":"import { ref, onMounted } from \"vue\"; // 使用双引号\nimport { useRoute, useRouter } from \"vue-router\"; // 使用双引号\nimport { ElButton } from \"element-plus\"; // 使用双引号\n\nexport default {\n  __name: 'ProductPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute(); // 获取当前路由\n    const router = useRouter(); // 路由实例化\n\n    const product = ref({\n      name: \"\",\n      price: 0,\n      imageUrl: \"\",\n      description: \"\",\n      stock: 0 // 添加库存属性\n    });\n    const showOptions = ref(false); // 控制立即购买选项的显示\n\n    // 获取商品详细信息\n    onMounted(async () => {\n      const productId = route.params.id; // 从路由参数获取商品 ID\n      console.log(`请求商品 ID: ${productId}`); // 调试输出请求的商品 ID\n      const response = await fetch(`http://localhost:5000/api/products/${productId}`); // 请求商品详情 API\n\n      console.log(`API 响应状态: ${response.status}`); // 输出 API 响应状态\n\n      if (response.ok) {\n        const productData = await response.json(); // 将获取到的商品信息存储\n        console.log(\"获取到的商品数据:\", productData); // 输出获取到的商品数据\n\n        product.value = productData.data; // 将商品数据赋值给 product\n        product.value.price = parseFloat(product.value.price) || 0; // 将价格转为数字\n        console.log(`商品名称: ${product.value.name}, 价格: ¥${product.value.price}`); // 输出商品名称和价格\n      } else {\n        console.error(\"获取商品详情失败，状态码:\", response.status); // 错误处理\n      }\n    });\n\n    // 加入购物车\n    const addToCart = () => {\n      alert(`${product.value.name} 已加入购物车！`); // 提示已加入购物车\n    };\n\n    // 显示购买选项\n    const showPurchaseOptions = () => {\n      showOptions.value = true; // 控制购买选项的显示\n    };\n\n    // 拼团购买\n    const purchaseAsGroup = () => {\n      alert(\"选择拼团购买功能！\"); // 实际功能可实现拼团逻辑\n    };\n\n    // 单独购买\n    const purchaseSeparately = () => {\n      alert(\"选择单独购买功能！\"); // 实际功能可实现单独购买逻辑\n    };\n\n    // 跳转到购物车页面\n    const goToCart = () => {\n      router.push(\"/cart\"); // 导航到购物车页面\n    };\n    const __returned__ = {\n      route,\n      router,\n      product,\n      showOptions,\n      addToCart,\n      showPurchaseOptions,\n      purchaseAsGroup,\n      purchaseSeparately,\n      goToCart,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElButton() {\n        return ElButton;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","useRouter","ElButton","route","router","product","name","price","imageUrl","description","stock","showOptions","productId","params","id","console","log","response","fetch","status","ok","productData","json","value","data","parseFloat","error","addToCart","alert","showPurchaseOptions","purchaseAsGroup","purchaseSeparately","goToCart","push"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/product/ProductPage.vue"],"sourcesContent":["<template>\n  <div class=\"product-page\">\n    <div class=\"product-container\">\n      <div class=\"product-header\">\n        <h1>{{ product.name }}</h1>\n        <p class=\"price\">价格: ¥{{ product.price }}</p>\n      </div>\n\n      <div class=\"product-content\">\n        <img :src=\"product.imageUrl\" alt=\"商品图片\" class=\"product-image\" />\n\n        <div class=\"product-details\">\n          <p class=\"description\">{{ product.description }}</p>\n          <p class=\"stock\">库存: {{ product.stock }}件</p>\n          <!-- 显示库存数量 -->\n\n          <div class=\"action-buttons\">\n            <ElButton type=\"primary\" @click=\"addToCart\">加入购物车</ElButton>\n            <ElButton type=\"danger\" @click=\"showPurchaseOptions\"\n              >立即购买</ElButton\n            >\n          </div>\n        </div>\n      </div>\n\n      <!-- 立即购买选项 -->\n      <div v-if=\"showOptions\" class=\"purchase-options\">\n        <ElButton type=\"success\" @click=\"purchaseAsGroup\">拼团购买</ElButton>\n        <ElButton type=\"warning\" @click=\"purchaseSeparately\">单独购买</ElButton>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from \"vue\"; // 使用双引号\nimport { useRoute, useRouter } from \"vue-router\"; // 使用双引号\nimport { ElButton } from \"element-plus\"; // 使用双引号\n\nconst route = useRoute(); // 获取当前路由\nconst router = useRouter(); // 路由实例化\n\nconst product = ref({\n  name: \"\",\n  price: 0,\n  imageUrl: \"\",\n  description: \"\",\n  stock: 0, // 添加库存属性\n});\nconst showOptions = ref(false); // 控制立即购买选项的显示\n\n// 获取商品详细信息\nonMounted(async () => {\n  const productId = route.params.id; // 从路由参数获取商品 ID\n  console.log(`请求商品 ID: ${productId}`); // 调试输出请求的商品 ID\n  const response = await fetch(\n    `http://localhost:5000/api/products/${productId}`,\n  ); // 请求商品详情 API\n\n  console.log(`API 响应状态: ${response.status}`); // 输出 API 响应状态\n\n  if (response.ok) {\n    const productData = await response.json(); // 将获取到的商品信息存储\n    console.log(\"获取到的商品数据:\", productData); // 输出获取到的商品数据\n\n    product.value = productData.data; // 将商品数据赋值给 product\n    product.value.price = parseFloat(product.value.price) || 0; // 将价格转为数字\n    console.log(\n      `商品名称: ${product.value.name}, 价格: ¥${product.value.price}`,\n    ); // 输出商品名称和价格\n  } else {\n    console.error(\"获取商品详情失败，状态码:\", response.status); // 错误处理\n  }\n});\n\n// 加入购物车\nconst addToCart = () => {\n  alert(`${product.value.name} 已加入购物车！`); // 提示已加入购物车\n};\n\n// 显示购买选项\nconst showPurchaseOptions = () => {\n  showOptions.value = true; // 控制购买选项的显示\n};\n\n// 拼团购买\nconst purchaseAsGroup = () => {\n  alert(\"选择拼团购买功能！\"); // 实际功能可实现拼团逻辑\n};\n\n// 单独购买\nconst purchaseSeparately = () => {\n  alert(\"选择单独购买功能！\"); // 实际功能可实现单独购买逻辑\n};\n\n// 跳转到购物车页面\nconst goToCart = () => {\n  router.push(\"/cart\"); // 导航到购物车页面\n};\n</script>\n\n<style scoped>\n.product-page {\n  max-width: 800px; /* 最大宽度 */\n  margin: auto; /* 居中 */\n  padding: 20px; /* 内边距 */\n  text-align: left; /* 左对齐 */\n}\n\n.product-container {\n  display: flex; /* 使用flex布局 */\n  flex-direction: column; /* 纵向排列 */\n}\n\n.product-header {\n  margin-bottom: 20px;\n}\n\n.price {\n  font-size: 24px;\n  color: #f65a8b;\n}\n\n.product-content {\n  display: flex; /* 使用flex布局 */\n  align-items: flex-start; /* 顶部对齐 */\n}\n\n.product-image {\n  max-width: 250px; /* 设置图片最大宽度 */\n  height: auto; /* 保持比例 */\n  border-radius: 8px; /* 圆角 */\n  margin-right: 20px; /* 右边距 */\n}\n\n.product-details {\n  flex-grow: 1; /* 使描述区域占据剩余空间 */\n}\n\n.description {\n  font-size: 16px;\n  line-height: 1.5;\n  margin-bottom: 10px; /* 适当的下边距 */\n}\n\n.stock {\n  font-size: 16px;\n  margin-bottom: 20px; /* 适当的下边距 */\n}\n\n.action-buttons {\n  display: flex; /* 水平排列按钮 */\n  gap: 10px; /* 按钮间距 */\n}\n\n.purchase-options {\n  margin-top: 20px; /* 到顶部间距 */\n  display: flex; /* 水平排列购买按钮 */\n  gap: 10px; /* 按钮间距 */\n}\n</style>\n"],"mappings":"AAmCA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK,CAAC,CAAC;AACtC,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAY,CAAC,CAAC;AAClD,SAASC,QAAQ,QAAQ,cAAc,CAAC,CAAC;;;;;;;;IAEzC,MAAMC,KAAK,GAAGH,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMI,MAAM,GAAGH,SAAS,CAAC,CAAC,CAAC,CAAC;;IAE5B,MAAMI,OAAO,GAAGP,GAAG,CAAC;MAClBQ,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,CAAC;MACRC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,KAAK,EAAE,CAAC,CAAE;IACZ,CAAC,CAAC;IACF,MAAMC,WAAW,GAAGb,GAAG,CAAC,KAAK,CAAC,CAAC,CAAC;;IAEhC;IACAC,SAAS,CAAC,YAAY;MACpB,MAAMa,SAAS,GAAGT,KAAK,CAACU,MAAM,CAACC,EAAE,CAAC,CAAC;MACnCC,OAAO,CAACC,GAAG,CAAC,YAAYJ,SAAS,EAAE,CAAC,CAAC,CAAC;MACtC,MAAMK,QAAQ,GAAG,MAAMC,KAAK,CAC1B,sCAAsCN,SAAS,EACjD,CAAC,CAAC,CAAC;;MAEHG,OAAO,CAACC,GAAG,CAAC,aAAaC,QAAQ,CAACE,MAAM,EAAE,CAAC,CAAC,CAAC;;MAE7C,IAAIF,QAAQ,CAACG,EAAE,EAAE;QACf,MAAMC,WAAW,GAAG,MAAMJ,QAAQ,CAACK,IAAI,CAAC,CAAC,CAAC,CAAC;QAC3CP,OAAO,CAACC,GAAG,CAAC,WAAW,EAAEK,WAAW,CAAC,CAAC,CAAC;;QAEvChB,OAAO,CAACkB,KAAK,GAAGF,WAAW,CAACG,IAAI,CAAC,CAAC;QAClCnB,OAAO,CAACkB,KAAK,CAAChB,KAAK,GAAGkB,UAAU,CAACpB,OAAO,CAACkB,KAAK,CAAChB,KAAK,CAAC,IAAI,CAAC,CAAC,CAAC;QAC5DQ,OAAO