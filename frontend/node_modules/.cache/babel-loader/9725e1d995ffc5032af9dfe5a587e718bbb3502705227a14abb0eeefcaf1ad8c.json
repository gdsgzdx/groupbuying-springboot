{"ast":null,"code":"import { ref, computed } from \"vue\";\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const products = ref([{\n      id: 1,\n      title: \"苹果 iPhone 16 Pro\",\n      price: 8999.0,\n      image: require(\"@/assets/苹果手机.png\")\n    }, {\n      id: 2,\n      title: \"哈密瓜\",\n      price: 5299.0,\n      image: require(\"@/assets/哈密瓜.png\")\n    }, {\n      id: 3,\n      title: \"华为 Mate 40 Pro\",\n      price: 7999.0,\n      image: require(\"@/assets/笔记本电脑.png\")\n    }]);\n\n    // 状态管理\n    const selectedCategory = ref(\"\");\n    const selectedSort = ref(\"\");\n    const currentPage = ref(1);\n    const pageSize = ref(8);\n\n    // 计算属性\n    const filteredProducts = computed(() => {\n      let filtered = products.value;\n\n      // 分类过滤\n      if (selectedCategory.value) {\n        filtered = filtered.filter(product => product.category === selectedCategory.value);\n      }\n\n      // 排序\n      if (selectedSort.value === \"low-to-high\") {\n        filtered.sort((a, b) => a.price - b.price);\n      } else if (selectedSort.value === \"high-to-low\") {\n        filtered.sort((a, b) => b.price - a.price);\n      }\n\n      // 分页\n      const start = (currentPage.value - 1) * pageSize.value;\n      return filtered.slice(start, start + pageSize.value);\n    });\n\n    // 应用过滤\n    const applyFilters = () => {\n      currentPage.value = 1; // 重置为第一页\n    };\n\n    // 处理分页\n    const handlePageChange = page => {\n      currentPage.value = page;\n    };\n    const addToCart = product => {\n      console.log(\"加入购物车:\", product);\n    };\n    const __returned__ = {\n      products,\n      selectedCategory,\n      selectedSort,\n      currentPage,\n      pageSize,\n      filteredProducts,\n      applyFilters,\n      handlePageChange,\n      addToCart,\n      ref,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","products","id","title","price","image","require","selectedCategory","selectedSort","currentPage","pageSize","filteredProducts","filtered","value","filter","product","category","sort","a","b","start","slice","applyFilters","handlePageChange","page","addToCart","console","log"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <!-- Logo -->\n        <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <input type=\"text\" placeholder=\"搜索商品\" class=\"search-input\" />\n        <div class=\"user-actions\">\n          <span class=\"user-action\">购物车</span>\n          <span class=\"user-action\">我的订单</span>\n          <span class=\"user-action\">店铺关注</span>\n          <span class=\"user-action\">浏览记录</span>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <!-- 商品分类 -->\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"1\" class=\"category-menu\">\n          <El-menu-item index=\"1\">家用电器</El-menu-item>\n          <El-menu-item index=\"2\">手机/通讯/数码</El-menu-item>\n          <El-menu-item index=\"3\">电脑/办公/文具用品</El-menu-item>\n          <El-menu-item index=\"4\">家具/家居/厨房</El-menu-item>\n          <El-menu-item index=\"5\">男装/女装/童装/内衣</El-menu-item>\n          <El-menu-item index=\"6\">美妆/个护清洁</El-menu-item>\n          <El-menu-item index=\"7\">女鞋/箱包/珠宝</El-menu-item>\n          <El-menu-item index=\"8\">男鞋/运动/户外</El-menu-item>\n          <El-menu-item index=\"9\">食品/酒类/生鲜</El-menu-item>\n          <El-menu-item index=\"10\">艺术/礼品花/园艺</El-menu-item>\n          <El-menu-item index=\"11\">图书/文娱/教育</El-menu-item>\n          <El-menu-item index=\"12\">机票/酒店/旅游</El-menu-item>\n          <El-menu-item index=\"13\">支付/保险/金融</El-menu-item>\n          <El-menu-item index=\"14\">玩具/乐器</El-menu-item>\n        </El-menu>\n      </aside>\n\n      <!-- 商品过滤和展示部分 -->\n      <section class=\"product-section\">\n        <section class=\"filter-section\">\n          <El-select v-model=\"selectedCategory\" placeholder=\"选择分类\">\n            <El-option label=\"手机\" value=\"phone\"></El-option>\n            <El-option label=\"电脑\" value=\"computer\"></El-option>\n            <El-option label=\"家电\" value=\"appliance\"></El-option>\n          </El-select>\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n          </El-select>\n          <El-button type=\"primary\" @click=\"applyFilters\">应用</El-button>\n        </section>\n\n        <!-- 商品展示 -->\n        <section class=\"products\">\n          <h2 class=\"section-title\">热卖商品</h2>\n          <El-row :gutter=\"20\">\n            <El-col\n              v-for=\"product in filteredProducts\"\n              :key=\"product.id\"\n              :span=\"6\"\n            >\n              <El-card :body-style=\"{ padding: '10px' }\" class=\"product-card\">\n                <img :src=\"product.image\" class=\"product-image\" />\n                <div class=\"product-info\">\n                  <h3>{{ product.title }}</h3>\n                  <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                  <El-button type=\"primary\" @click=\"addToCart(product)\"\n                    >加入购物车</El-button\n                  >\n                </div>\n              </El-card>\n            </El-col>\n          </El-row>\n          <!-- 分页 -->\n          <El-pagination\n            @current-change=\"handlePageChange\"\n            :current-page=\"currentPage\"\n            :page-size=\"pageSize\"\n            :total=\"filteredProducts.length\"\n          />\n        </section>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\n\nconst products = ref([\n  {\n    id: 1,\n    title: \"苹果 iPhone 16 Pro\",\n    price: 8999.0,\n    image: require(\"@/assets/苹果手机.png\"),\n  },\n  {\n    id: 2,\n    title: \"哈密瓜\",\n    price: 5299.0,\n    image: require(\"@/assets/哈密瓜.png\"),\n  },\n  {\n    id: 3,\n    title: \"华为 Mate 40 Pro\",\n    price: 7999.0,\n    image: require(\"@/assets/笔记本电脑.png\"),\n  },\n]);\n\n// 状态管理\nconst selectedCategory = ref(\"\");\nconst selectedSort = ref(\"\");\nconst currentPage = ref(1);\nconst pageSize = ref(8);\n\n// 计算属性\nconst filteredProducts = computed(() => {\n  let filtered = products.value;\n\n  // 分类过滤\n  if (selectedCategory.value) {\n    filtered = filtered.filter(\n      (product) => product.category === selectedCategory.value,\n    );\n  }\n\n  // 排序\n  if (selectedSort.value === \"low-to-high\") {\n    filtered.sort((a, b) => a.price - b.price);\n  } else if (selectedSort.value === \"high-to-low\") {\n    filtered.sort((a, b) => b.price - a.price);\n  }\n\n  // 分页\n  const start = (currentPage.value - 1) * pageSize.value;\n  return filtered.slice(start, start + pageSize.value);\n});\n\n// 应用过滤\nconst applyFilters = () => {\n  currentPage.value = 1; // 重置为第一页\n};\n\n// 处理分页\nconst handlePageChange = (page) => {\n  currentPage.value = page;\n};\n\nconst addToCart = (product) => {\n  console.log(\"加入购物车:\", product);\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center; // 中心对齐\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px; // Logo宽度\n        height: auto; // 自适应高度\n        margin-right: 10px; // Logo与标题间距\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .search-input {\n        padding: 10px; // 增大输入框\n        width: 400px; // 增大输入框\n        border: 1px solid #ccc;\n        border-radius: 5px;\n        margin-right: 20px;\n      }\n\n      .user-actions {\n        display: flex;\n        gap: 15px;\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row; // 横向排列\n  }\n\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4; // 右侧边框\n  }\n\n  .category-menu {\n    padding: 10px; // 内部填充\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px;\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n\n      .product-image {\n        width: 100%;\n        height: auto;\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 5px;\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AAyFA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IAEnC,MAAMC,QAAQ,GAAGF,GAAG,CAAC,CACnB;MACEG,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,kBAAkB;MACzBC,KAAK,EAAE,MAAM;MACbC,KAAK,EAAEC,OAAO,CAAC,mBAAmB;IACpC,CAAC,EACD;MACEJ,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,MAAM;MACbC,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IACnC,CAAC,EACD;MACEJ,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,gBAAgB;MACvBC,KAAK,EAAE,MAAM;MACbC,KAAK,EAAEC,OAAO,CAAC,oBAAoB;IACrC,CAAC,CACF,CAAC;;IAEF;IACA,MAAMC,gBAAgB,GAAGR,GAAG,CAAC,EAAE,CAAC;IAChC,MAAMS,YAAY,GAAGT,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMU,WAAW,GAAGV,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMW,QAAQ,GAAGX,GAAG,CAAC,CAAC,CAAC;;