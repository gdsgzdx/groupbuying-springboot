{"ast":null,"code":"import { ref, computed } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport axios from \"axios\";\nconst API_BASE_URL = \"http://localhost:5000\";\nconst logo = \"/assets/logo.png\";\nexport default {\n  __name: 'ForgetpasswordPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const forgetFormRef = ref(null);\n    const isLoading = ref(false);\n    const securityQuestion = ref(\"\");\n    const isAnswerCorrect = ref(false);\n    const forgetForm = ref({\n      username: \"\",\n      securityAnswer: \"\",\n      newPassword: \"\",\n      confirmPassword: \"\"\n    });\n    const submitButtonText = computed(() => {\n      if (!securityQuestion.value) return \"获取密保问题\";\n      if (!isAnswerCorrect.value) return \"验证密保答案\";\n      return \"重置密码\";\n    });\n    const forgetRules = {\n      username: [{\n        required: true,\n        message: \"请输入用户名\",\n        trigger: \"blur\"\n      }],\n      securityAnswer: [{\n        required: true,\n        message: \"请输入密保答案\",\n        trigger: \"blur\"\n      }],\n      newPassword: [{\n        required: true,\n        message: \"请输入新密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        message: \"密码不能少于6位\",\n        trigger: \"blur\"\n      }],\n      confirmPassword: [{\n        required: true,\n        message: \"请确认密码\",\n        trigger: \"blur\"\n      }, {\n        validator: (rule, value, callback) => {\n          if (value !== forgetForm.value.newPassword) {\n            callback(new Error(\"两次输入的密码不一致\"));\n          } else {\n            callback();\n          }\n        },\n        trigger: \"blur\"\n      }]\n    };\n\n    // 检查用户名并获取密保问题\n    const checkUsername = async () => {\n      if (!forgetForm.value.username) return;\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/user/security-question/${forgetForm.value.username}`);\n        if (response.data.code === 200) {\n          securityQuestion.value = response.data.data;\n        } else {\n          ElMessage.error(response.data.message || \"获取密保问题失败\");\n        }\n      } catch (error) {\n        console.error(\"获取密保问题失败:\", error);\n        ElMessage.error(\"获取密保问题失败，请重试\");\n      }\n    };\n\n    // 处理表单提交\n    const handleSubmit = async () => {\n      if (!forgetFormRef.value) return;\n      await forgetFormRef.value.validate(async valid => {\n        if (!valid) return;\n        isLoading.value = true;\n        try {\n          if (!securityQuestion.value) {\n            await checkUsername();\n          } else if (!isAnswerCorrect.value) {\n            // 验证密保答案\n            const response = await axios.post(`${API_BASE_URL}/api/user/verify-security-answer`, {\n              username: forgetForm.value.username,\n              answer: forgetForm.value.securityAnswer\n            });\n            if (response.data.code === 200) {\n              isAnswerCorrect.value = true;\n              ElMessage.success(\"密保答案正确，请设置新密码\");\n            } else {\n              ElMessage.error(\"密保答案错误\");\n            }\n          } else {\n            // 重置密码\n            const response = await axios.post(`${API_BASE_URL}/api/users/reset-password`, {\n              username: forgetForm.value.username,\n              newPassword: forgetForm.value.newPassword,\n              securityAnswer: forgetForm.value.securityAnswer\n            });\n            if (response.data.code === 200) {\n              ElMessage.success(\"密码重置成功，请重新登录\");\n              router.push(\"/login\");\n            } else {\n              ElMessage.error(response.data.message || \"密码重置失败\");\n            }\n          }\n        } catch (error) {\n          console.error(\"操作失败:\", error);\n          ElMessage.error(\"操作失败，请重试\");\n        } finally {\n          isLoading.value = false;\n        }\n      });\n    };\n    const goToLogin = () => {\n      router.push(\"/login\");\n    };\n    const __returned__ = {\n      API_BASE_URL,\n      logo,\n      router,\n      forgetFormRef,\n      isLoading,\n      securityQuestion,\n      isAnswerCorrect,\n      forgetForm,\n      submitButtonText,\n      forgetRules,\n      checkUsername,\n      handleSubmit,\n      goToLogin,\n      ref,\n      computed,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","useRouter","ElMessage","axios","API_BASE_URL","logo","router","forgetFormRef","isLoading","securityQuestion","isAnswerCorrect","forgetForm","username","securityAnswer","newPassword","confirmPassword","submitButtonText","value","forgetRules","required","message","trigger","min","validator","rule","callback","Error","checkUsername","response","get","data","code","error","console","handleSubmit","validate","valid","post","answer","success","push","goToLogin"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/login/ForgetpasswordPage.vue"],"sourcesContent":["<!--frontend/src/views/login/ForgetpasswordPage-->\n<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">找回密码</h1>\n      </div>\n\n      <El-form\n        ref=\"forgetFormRef\"\n        :model=\"forgetForm\"\n        :rules=\"forgetRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"username\">\n          <El-input\n            v-model=\"forgetForm.username\"\n            prefix-icon=\"User\"\n            placeholder=\"请输入用户名\"\n            clearable\n            @blur=\"checkUsername\"\n          />\n        </El-form-item>\n\n        <!-- 显示密保问题 -->\n        <div v-if=\"securityQuestion\" class=\"security-question\">\n          <p>密保问题：{{ securityQuestion }}</p>\n          <El-form-item prop=\"securityAnswer\">\n            <El-input\n              v-model=\"forgetForm.securityAnswer\"\n              prefix-icon=\"Lock\"\n              placeholder=\"请输入密保答案\"\n            />\n          </El-form-item>\n        </div>\n\n        <El-form-item prop=\"newPassword\" v-if=\"isAnswerCorrect\">\n          <El-input\n            v-model=\"forgetForm.newPassword\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"请设置新密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"confirmPassword\" v-if=\"isAnswerCorrect\">\n          <El-input\n            v-model=\"forgetForm.confirmPassword\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"确认新密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button\n            type=\"primary\"\n            class=\"submit-btn\"\n            :loading=\"isLoading\"\n            @click=\"handleSubmit\"\n          >\n            {{ submitButtonText }}\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"goToLogin\">返回登录</El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport axios from \"axios\";\n\nconst API_BASE_URL = \"http://localhost:5000\";\nconst logo = \"/assets/logo.png\";\nconst router = useRouter();\nconst forgetFormRef = ref(null);\nconst isLoading = ref(false);\nconst securityQuestion = ref(\"\");\nconst isAnswerCorrect = ref(false);\n\nconst forgetForm = ref({\n  username: \"\",\n  securityAnswer: \"\",\n  newPassword: \"\",\n  confirmPassword: \"\",\n});\n\nconst submitButtonText = computed(() => {\n  if (!securityQuestion.value) return \"获取密保问题\";\n  if (!isAnswerCorrect.value) return \"验证密保答案\";\n  return \"重置密码\";\n});\n\nconst forgetRules = {\n  username: [{ required: true, message: \"请输入用户名\", trigger: \"blur\" }],\n  securityAnswer: [\n    { required: true, message: \"请输入密保答案\", trigger: \"blur\" },\n  ],\n  newPassword: [\n    { required: true, message: \"请输入新密码\", trigger: \"blur\" },\n    { min: 6, message: \"密码不能少于6位\", trigger: \"blur\" },\n  ],\n  confirmPassword: [\n    { required: true, message: \"请确认密码\", trigger: \"blur\" },\n    {\n      validator: (rule, value, callback) => {\n        if (value !== forgetForm.value.newPassword) {\n          callback(new Error(\"两次输入的密码不一致\"));\n        } else {\n          callback();\n        }\n      },\n      trigger: \"blur\",\n    },\n  ],\n};\n\n// 检查用户名并获取密保问题\nconst checkUsername = async () => {\n  if (!forgetForm.value.username) return;\n\n  try {\n    const response = await axios.get(\n      `${API_BASE_URL}/api/user/security-question/${forgetForm.value.username}`,\n    );\n\n    if (response.data.code === 200) {\n      securityQuestion.value = response.data.data;\n    } else {\n      ElMessage.error(response.data.message || \"获取密保问题失败\");\n    }\n  } catch (error) {\n    console.error(\"获取密保问题失败:\", error);\n    ElMessage.error(\"获取密保问题失败，请重试\");\n  }\n};\n\n// 处理表单提交\nconst handleSubmit = async () => {\n  if (!forgetFormRef.value) return;\n\n  await forgetFormRef.value.validate(async (valid) => {\n    if (!valid) return;\n\n    isLoading.value = true;\n    try {\n      if (!securityQuestion.value) {\n        await checkUsername();\n      } else if (!isAnswerCorrect.value) {\n        // 验证密保答案\n        const response = await axios.post(\n          `${API_BASE_URL}/api/user/verify-security-answer`,\n          {\n            username: forgetForm.value.username,\n            answer: forgetForm.value.securityAnswer,\n          },\n        );\n\n        if (response.data.code === 200) {\n          isAnswerCorrect.value = true;\n          ElMessage.success(\"密保答案正确，请设置新密码\");\n        } else {\n          ElMessage.error(\"密保答案错误\");\n        }\n      } else {\n        // 重置密码\n        const response = await axios.post(\n          `${API_BASE_URL}/api/users/reset-password`,\n          {\n            username: forgetForm.value.username,\n            newPassword: forgetForm.value.newPassword,\n            securityAnswer: forgetForm.value.securityAnswer,\n          },\n        );\n\n        if (response.data.code === 200) {\n          ElMessage.success(\"密码重置成功，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(response.data.message || \"密码重置失败\");\n        }\n      }\n    } catch (error) {\n      console.error(\"操作失败:\", error);\n      ElMessage.error(\"操作失败，请重试\");\n    } finally {\n      isLoading.value = false;\n    }\n  });\n};\n\nconst goToLogin = () => {\n  router.push(\"/login\");\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(to right, #3494e6, #ec6ead);\n}\n\n.login-wrapper {\n  background: white;\n  padding: 30px;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  width: 400px;\n}\n\n.logo-title-container {\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n.logo {\n  width: 80px;\n  height: 80px;\n  margin-bottom: 10px;\n}\n\n.system-title {\n  font-size: 24px;\n  color: #333;\n  margin: 0;\n}\n\n.login-form {\n  margin-top: 20px;\n}\n\n.submit-btn {\n  width: 100%;\n}\n\n.login-extra {\n  margin-top: 15px;\n  text-align: center;\n}\n\n.security-question {\n  margin: 15px 0;\n  padding: 10px;\n  background-color: #f5f7fa;\n  border-radius: 4px;\n}\n\n.security-question p {\n  margin: 0 0 10px 0;\n  color: #606266;\n  font-size: 14px;\n}\n</style>\n"],"mappings":"AA6EA,S