{"ast":null,"code":"import { computed, ref, onMounted } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport axios from \"axios\";\nconst API_BASE_URL = \"http://localhost:5000\";\n\n// 获取当前用户ID\n\nexport default {\n  __name: 'UserPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n    const router = useRouter();\n\n    // API基础URL\n    const userId = computed(() => store.getters.userId);\n\n    // 编辑对话框相关\n    const editDialogVisible = ref(false);\n    const editForm = ref({\n      avatar: \"\",\n      nickname: \"\",\n      phone: \"\",\n      address: \"\"\n    });\n\n    // 上传头像相关\n    const uploadHeaders = computed(() => {\n      const token = localStorage.getItem(\"token\");\n      return {\n        Authorization: `Bearer ${token}`\n      };\n    });\n\n    // 头像上传前的验证\n    const beforeAvatarUpload = file => {\n      const isImage = file.type.startsWith(\"image/\");\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isImage) {\n        ElMessage.error(\"上传头像图片只能是图片格式!\");\n        return false;\n      }\n      if (!isLt2M) {\n        ElMessage.error(\"上传头像图片大小不能超过 2MB!\");\n        return false;\n      }\n      return true;\n    };\n\n    // 头像上传成功处理\n    const handleAvatarSuccess = response => {\n      if (response.code === 200) {\n        editForm.value.avatar = response.data;\n        store.commit(\"setUserAvatar\", response.data);\n        ElMessage.success(\"头像上传成功\");\n      } else {\n        ElMessage.error(\"头像上传失败：\" + response.message);\n      }\n    };\n\n    // 计算用户信息\n    const userNickname = computed(() => store.getters.userNickname);\n    const userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\n    const userAddress = computed(() => store.getters.userAddress || \"未提供\");\n    const userBalance = computed(() => store.getters.userBalance || 0);\n    const userAvatar = computed(() => store.getters.userAvatar ? `http://localhost:5000${store.getters.userAvatar}` : \"/assets/avatar.png\");\n\n    // 在组件挂载时获取账户余额\n    onMounted(async () => {\n      await store.getters.userBalance;\n    });\n\n    // 显示编辑对话框\n    const showEditDialog = () => {\n      editForm.value = {\n        avatar: userAvatar.value,\n        nickname: userNickname.value,\n        phone: userPhone.value,\n        address: userAddress.value\n      };\n      editDialogVisible.value = true;\n    };\n\n    // 保存资料\n    const saveProfile = async () => {\n      try {\n        await store.dispatch(\"updateUserProfile\", {\n          avatar: editForm.value.avatar,\n          nickname: editForm.value.nickname,\n          phone: editForm.value.phone,\n          address: editForm.value.address\n        });\n        ElMessage.success(\"资料更新成功\");\n        editDialogVisible.value = false;\n      } catch (error) {\n        ElMessage.error(\"资料更新失败：\" + error.message);\n      }\n    };\n    const viewFavorites = () => router.push({\n      name: \"MyFavorites\"\n    });\n    const logout = () => {\n      store.commit(\"clearUser\");\n      router.push({\n        name: \"Login\"\n      });\n    };\n    const goToHome = () => {\n      router.push(\"/\");\n    };\n    const userInfo = ref({});\n    const posts = ref([]);\n    const newComment = ref(\"\");\n    const loading = ref(false);\n\n    // 获取用户信息\n    const fetchUserInfo = async () => {\n      if (!userId.value) {\n        ElMessage.error(\"用户未登录\");\n        return;\n      }\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/user/profile`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        userInfo.value = response.data;\n      } catch (error) {\n        console.error(\"获取用户信息失败:\", error);\n        if (error.response?.status === 401) {\n          ElMessage.error(\"登录已过期，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"获取用户信息失败\");\n        }\n      }\n    };\n\n    // 获取用户帖子\n    const fetchUserPosts = async () => {\n      if (!userId.value) {\n        return;\n      }\n      try {\n        loading.value = true;\n        const response = await axios.get(`${API_BASE_URL}/api/posts/user/${userId.value}`, {\n          params: {\n            page: 0,\n            size: 10\n          },\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        if (response.data.code === 200 && response.data.data) {\n          posts.value = response.data.data.content.map(post => ({\n            ...post,\n            showCommentInput: false\n          }));\n        } else {\n          posts.value = [];\n        }\n      } catch (error) {\n        console.error(\"获取帖子列表失败:\", error);\n        if (error.response?.status === 401) {\n          ElMessage.error(\"登录已过期，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"获取帖子列表失败\");\n        }\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 提交评论\n    const submitComment = async postId => {\n      if (!newComment.value.trim()) {\n        ElMessage.warning(\"评论内容不能为空\");\n        return;\n      }\n      try {\n        await axios.post(`${API_BASE_URL}/api/posts/${postId}/comments`, newComment.value, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        ElMessage.success(\"评论成功\");\n        newComment.value = \"\";\n        await fetchUserPosts();\n      } catch (error) {\n        console.error(\"评论失败:\", error);\n        if (error.response?.status === 401) {\n          ElMessage.error(\"登录已过期，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"评论失败\");\n        }\n      }\n    };\n\n    // 点赞/取消点赞\n    const toggleLike = async postId => {\n      try {\n        await axios.post(`${API_BASE_URL}/api/posts/${postId}/like`, null, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        await fetchUserPosts();\n      } catch (error) {\n        console.error(\"点赞操作失败:\", error);\n        if (error.response?.status === 401) {\n          ElMessage.error(\"登录已过期，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"操作失败\");\n        }\n      }\n    };\n\n    // 显示评论输入框\n    const showCommentInput = postId => {\n      posts.value = posts.value.map(post => ({\n        ...post,\n        showCommentInput: post.id === postId\n      }));\n    };\n\n    // 格式化日期\n    const formatDate = date => {\n      return new Date(date).toLocaleString();\n    };\n\n    // 发表帖子相关\n    const postDialogVisible = ref(false);\n    const postForm = ref({\n      content: \"\"\n    });\n\n    // 显示发表帖子对话框\n    const showPostDialog = () => {\n      postForm.value.content = \"\";\n      postDialogVisible.value = true;\n    };\n\n    // 提交帖子\n    const submitPost = async () => {\n      if (!postForm.value.content.trim()) {\n        ElMessage.warning(\"帖子内容不能为空\");\n        return;\n      }\n      try {\n        await axios.post(`${API_BASE_URL}/api/posts`, {\n          content: postForm.value.content\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        ElMessage.success(\"帖子发表成功\");\n        postDialogVisible.value = false;\n        await fetchUserPosts();\n      } catch (error) {\n        console.error(\"发表帖子失败:\", error);\n        if (error.response?.status === 401) {\n          ElMessage.error(\"登录已过期，请重新登录\");\n          router.push(\"/login\");\n        } else {\n          ElMessage.error(\"发表帖子失败\");\n        }\n      }\n    };\n    onMounted(() => {\n      fetchUserInfo();\n      fetchUserPosts();\n    });\n    const __returned__ = {\n      store,\n      router,\n      API_BASE_URL,\n      userId,\n      editDialogVisible,\n      editForm,\n      uploadHeaders,\n      beforeAvatarUpload,\n      handleAvatarSuccess,\n      userNickname,\n      userPhone,\n      userAddress,\n      userBalance,\n      userAvatar,\n      showEditDialog,\n      saveProfile,\n      viewFavorites,\n      logout,\n      goToHome,\n      userInfo,\n      posts,\n      newComment,\n      loading,\n      fetchUserInfo,\n      fetchUserPosts,\n      submitComment,\n      toggleLike,\n      showCommentInput,\n      formatDate,\n      postDialogVisible,\n      postForm,\n      showPostDialog,\n      submitPost,\n      computed,\n      ref,\n      onMounted,\n      get useStore() {\n        return useStore;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","useStore","useRouter","ElMessage","axios","API_BASE_URL","store","router","userId","getters","editDialogVisible","editForm","avatar","nickname","phone","address","uploadHeaders","token","localStorage","getItem","Authorization","beforeAvatarUpload","file","isImage","type","startsWith","isLt2M","size","error","handleAvatarSuccess","response","code","value","data","commit","success","message","userNickname","userPhone","userPhoneNumber","userAddress","userBalance","userAvatar","showEditDialog","saveProfile","dispatch","viewFavorites","push","name","logout","goToHome","userInfo","posts","newComment","loading","fetchUserInfo","get","headers","console","status","fetchUserPosts","params","page","content","map","post","showCommentInput","submitComment","postId","trim","warning","toggleLike","id","formatDate","date","Date","toLocaleString","postDialogVisible","postForm","showPostDialog","submitPost"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/user/UserPage.vue"],"sourcesContent":["<template>\n  <div class=\"user-page\">\n    <div class=\"back-home\">\n      <el-button type=\"primary\" @click=\"goToHome\">返回首页</el-button>\n    </div>\n    <h1 class=\"page-title\">用户中心</h1>\n    <p class=\"welcome-message\">欢迎回来，{{ userNickname }}</p>\n\n    <div class=\"user-info card\">\n      <h2>个人信息</h2>\n      <img\n        v-if=\"userAvatar\"\n        :src=\"userAvatar\"\n        alt=\"用户头像\"\n        class=\"user-avatar\"\n      />\n      <ul>\n        <li>昵称：{{ userNickname }}</li>\n        <li>手机：{{ userPhone }}</li>\n        <li>地址：{{ userAddress }}</li>\n        <li>\n          账户余额：¥{{ userBalance.toFixed(2) }}\n          <span class=\"balance-warning\"\n            >（账户余额变更后需要退出账号重新登录才能刷新）</span\n          >\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"user-actions\">\n      <El-button type=\"primary\" @click=\"showEditDialog\" class=\"action-button\"\n        >编辑资料</El-button\n      >\n      <El-button type=\"warning\" @click=\"viewFavorites\" class=\"action-button\"\n        >我的收藏</El-button\n      >\n      <El-button type=\"success\" @click=\"showPostDialog\" class=\"action-button\"\n        >发表帖子</El-button\n      >\n      <El-button type=\"danger\" @click=\"logout\" class=\"action-button\"\n        >注销登录</El-button\n      >\n    </div>\n\n    <!-- 编辑资料对话框 -->\n    <El-dialog\n      v-model=\"editDialogVisible\"\n      title=\"编辑资料\"\n      width=\"500px\"\n      :close-on-click-modal=\"false\"\n    >\n      <El-form :model=\"editForm\" label-width=\"80px\">\n        <El-form-item label=\"头像\">\n          <div class=\"avatar-upload\">\n            <img\n              v-if=\"editForm.avatar\"\n              :src=\"editForm.avatar\"\n              class=\"avatar-preview\"\n              alt=\"用户头像\"\n            />\n            <El-upload\n              class=\"avatar-uploader\"\n              action=\"http://localhost:5000/api/user/upload-avatar\"\n              :show-file-list=\"false\"\n              :on-success=\"handleAvatarSuccess\"\n              :before-upload=\"beforeAvatarUpload\"\n              :headers=\"uploadHeaders\"\n              :with-credentials=\"true\"\n            >\n              <El-button type=\"primary\">上传头像</El-button>\n            </El-upload>\n          </div>\n        </El-form-item>\n\n        <El-form-item label=\"昵称\">\n          <El-input v-model=\"editForm.nickname\" placeholder=\"请输入昵称\" />\n        </El-form-item>\n\n        <El-form-item label=\"手机\">\n          <El-input v-model=\"editForm.phone\" placeholder=\"请输入手机号码\" />\n        </El-form-item>\n\n        <El-form-item label=\"地址\">\n          <El-input v-model=\"editForm.address\" placeholder=\"请输入地址\" />\n        </El-form-item>\n      </El-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <El-button @click=\"editDialogVisible = false\">取消</El-button>\n          <El-button type=\"primary\" @click=\"saveProfile\">保存</El-button>\n        </span>\n      </template>\n    </El-dialog>\n\n    <!-- 发表帖子对话框 -->\n    <El-dialog\n      v-model=\"postDialogVisible\"\n      title=\"发表帖子\"\n      width=\"500px\"\n      :close-on-click-modal=\"false\"\n    >\n      <El-form :model=\"postForm\" label-width=\"80px\">\n        <El-form-item label=\"内容\">\n          <El-input\n            v-model=\"postForm.content\"\n            type=\"textarea\"\n            :rows=\"4\"\n            placeholder=\"写下你想分享的内容...\"\n          />\n        </El-form-item>\n      </El-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <El-button @click=\"postDialogVisible = false\">取消</El-button>\n          <El-button type=\"primary\" @click=\"submitPost\">发表</El-button>\n        </span>\n      </template>\n    </El-dialog>\n\n    <div class=\"user-community card\">\n      <h2>社区互动</h2>\n      <div v-if=\"posts.length === 0\">暂无发布的帖子。</div>\n      <div v-else class=\"post-list\">\n        <div v-for=\"post in posts\" :key=\"post.id\" class=\"post-item\">\n          <div class=\"post-content\">{{ post.content }}</div>\n          <div class=\"post-meta\">\n            <span class=\"post-time\">{{ formatDate(post.createdAt) }}</span>\n            <div class=\"post-actions\">\n              <el-button @click=\"toggleLike(post.id)\" class=\"like-button\">\n                {{ post.likes }} 赞\n              </el-button>\n              <el-button\n                @click=\"showCommentInput(post.id)\"\n                class=\"comment-button\"\n              >\n                评论\n              </el-button>\n            </div>\n          </div>\n          <div class=\"comment-section\" v-if=\"post.showCommentInput\">\n            <el-input\n              v-model=\"newComment\"\n              type=\"textarea\"\n              :rows=\"2\"\n              placeholder=\"写下你的评论...\"\n            />\n            <el-button\n              type=\"primary\"\n              @click=\"submitComment(post.id)\"\n              class=\"submit-comment\"\n            >\n              提交评论\n            </el-button>\n          </div>\n          <div\n            class=\"comments-list\"\n            v-if=\"post.comments && post.comments.length\"\n          >\n            <div\n              v-for=\"comment in post.comments\"\n              :key=\"comment.id\"\n              class=\"comment-item\"\n            >\n              <span class=\"comment-content\">{{ comment.content }}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { computed, ref, onMounted } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport axios from \"axios\";\n\nconst store = useStore();\nconst router = useRouter();\n\n// API基础URL\nconst API_BASE_URL = \"http://localhost:5000\";\n\n// 获取当前用户ID\nconst userId = computed(() => store.getters.userId);\n\n// 编辑对话框相关\nconst editDialogVisible = ref(false);\nconst editForm = ref({\n  avatar: \"\",\n  nickname: \"\",\n  phone: \"\",\n  address: \"\",\n});\n\n// 上传头像相关\nconst uploadHeaders = computed(() => {\n  const token = localStorage.getItem(\"token\");\n  return {\n    Authorization: `Bearer ${token}`,\n  };\n});\n\n// 头像上传前的验证\nconst beforeAvatarUpload = (file) => {\n  const isImage = file.type.startsWith(\"image/\");\n  const isLt2M = file.size / 1024 / 1024 < 2;\n\n  if (!isImage) {\n    ElMessage.error(\"上传头像图片只能是图片格式!\");\n    return false;\n  }\n  if (!isLt2M) {\n    ElMessage.error(\"上传头像图片大小不能超过 2MB!\");\n    return false;\n  }\n  return true;\n};\n\n// 头像上传成功处理\nconst handleAvatarSuccess = (response) => {\n  if (response.code === 200) {\n    editForm.value.avatar = response.data;\n    store.commit(\"setUserAvatar\", response.data);\n    ElMessage.success(\"头像上传成功\");\n  } else {\n    ElMessage.error(\"头像上传失败：\" + response.message);\n  }\n};\n\n// 计算用户信息\nconst userNickname = computed(() => store.getters.userNickname);\nconst userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\nconst userAddress = computed(() => store.getters.userAddress || \"未提供\");\nconst userBalance = computed(() => store.getters.userBalance || 0);\nconst userAvatar = computed(() =>\n  store.getters.userAvatar\n    ? `http://localhost:5000${store.getters.userAvatar}`\n    : \"/assets/avatar.png\",\n);\n\n// 在组件挂载时获取账户余额\nonMounted(async () => {\n  await store.getters.userBalance;\n});\n\n// 显示编辑对话框\nconst showEditDialog = () => {\n  editForm.value = {\n    avatar: userAvatar.value,\n    nickname: userNickname.value,\n    phone: userPhone.value,\n    address: userAddress.value,\n  };\n  editDialogVisible.value = true;\n};\n\n// 保存资料\nconst saveProfile = async () => {\n  try {\n    await store.dispatch(\"updateUserProfile\", {\n      avatar: editForm.value.avatar,\n      nickname: editForm.value.nickname,\n      phone: editForm.value.phone,\n      address: editForm.value.address,\n    });\n    ElMessage.success(\"资料更新成功\");\n    editDialogVisible.value = false;\n  } catch (error) {\n    ElMessage.error(\"资料更新失败：\" + error.message);\n  }\n};\n\nconst viewFavorites = () => router.push({ name: \"MyFavorites\" });\nconst logout = () => {\n  store.commit(\"clearUser\");\n  router.push({ name: \"Login\" });\n};\n\nconst goToHome = () => {\n  router.push(\"/\");\n};\n\nconst userInfo = ref({});\nconst posts = ref([]);\nconst newComment = ref(\"\");\nconst loading = ref(false);\n\n// 获取用户信息\nconst fetchUserInfo = async () => {\n  if (!userId.value) {\n    ElMessage.error(\"用户未登录\");\n    return;\n  }\n\n  try {\n    const response = await axios.get(`${API_BASE_URL}/api/user/profile`, {\n      headers: {\n        Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n      },\n    });\n    userInfo.value = response.data;\n  } catch (error) {\n    console.error(\"获取用户信息失败:\", error);\n    if (error.response?.status === 401) {\n      ElMessage.error(\"登录已过期，请重新登录\");\n      router.push(\"/login\");\n    } else {\n      ElMessage.error(\"获取用户信息失败\");\n    }\n  }\n};\n\n// 获取用户帖子\nconst fetchUserPosts = async () => {\n  if (!userId.value) {\n    return;\n  }\n\n  try {\n    loading.value = true;\n    const response = await axios.get(\n      `${API_BASE_URL}/api/posts/user/${userId.value}`,\n      {\n        params: {\n          page: 0,\n          size: 10,\n        },\n        headers: {\n          Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n        },\n      },\n    );\n    if (response.data.code === 200 && response.data.data) {\n      posts.value = response.data.data.content.map((post) => ({\n        ...post,\n        showCommentInput: false,\n      }));\n    } else {\n      posts.value = [];\n    }\n  } catch (error) {\n    console.error(\"获取帖子列表失败:\", error);\n    if (error.response?.status === 401) {\n      ElMessage.error(\"登录已过期，请重新登录\");\n      router.push(\"/login\");\n    } else {\n      ElMessage.error(\"获取帖子列表失败\");\n    }\n  } finally {\n    loading.value = false;\n  }\n};\n\n// 提交评论\nconst submitComment = async (postId) => {\n  if (!newComment.value.trim()) {\n    ElMessage.warning(\"评论内容不能为空\");\n    return;\n  }\n\n  try {\n    await axios.post(\n      `${API_BASE_URL}/api/posts/${postId}/comments`,\n      newComment.value,\n      {\n        headers: {\n          Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n        },\n      },\n    );\n    ElMessage.success(\"评论成功\");\n    newComment.value = \"\";\n    await fetchUserPosts();\n  } catch (error) {\n    console.error(\"评论失败:\", error);\n    if (error.response?.status === 401) {\n      ElMessage.error(\"登录已过期，请重新登录\");\n      router.push(\"/login\");\n    } else {\n      ElMessage.error(\"评论失败\");\n    }\n  }\n};\n\n// 点赞/取消点赞\nconst toggleLike = async (postId) => {\n  try {\n    await axios.post(`${API_BASE_URL}/api/posts/${postId}/like`, null, {\n      headers: {\n        Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n      },\n    });\n    await fetchUserPosts();\n  } catch (error) {\n    console.error(\"点赞操作失败:\", error);\n    if (error.response?.status === 401) {\n      ElMessage.error(\"登录已过期，请重新登录\");\n      router.push(\"/login\");\n    } else {\n      ElMessage.error(\"操作失败\");\n    }\n  }\n};\n\n// 显示评论输入框\nconst showCommentInput = (postId) => {\n  posts.value = posts.value.map((post) => ({\n    ...post,\n    showCommentInput: post.id === postId,\n  }));\n};\n\n// 格式化日期\nconst formatDate = (date) => {\n  return new Date(date).toLocaleString();\n};\n\n// 发表帖子相关\nconst postDialogVisible = ref(false);\nconst postForm = ref({\n  content: \"\",\n});\n\n// 显示发表帖子对话框\nconst showPostDialog = () => {\n  postForm.value.content = \"\";\n  postDialogVisible.value = true;\n};\n\n// 提交帖子\nconst submitPost = async () => {\n  if (!postForm.value.content.trim()) {\n    ElMessage.warning(\"帖子内容不能为空\");\n    return;\n  }\n\n  try {\n