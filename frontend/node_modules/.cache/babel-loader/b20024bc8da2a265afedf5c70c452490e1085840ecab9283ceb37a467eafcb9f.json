{"ast":null,"code":"import { ref, onMounted } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ElButton } from \"element-plus\";\nexport default {\n  __name: 'ProductPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const product = ref({\n      name: \"\",\n      price: 0,\n      imageUrl: \"\",\n      description: \"\",\n      stock: 0\n    });\n    const optionsVisible = ref(false); // 控制购买选项的显示状态\n\n    // 获取商品详细信息\n    onMounted(async () => {\n      const productId = route.params.id;\n      console.log(`请求商品 ID: ${productId}`);\n      const response = await fetch(`http://localhost:5000/api/products/${productId}`);\n      if (response.ok) {\n        const productData = await response.json();\n        product.value = productData.data;\n        product.value.price = parseFloat(product.value.price) || 0;\n      } else {\n        console.error(\"获取商品详情失败，状态码:\", response.status);\n      }\n    });\n\n    // 加入购物车\n    const addToCart = () => {\n      alert(`${product.value.name} 已加入购物车！`);\n    };\n\n    // 显示购买选项\n    const showPurchaseOptions = () => {\n      optionsVisible.value = true; // 显示购买选项\n    };\n\n    // 拼团购买\n    const purchaseAsGroup = () => {\n      alert(\"选择拼团购买功能！\");\n    };\n\n    // 单独购买\n    const purchaseSeparately = () => {\n      alert(\"选择单独购买功能！\");\n    };\n    const __returned__ = {\n      route,\n      product,\n      optionsVisible,\n      addToCart,\n      showPurchaseOptions,\n      purchaseAsGroup,\n      purchaseSeparately,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get ElButton() {\n        return ElButton;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","ElButton","route","product","name","price","imageUrl","description","stock","optionsVisible","productId","params","id","console","log","response","fetch","ok","productData","json","value","data","parseFloat","error","status","addToCart","alert","showPurchaseOptions","purchaseAsGroup","purchaseSeparately"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/product/ProductPage.vue"],"sourcesContent":["<template>\n  <div class=\"product-page\">\n    <div class=\"product-container\">\n      <div class=\"product-header\">\n        <h1>{{ product.name }}</h1>\n        <p class=\"price\">价格: ¥{{ product.price }}</p>\n      </div>\n\n      <div class=\"product-content\">\n        <img :src=\"product.imageUrl\" alt=\"商品图片\" class=\"product-image\" />\n\n        <div class=\"product-details\">\n          <p class=\"description\">{{ product.description }}</p>\n          <p class=\"stock\">库存: {{ product.stock }}件</p>\n\n          <div class=\"action-buttons\">\n            <ElButton type=\"primary\" @click=\"addToCart\">加入购物车</ElButton>\n            <ElButton type=\"danger\" @click=\"showPurchaseOptions\">立即购买</ElButton>\n          </div>\n\n          <!-- 新增的购买方式选项 -->\n          <div v-if=\"optionsVisible\" class=\"purchase-options\">\n            <p>请选择购买方式：</p>\n            <ElButton type=\"success\" @click=\"purchaseAsGroup\">拼团购买</ElButton>\n            <ElButton type=\"warning\" @click=\"purchaseSeparately\">单独购买</ElButton>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ElButton } from \"element-plus\";\n\nconst route = useRoute();\n\nconst product = ref({\n  name: \"\",\n  price: 0,\n  imageUrl: \"\",\n  description: \"\",\n  stock: 0,\n});\nconst optionsVisible = ref(false); // 控制购买选项的显示状态\n\n// 获取商品详细信息\nonMounted(async () => {\n  const productId = route.params.id;\n  console.log(`请求商品 ID: ${productId}`);\n  const response = await fetch(`http://localhost:5000/api/products/${productId}`);\n\n  if (response.ok) {\n    const productData = await response.json();\n    product.value = productData.data;\n    product.value.price = parseFloat(product.value.price) || 0;\n  } else {\n    console.error(\"获取商品详情失败，状态码:\", response.status);\n  }\n});\n\n// 加入购物车\nconst addToCart = () => {\n  alert(`${product.value.name} 已加入购物车！`);\n};\n\n// 显示购买选项\nconst showPurchaseOptions = () => {\n  optionsVisible.value = true; // 显示购买选项\n};\n\n// 拼团购买\nconst purchaseAsGroup = () => {\n  alert(\"选择拼团购买功能！\");\n};\n\n// 单独购买\nconst purchaseSeparately = () => {\n  alert(\"选择单独购买功能！\");\n};\n</script>\n\n<style scoped>\n.product-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  text-align: left;\n}\n\n.product-container {\n  display: flex;\n  flex-direction: column;\n}\n\n.product-header {\n  margin-bottom: 20px;\n}\n\n.price {\n  font-size: 24px;\n  color: #f65a8b;\n}\n\n.product-content {\n  display: flex;\n  align-items: flex-start;\n}\n\n.product-image {\n  max-width: 400px;\n  height: auto;\n  border-radius: 8px;\n  margin-right: 20px;\n}\n\n.product-details {\n  flex-grow: 1;\n}\n\n.description {\n  font-size: 20px;\n  line-height: 1.5;\n  margin-bottom: 10px;\n}\n\n.stock {\n  font-size: 16px;\n  margin-bottom: 20px;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 10px;\n}\n\n.purchase-options {\n  margin-top: 20px;\n  display: flex;\n  flex-direction: column; /* 垂直排列按钮 */\n  gap: 10px; /* 按钮间距 */\n}\n</style>"],"mappings":"AAiCA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,QAAQ,QAAQ,YAAY;AACrC,SAASC,QAAQ,QAAQ,cAAc;;;;;;;IAEvC,MAAMC,KAAK,GAAGF,QAAQ,CAAC,CAAC;IAExB,MAAMG,OAAO,GAAGL,GAAG,CAAC;MAClBM,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,CAAC;MACRC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,KAAK,EAAE;IACT,CAAC,CAAC;IACF,MAAMC,cAAc,GAAGX,GAAG,CAAC,KAAK,CAAC,CAAC,CAAC;;IAEnC;IACAC,SAAS,CAAC,YAAY;MACpB,MAAMW,SAAS,GAAGR,KAAK,CAACS,MAAM,CAACC,EAAE;MACjCC,OAAO,CAACC,GAAG,CAAC,YAAYJ,SAAS,EAAE,CAAC;MACpC,MAAMK,QAAQ,GAAG,MAAMC,KAAK,CAAC,sCAAsCN,SAAS,EAAE,CAAC;MAE/E,IAAIK,Q