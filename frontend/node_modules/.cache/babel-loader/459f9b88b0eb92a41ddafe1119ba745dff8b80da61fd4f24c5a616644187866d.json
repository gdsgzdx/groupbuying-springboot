{"ast":null,"code":"import axios from \"axios\"; // 导入 axios\nimport { ref, computed } from \"vue\";\nimport { ElCarousel, ElCarouselItem, ElSelect, ElOption, ElButton, ElRow, ElCol, ElCard, ElPagination, ElMenu, ElMenuItem } from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter(); // 获取路由对象\n    const store = useStore(); // 获取 Vuex store\n    const userName = ref(\"\"); // 用户昵称\n    const searchQuery = ref(\"\"); // 搜索查询\n\n    const ads = ref([{\n      image: require(\"@/assets/ad3.png\")\n    },\n    // 只保留第三个广告作为轮播内容\n    {\n      image: require(\"@/assets/ad6.png\")\n    },\n    // 额外的广告图像\n    {\n      image: require(\"@/assets/ad7.png\")\n    } // 额外的广告图像\n    ]);\n\n    // 获取用户信息的方法\n    const fetchUserData = () => {\n      const nickname = store.getters.userNickname; // 从 Vuex 获取昵称\n      userName.value = nickname; // 设置用户昵称\n    };\n    const products = ref([{\n      id: 1,\n      title: \"苹果 iPhone 16 Pro\",\n      price: 8999.0,\n      image: require(\"@/assets/苹果手机.png\")\n    }, {\n      id: 2,\n      title: \"哈密瓜\",\n      price: 5299.0,\n      image: require(\"@/assets/哈密瓜.png\")\n    }, {\n      id: 3,\n      title: \"华为 Mate 40 Pro\",\n      price: 7999.0,\n      image: require(\"@/assets/笔记本电脑.png\")\n    }]);\n\n    // 状态管理\n    const selectedCategory = ref(\"\");\n    const selectedSort = ref(\"\");\n    const currentPage = ref(1);\n    const pageSize = ref(8);\n\n    // 计算属性\n    const filteredProducts = computed(() => {\n      let filtered = products.value;\n\n      // 搜索过滤\n      if (searchQuery.value) {\n        filtered = filtered.filter(product => product.title.includes(searchQuery.value));\n      }\n\n      // 分类过滤\n      if (selectedCategory.value) {\n        filtered = filtered.filter(product => product.category === selectedCategory.value);\n      }\n\n      // 排序\n      if (selectedSort.value === \"low-to-high\") {\n        filtered.sort((a, b) => a.price - b.price);\n      } else if (selectedSort.value === \"high-to-low\") {\n        filtered.sort((a, b) => b.price - a.price);\n      }\n\n      // 分页\n      const start = (currentPage.value - 1) * pageSize.value;\n      return filtered.slice(start, start + pageSize.value);\n    });\n\n    // 应用过滤\n    const applyFilters = () => {\n      currentPage.value = 1; // 重置为第一页\n    };\n\n    // 跳转到首页并刷新\n    const goHome = () => {\n      // 如果使用 Vue Router 的 replace 可以用以下方式控制历史记录\n      // router.replace('/'); // 这样不会在历史记录中留下当前页面\n      window.location.reload(); // 强制刷新页面\n    };\n\n    // 跳转到商品详情\n    const viewProductDetails = product => {\n      // 假设商品详情路由是 `/product/:id`\n      router.push(`/ProductPage/${product.id}`);\n    };\n\n    // 处理分页\n    const handlePageChange = page => {\n      currentPage.value = page;\n    };\n\n    // 选择分类\n    const selectCategory = category => {\n      selectedCategory.value = category; // 设置选中的分类\n    };\n\n    // 在组件挂载时调用 fetchUserData 方法\n    onMounted(() => {\n      fetchUserData();\n    });\n    const __returned__ = {\n      router,\n      store,\n      userName,\n      searchQuery,\n      ads,\n      fetchUserData,\n      products,\n      selectedCategory,\n      selectedSort,\n      currentPage,\n      pageSize,\n      filteredProducts,\n      applyFilters,\n      goHome,\n      viewProductDetails,\n      handlePageChange,\n      selectCategory,\n      get axios() {\n        return axios;\n      },\n      ref,\n      computed,\n      get ElCarousel() {\n        return ElCarousel;\n      },\n      get ElCarouselItem() {\n        return ElCarouselItem;\n      },\n      get ElSelect() {\n        return ElSelect;\n      },\n      get ElOption() {\n        return ElOption;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElRow() {\n        return ElRow;\n      },\n      get ElCol() {\n        return ElCol;\n      },\n      get ElCard() {\n        return ElCard;\n      },\n      get ElPagination() {\n        return ElPagination;\n      },\n      get ElMenu() {\n        return ElMenu;\n      },\n      get ElMenuItem() {\n        return ElMenuItem;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["axios","ref","computed","ElCarousel","ElCarouselItem","ElSelect","ElOption","ElButton","ElRow","ElCol","ElCard","ElPagination","ElMenu","ElMenuItem","useRouter","useStore","router","store","userName","searchQuery","ads","image","require","fetchUserData","nickname","getters","userNickname","value","products","id","title","price","selectedCategory","selectedSort","currentPage","pageSize","filteredProducts","filtered","filter","product","includes","category","sort","a","b","start","slice","applyFilters","goHome","window","location","reload","viewProductDetails","push","handlePageChange","page","selectCategory","onMounted"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<!--src/views/home/HomePage -->\n<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <!-- Logo -->\n        <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <!-- 首页按钮 -->\n        <El-button class=\"home-button\" @click=\"goHome\">首页</El-button>\n        <!-- 用户功能 -->\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userName }}</span>\n          <span class=\"user-action\">购物车</span>\n          <span class=\"user-action\">我的订单</span>\n          <span class=\"user-action\">店铺关注</span>\n          <span class=\"user-action\">浏览记录</span>\n          <input\n            v-model=\"searchQuery\"\n            type=\"text\"\n            class=\"search-input\"\n            placeholder=\"搜索商品\"\n          />\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <!-- 商品分类 -->\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"1\" class=\"category-menu\">\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\"\n            >家用电器</El-menu-item\n          >\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机/通讯/数码')\"\n            >手机/通讯/数码</El-menu-item\n          >\n          <El-menu-item index=\"3\" @click=\"selectCategory('电脑/办公/文具用品')\"\n            >电脑/办公/文具用品</El-menu-item\n          >\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具/家居/厨房')\"\n            >家具/家居/厨房</El-menu-item\n          >\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装/女装/童装/内衣')\"\n            >男装/女装/童装/内衣</El-menu-item\n          >\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆/个护清洁')\"\n            >美妆/个护清洁</El-menu-item\n          >\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋/箱包/珠宝')\"\n            >女鞋/箱包/珠宝</El-menu-item\n          >\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋/运动/户外')\"\n            >男鞋/运动/户外</El-menu-item\n          >\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品/酒类/生鲜')\"\n            >食品/酒类/生鲜</El-menu-item\n          >\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术/礼品花/园艺')\"\n            >艺术/礼品花/园艺</El-menu-item\n          >\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书/文娱/教育')\"\n            >图书/文娱/教育</El-menu-item\n          >\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票/酒店/旅游')\"\n            >机票/酒店/旅游</El-menu-item\n          >\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付/保险/金融')\"\n            >支付/保险/金融</El-menu-item\n          >\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具/乐器')\"\n            >玩具/乐器</El-menu-item\n          >\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <!-- 广告栏 -->\n        <section class=\"ad-banner\">\n          <div class=\"static-ads\">\n            <img src=\"@/assets/ad1.png\" alt=\"广告1\" class=\"ad-image\" />\n            <img src=\"@/assets/ad2.png\" alt=\"广告2\" class=\"ad-image\" />\n          </div>\n          <!-- 第三广告为轮播 -->\n          <El-carousel\n            class=\"carousel\"\n            :autoplay=\"true\"\n            interval=\"5000\"\n            arrow=\"always\"\n          >\n            <El-carousel-item v-for=\"ad in ads\" :key=\"ad.image\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </El-carousel-item>\n          </El-carousel>\n        </section>\n\n        <section class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n          </El-select>\n          <El-button type=\"primary\" @click=\"applyFilters\">应用</El-button>\n        </section>\n\n        <!-- 商品展示 -->\n        <section class=\"products\">\n          <h2 class=\"section-title\">热卖商品</h2>\n          <El-row :gutter=\"20\">\n            <El-col\n              v-for=\"product in filteredProducts\"\n              :key=\"product.id\"\n              :span=\"6\"\n            >\n              <El-card :body-style=\"{ padding: '10px' }\" class=\"product-card\">\n                <img :src=\"product.image\" class=\"product-image\" alt=\"\" />\n                <div class=\"product-info\">\n                  <h3>{{ product.title }}</h3>\n                  <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                  <!-- 修改按钮 -->\n                  <El-button type=\"primary\" @click=\"viewProductDetails(product)\"\n                    >查看商品详情</El-button\n                  >\n                </div>\n              </El-card>\n            </El-col>\n          </El-row>\n          <!-- 分页 -->\n          <El-pagination\n            :current-page=\"currentPage\"\n            :page-size=\"pageSize\"\n            :total=\"filteredProducts.length\"\n            @current-change=\"handlePageChange\"\n          />\n        </section>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport axios from \"axios\"; // 导入 axios\nimport { ref, computed } from \"vue\";\nimport {\n  ElCarousel,\n  ElCarouselItem,\n  ElSelect,\n  ElOption,\n  ElButton,\n  ElRow,\n  ElCol,\n  ElCard,\n  ElPagination,\n  ElMenu,\n  ElMenuItem,\n} from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\nconst router = useRouter(); // 获取路由对象\nconst store = useStore(); // 获取 Vuex store\nconst userName = ref(\"\"); // 用户昵称\nconst searchQuery = ref(\"\"); // 搜索查询\n\nconst ads = ref([\n  { image: require(\"@/assets/ad3.png\") }, // 只保留第三个广告作为轮播内容\n  { image: require(\"@/assets/ad6.png\") }, // 额外的广告图像\n  { image: require(\"@/assets/ad7.png\") }, // 额外的广告图像\n]);\n\n// 获取用户信息的方法\nconst fetchUserData = () => {\n  const nickname = store.getters.userNickname; // 从 Vuex 获取昵称\n  userName.value = nickname; // 设置用户昵称\n};\n\nconst products = ref([\n  {\n    id: 1,\n    title: \"苹果 iPhone 16 Pro\",\n    price: 8999.0,\n    image: require(\"@/assets/苹果手机.png\"),\n  },\n  {\n    id: 2,\n    title: \"哈密瓜\",\n    price: 5299.0,\n    image: require(\"@/assets/哈密瓜.png\"),\n  },\n  {\n    id: 3,\n    title: \"华为 Mate 40 Pro\",\n    price: 7999.0,\n    image: require(\"@/assets/笔记本电脑.png\"),\n  },\n]);\n\n// 状态管理\nconst selectedCategory = ref(\"\");\nconst selectedSort = ref(\"\");\nconst currentPage = ref(1);\nconst pageSize = ref(8);\n\n// 计算属性\nconst filteredProducts = computed(() => {\n  let filtered = products.value;\n\n  // 搜索过滤\n  if (searchQuery.value) {\n    filtered = filtered.filter((product) =>\n      product.title.includes(searchQuery.value),\n    );\n  }\n\n  // 分类过滤\n  if (selectedCategory.value) {\n    filtered = filtered.filter(\n      (product) => product.category === selectedCategory.value,\n    );\n  }\n\n  // 排序\n  if (selectedSort.value === \"low-to-high\") {\n    filtered.sort((a, b) => a.price - b.price);\n  } else if (selectedSort.value === \"high-to-low\") {\n    filtered.sort((a, b) => b.price - a.price);\n  }\n\n  // 分页\n  const start = (currentPage.value - 1) * pageSize.value;\n  return filtered.slice(start, start + pageSize.value);\n});\n\n// 应用过滤\nconst applyFilters = () => {\n  currentPage.value = 1; // 重置为第一页\n};\n\n// 跳转到首页并刷新\nconst goHome = () => {\n  // 如果使用 Vue Router 的 replace 可以用以下方式控制历史记录\n  // router.replace('/'); // 这样不会在历史记录中留下当前页面\n  window.location.reload(); // 强制刷新页面\n};\n\n// 跳转到商品详情\nconst viewProductDetails = (product) => {\n  // 假设商品详情路由是 `/product/:id`\n  router.push(`/ProductPage/${product.id}`);\n};\n\n// 处理分页\nconst handlePageChange = (page) => {\n  currentPage.value = page;\n};\n\n// 选择分类\nconst selectCategory = (category) => {\n  selectedCategory.value = category; // 设置选中的分类\n};\n\n// 在组件挂载时调用 fetchUserData 方法\nonMounted(() => {\n  fetchUserData();\n});\n\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .home-button {\n        margin-right: 20px; /*为首页按钮添加右边距*/\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n\n        .search-input {\n          padding: 8px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 200px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4;\n  }\n\n  .category-menu {\n    padding: 10px;\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .ad-banner {\n      display: flex;\n      align-items: center; /* 此时保持广告栏对齐 */\n      margin-bottom: 20px;\n\n      .static-ads {\n        display: flex; /* 使用 flexbox 使广告在同一行 */\n        flex: 1; /* 调整两侧静态广告的宽度 */\n        justify-content: space-between; /* 在广告之间留出间距 */\n        margin-right: 20px; /* 右侧留出间距 */\n      }\n\n      .ad-image {\n        height: 500px; /* 设置每个静态广告的高度 */\n        flex: 1; /* 每个广告等分宽度 */\n        object-fit: cover; /* 保持比例 */\n        margin: 0 10px; /* 设置广告之间的间隙 */\n      }\n\n      .carousel {\n        height: 500px; /* 高度设置为 500px 以对齐 */\n        flex: 2; /* 确保轮播占用更多空间 */\n        position: relative; /* 为了确保图片可以覆盖整个区域 */\n\n        .el-carousel__item {\n          height: 500px; /* 确保每个轮播项的高度为 500px */\n        }\n\n        .ad-image {\n          width: 100%; /* 确保图片宽度100% */\n          height: 100%; /* 确保图片高度为100% */\n          object-fit: cover; /* 确保图片填充，同时保持比例 */\n        }\n      }\n    }\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px;\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n\n      .product-image {\n        width: 100%;\n        height: auto;\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 5px;\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AA6IA,OAAOA,KAAK,MAAM,OAAO,CAAC,CAAC;AAC3B,SAASC,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SACEC,UAAU,EACVC,cAAc,EACdC,QAAQ,EACRC,QAAQ,EACRC,QAAQ,EACRC,KAAK,EACLC,KAAK,EACLC,MAAM,EACNC,YAAY,EACZC,MAAM,EACNC,UAAU,QACL,cAAc;AACrB,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;;;;;;;;IACjC,MAAMC,MAAM,GAAGF,SAAS,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMG,KAAK,GAAGF,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMG,QAAQ,GAAGjB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC1B,MAAMkB,WAAW,GAAGlB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE7B,MAAMmB,GAAG,GAAGnB,GAAG,CAAC,CACd;MAAEoB,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC;IAAE;IACxC;MAAED,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC;IAAE;IACxC;MAAED,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC,CAAE;IAAA,CACzC,CAAC;;IAEF;IACA,MAAMC,aAAa,GAAGA,CAAA,KAAM;MAC1B,MAAMC,QAAQ,GAAGP,KAAK,CAACQ,OAAO,CAACC,YAAY,CAAC,CAAC;MAC7CR,QAAQ,CAACS,KAAK,GAAGH,QAAQ,CAAC,CAAC;IAC7B,CAAC;IAED,MAAMI,QAAQ,GAAG3B,GAAG,CAAC,CACnB;MACE4B,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,kBAAkB;MACzBC,KAAK,EAAE,MAAM;MACbV,KAAK,EAAEC,OAAO,CAAC,mBAAmB;IACpC,CAAC,EACD;MACEO,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,MAAM;MACbV,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IACnC,CAAC,EACD;MACEO,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,gBAAgB;MACvBC,KAAK,EAAE,MAAM;MACbV,KAAK,EAAEC,OAAO,CAAC,oBAAoB;IACrC,CAAC,CACF,CAAC;;IAEF;IACA,MAAMU,gBAAgB,GAAG/B,GAAG,CAAC,EAAE,CAAC;IAChC,MAAMgC,YAAY,GAAGhC,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMiC,WAAW,GAAGjC,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMkC,QAAQ,GAAGlC,GAAG,CAAC,CAAC,CAAC;;IAEvB;IACA,MAAMmC,gBAAgB,GAAGlC,QAAQ,CAAC,MAAM;MACtC,IAAImC,QAAQ,GAAGT,QAAQ,CAACD,KAAK;;MAE7B;MACA,IAAIR,WAAW,CAACQ,KAAK,EAAE;QACrBU,QAAQ,GAAGA,QAAQ,C