{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\n\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\n    const cartItems = ref([]); // 初始化购物车项\n\n    // 总计计算\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n        const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n        return total + price * quantity;\n      }, 0);\n    });\n\n    // 获取购物车数据的函数\n    const fetchCartItems = async () => {\n      try {\n        const response = await axios.get(`http://localhost:5000/api/cart/${userId}`);\n\n        // 检查 `success` 字段并获取 `data`\n        if (response.data.success && Array.isArray(response.data.data)) {\n          cartItems.value = response.data.data; // 只赋值有效的数组\n        } else {\n          console.error(\"返回的数据不是一个有效的数组:\", response.data);\n          cartItems.value = []; // 或其他处理\n        }\n      } catch (error) {\n        console.error(\"获取购物车数据失败:\", error);\n      }\n    };\n\n    // 组件加载时获取数据\n    onMounted(() => {\n      fetchCartItems();\n    });\n    const updateQuantity = item => {\n      console.log(\"商品数量更新: \", item);\n      // TODO: 这里可以添加更新数量的逻辑，比如同步到后端\n    };\n    const removeItem = itemId => {\n      const index = cartItems.value.findIndex(item => item.id === itemId);\n      if (index !== -1) {\n        cartItems.value.splice(index, 1); // 从购物车中删除商品\n      }\n    };\n    const checkout = () => {\n      console.log(\"去结算\", cartItems.value);\n      // TODO: 添加结算逻辑\n    };\n    const __returned__ = {\n      userId,\n      cartItems,\n      totalPrice,\n      fetchCartItems,\n      updateQuantity,\n      removeItem,\n      checkout,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","userId","localStorage","getItem","cartItems","totalPrice","value","reduce","total","item","price","parseFloat","cartProduct","quantity","parseInt","fetchCartItems","response","get","data","success","Array","isArray","console","error","updateQuantity","log","removeItem","itemId","index","findIndex","id","splice","checkout"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"120\">\n        <template #default=\"scope\">\n          <img\n              :src=\"scope.row.cartProduct.imageUrl\"\n              alt=\"商品图片\"\n              class=\"cart-image\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\">\n        <template #default=\"scope\">\n          <span class=\"product-name\">{{ scope.row.cartProduct.name }}</span>\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\">\n        <template #default=\"scope\">\n          <span class=\"product-price\">¥{{ parseFloat(scope.row.cartProduct.price).toFixed(2) }}</span>\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"100\">\n        <template #default=\"scope\">\n          <El-input-number\n              v-model=\"scope.row.quantity\"\n              @change=\"updateQuantity(scope.row)\"\n              :min=\"1\"\n              :max=\"scope.row.cartProduct.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.id)\">删除</El-button>\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>总计: <span class=\"total-price\">¥{{ totalPrice.toFixed(2) }}</span></h2>\n      <El-button class=\"checkout-button\" type=\"primary\" @click=\"checkout\">去结算</El-button>\n    </div>\n\n    <p v-if=\"!cartItems.length\" class=\"empty-cart\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\n\nconst userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\nconst cartItems = ref([]); // 初始化购物车项\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n    const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n    return total + price * quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const response = await axios.get(\n        `http://localhost:5000/api/cart/${userId}`,\n    );\n\n    // 检查 `success` 字段并获取 `data`\n    if (response.data.success && Array.isArray(response.data.data)) {\n      cartItems.value = response.data.data; // 只赋值有效的数组\n    } else {\n      console.error(\"返回的数据不是一个有效的数组:\", response.data);\n      cartItems.value = []; // 或其他处理\n    }\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\nconst updateQuantity = (item) => {\n  console.log(\"商品数量更新: \", item);\n  // TODO: 这里可以添加更新数量的逻辑，比如同步到后端\n};\n\nconst removeItem = (itemId) => {\n  const index = cartItems.value.findIndex((item) => item.id === itemId);\n  if (index !== -1) {\n    cartItems.value.splice(index, 1); // 从购物车中删除商品\n  }\n};\n\nconst checkout = () => {\n  console.log(\"去结算\", cartItems.value);\n  // TODO: 添加结算逻辑\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  background: #f9f9f9; /* 背景颜色 */\n  border-radius: 10px; /* 圆角 */\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  padding: 10px 20px;\n  background: #ffffff; /* 总计背景 */\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.product-name {\n  font-weight: bold;\n  color: #333; /* 商品名称颜色 */\n}\n\n.product-price {\n  color: #e94e77; /* 价格颜色 */\n  font-weight: bold; /* 加粗 */\n}\n\n.total-price {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n\n.checkout-button {\n  padding: 10px 20px; /* 按钮内边距 */\n  font-size: 16px; /* 按钮字体大小 */\n}\n\n.empty-cart {\n  text-align: center;\n  color: #999; /* 空购物车提示颜色 */\n  font-style: italic; /* 斜体 */\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n}\n</style>"],"mappings":"AAkDA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;;;;;;;;IAE3B,MAAMC,MAAM,GAAGC,YAAY,CAACC,OAAO,CAAC,QAAQ,CAAC,CAAC,CAAC;IAC/C,MAAMC,SAAS,GAAGP,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE3B;IACA,MAAMQ,UAAU,GAAGP,QAAQ,CAAC,MAAM;MAChC,OAAOM,SAAS,CAACE,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,MAAMC,KAAK,GAAGC,UAAU,CAACF,IAAI,CAACG,WAAW,CAACF,KAAK,CAAC,IAAI,CAAC,CAAC,CAAC;QACvD,MAAMG,QAAQ,GAAGC,QAAQ,CAACL,IAAI,CAACI,QAAQ,CAAC,IAAI,CAAC,CAAC,CAAC;QAC/C,OAAOL,KAAK,GAAGE,KAAK,GAAGG,QAAQ;MACjC,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;;IAEF;IACA,MAAME,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMhB,KAAK,CAACiB,GAAG,CAC5B,kCAAkChB,MAAM,EAC5C,CAAC;;QAED;QACA,IAAIe,QAAQ,CAACE,IAAI,CAACC,OAAO,IAAIC,KAAK,CAACC,OAAO,CAACL,QAAQ,CAACE,IAAI,CAACA,IAAI,CAAC,EAAE;UAC9Dd,SAAS,CAACE,KAAK,GAAGU,QAAQ,CAACE,IAAI,CAACA,IAAI,CAAC,CAAC;QACxC,CAAC,MAAM;UACLI,OAAO,CAACC,KAAK,CAAC,iBAAiB,EAAEP,QAAQ,CAACE,IAAI,CAAC;UAC/Cd,SAAS,CAACE,KAAK,GAAG,EAAE,CAAC,CAAC;QACxB;MACF,CAAC,CAAC,OAAOiB,KAAK,EAAE;QACdD,OAAO,CAACC,KAAK,CAAC,YAAY,EAAEA,KAAK,CAAC;MACpC;IACF,CAAC;;IAED;IACAxB,SAAS,CAAC,MAAM;MACdgB,cAAc,CAAC,CAAC;IAClB,CAAC,CAAC;IAEF,MAAMS,cAAc,GAAIf,IAAI,IAAK;MAC/Ba,OAAO,CAACG,GAAG,CAAC,UAAU,EAAEhB,IAAI,CAAC;MAC7B;IACF,CAAC;IAED,MAAMiB,UAAU,GAAIC,MAAM,IAAK;MAC7B,MAAMC,KAAK,GAAGxB,SAAS,CAACE,KAAK,CAACuB,SAAS,CAAEpB,IAAI,IAAKA,IAAI,CAACqB,EAAE,KAAKH,MAAM,CAAC;MACrE,IAAIC,KAAK,KAAK,CAAC,CAAC,EAAE;QAChBxB,SAAS,CAACE,KAAK,CAACyB,MAAM,CAACH,KAAK,EAAE,CAAC,CAAC,CAAC,CAAC;MACpC;IACF,CAAC;IAED,MAAMI,QAAQ,GAAGA,CAAA,KAAM;MACrBV,OAAO,CAACG,GAAG,CAAC,KAAK,EAAErB,SAAS,CAACE,KAAK,CAAC;MACnC;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}