{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { useRouter } from \"vue-router\"; // 导入 vue-router\nimport { ElMessage } from \"element-plus\"; // 导入提示消息组件\n\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\n    const cartItems = ref([]); // 初始化购物车项\n\n    // 获取路由实例\n    const router = useRouter();\n\n    // 总计计算\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n        const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n        return total + price * quantity;\n      }, 0);\n    });\n\n    // 获取购物车数据的函数\n    const fetchCartItems = async () => {\n      try {\n        const response = await axios.get(`http://www.groupbuyingsystem.site/api/cart/${userId}`);\n\n        // 确保成功获取，并获取数据\n        if (response.data.success && Array.isArray(response.data.data)) {\n          cartItems.value = response.data.data; // 将数据赋值给购物车项\n        } else {\n          cartItems.value = []; // 赋值为空数组\n        }\n      } catch (error) {\n        console.error(\"获取购物车数据失败:\", error);\n      }\n    };\n\n    // 组件加载时获取数据\n    onMounted(() => {\n      fetchCartItems();\n    });\n\n    // 更新商品数量\n    const updateQuantity = async item => {\n      console.log(\"当前 userId:\", userId); // 添加这行代码以调试\n      console.log(\"商品数量更新: \", item);\n      try {\n        const response = await axios.put(`http://www.groupbuyingsystem.site/api/cart/${userId}/${item.cartProduct.id}`,\n        // 使用路径参数\n        {\n          quantity: item.quantity // 提交的新数量\n        });\n        if (response.data.success) {\n          console.log(\"数量更新成功\");\n        } else {\n          console.error(\"数量更新失败:\", response.data.message);\n        }\n      } catch (error) {\n        console.error(\"更新数量失败:\", error);\n      }\n    };\n\n    // 删除商品\n    const removeItem = async productId => {\n      console.log(\"删除按钮被点击，商品 ID:\", productId); // 确认传递的商品 ID\n      console.log(\"当前购物车商品:\", cartItems.value); // 打印当前购物车商品\n\n      // 查找当前商品的索引，将 productId 与 cartItems 中的 product_id 进行比较\n      const index = cartItems.value.findIndex(item => item.product_id === Number(productId) // 使用 product_id 查找\n      );\n      console.log(\"index值:\", index); // 打印找到的索引值\n\n      if (index !== -1) {\n        try {\n          const response = await axios.delete(\"http://www.groupbuyingsystem.site/api/cart\", {\n            data: {\n              userId: localStorage.getItem(\"userId\"),\n              productId: productId // 传递 productId 作为删除商品的依据\n            }\n          });\n          if (response.data.success) {\n            cartItems.value.splice(index, 1); // 从购物车中删除商品\n            ElMessage({\n              message: \"商品删除成功！\",\n              // 提示内容\n              type: \"success\",\n              // 提示类型\n              duration: 3000 // 持续时间，单位毫秒\n            });\n          } else {\n            console.error(\"商品删除失败:\", response.data.message);\n          }\n        } catch (error) {\n          console.error(\"删除商品失败:\", error);\n        }\n      } else {\n        console.error(\"未找到商品，无法删除\");\n      }\n    };\n\n    // 返回首页功能\n    const goHome = () => {\n      router.push(\"/home\"); // 导航到首页\n    };\n    const checkout = () => {\n      console.log(\"去结算\", cartItems.value);\n      // TODO: 添加结算逻辑\n    };\n    const __returned__ = {\n      userId,\n      cartItems,\n      router,\n      totalPrice,\n      fetchCartItems,\n      updateQuantity,\n      removeItem,\n      goHome,\n      checkout,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","useRouter","ElMessage","userId","localStorage","getItem","cartItems","router","totalPrice","value","reduce","total","item","price","parseFloat","cartProduct","quantity","parseInt","fetchCartItems","response","get","data","success","Array","isArray","error","console","updateQuantity","log","put","id","message","removeItem","productId","index","findIndex","product_id","Number","delete","splice","type","duration","goHome","push","checkout"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"150\">\n        <template #default=\"scope\">\n          <img\n            :src=\"scope.row.cartProduct.imageUrl\"\n            alt=\"商品图片\"\n            class=\"cart-image\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\">\n        <template #default=\"scope\">\n          <span class=\"product-name\">{{ scope.row.cartProduct.name }}</span>\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\">\n        <template #default=\"scope\">\n          <span class=\"product-price\"\n            >¥{{ parseFloat(scope.row.cartProduct.price).toFixed(2) }}</span\n          >\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"160\">\n        <template #default=\"scope\">\n          <El-input-number\n            v-model=\"scope.row.quantity\"\n            @change=\"updateQuantity(scope.row)\"\n            :min=\"1\"\n            :max=\"scope.row.cartProduct.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.product_id)\"\n            >删除</El-button\n          >\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>\n        总计: <span class=\"total-price\">¥{{ totalPrice.toFixed(2) }}</span>\n      </h2>\n      <div class=\"button-group\">\n        <El-button class=\"checkout-button\" type=\"primary\" @click=\"checkout\"\n          >去结算</El-button\n        >\n        <El-button type=\"default\" @click=\"goHome\">返回首页</El-button>\n      </div>\n    </div>\n\n    <p v-if=\"!cartItems.length\" class=\"empty-cart\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { useRouter } from \"vue-router\"; // 导入 vue-router\nimport { ElMessage } from \"element-plus\"; // 导入提示消息组件\n\nconst userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\nconst cartItems = ref([]); // 初始化购物车项\n\n// 获取路由实例\nconst router = useRouter();\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n    const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n    return total + price * quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const response = await axios.get(\n      `http://www.groupbuyingsystem.site/api/cart/${userId}`,\n    );\n\n    // 确保成功获取，并获取数据\n    if (response.data.success && Array.isArray(response.data.data)) {\n      cartItems.value = response.data.data; // 将数据赋值给购物车项\n    } else {\n      cartItems.value = []; // 赋值为空数组\n    }\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\n// 更新商品数量\nconst updateQuantity = async (item) => {\n  console.log(\"当前 userId:\", userId); // 添加这行代码以调试\n  console.log(\"商品数量更新: \", item);\n  try {\n    const response = await axios.put(\n      `http://www.groupbuyingsystem.site/api/cart/${userId}/${item.cartProduct.id}`, // 使用路径参数\n      {\n        quantity: item.quantity, // 提交的新数量\n      },\n    );\n\n    if (response.data.success) {\n      console.log(\"数量更新成功\");\n    } else {\n      console.error(\"数量更新失败:\", response.data.message);\n    }\n  } catch (error) {\n    console.error(\"更新数量失败:\", error);\n  }\n};\n\n// 删除商品\nconst removeItem = async (productId) => {\n  console.log(\"删除按钮被点击，商品 ID:\", productId); // 确认传递的商品 ID\n  console.log(\"当前购物车商品:\", cartItems.value); // 打印当前购物车商品\n\n  // 查找当前商品的索引，将 productId 与 cartItems 中的 product_id 进行比较\n  const index = cartItems.value.findIndex(\n    (item) => item.product_id === Number(productId), // 使用 product_id 查找\n  );\n\n  console.log(\"index值:\", index); // 打印找到的索引值\n\n  if (index !== -1) {\n    try {\n      const response = await axios.delete(\n        \"http://www.groupbuyingsystem.site/api/cart\",\n        {\n          data: {\n            userId: localStorage.getItem(\"userId\"),\n            productId: productId, // 传递 productId 作为删除商品的依据\n          },\n        },\n      );\n\n      if (response.data.success) {\n        cartItems.value.splice(index, 1); // 从购物车中删除商品\n        ElMessage({\n          message: \"商品删除成功！\", // 提示内容\n          type: \"success\", // 提示类型\n          duration: 3000, // 持续时间，单位毫秒\n        });\n      } else {\n        console.error(\"商品删除失败:\", response.data.message);\n      }\n    } catch (error) {\n      console.error(\"删除商品失败:\", error);\n    }\n  } else {\n    console.error(\"未找到商品，无法删除\");\n  }\n};\n\n// 返回首页功能\nconst goHome = () => {\n  router.push(\"/home\"); // 导航到首页\n};\n\nconst checkout = () => {\n  console.log(\"去结算\", cartItems.value);\n  // TODO: 添加结算逻辑\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  background: #f9f9f9; /* 背景颜色 */\n  border-radius: 10px; /* 圆角 */\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  padding: 10px 20px;\n  background: #ffffff; /* 总计背景 */\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.product-name {\n  font-weight: bold;\n  color: #333; /* 商品名称颜色 */\n}\n\n.product-price {\n  color: #e94e77; /* 价格颜色 */\n  font-weight: bold; /* 加粗 */\n}\n\n.total-price {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n\n.checkout-button {\n  padding: 10px 20px; /* 按钮内边距 */\n  font-size: 16px; /* 按钮字体大小 */\n}\n\n.empty-cart {\n  text-align: center;\n  color: #999; /* 空购物车提示颜色 */\n  font-style: italic; /* 斜体 */\n}\n\n.button-group {\n  display: flex; /* 使用 Flexbox 布局 */\n  gap: 10px; /* 按钮之间的间距 */\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n}\n</style>\n"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;AAC3B,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,SAAS,QAAQ,cAAc,CAAC,CAAC;;;;;;;;IAE1C,MAAMC,MAAM,GAAGC,YAAY,CAACC,OAAO,CAAC,QAAQ,CAAC,CAAC,CAAC;IAC/C,MAAMC,SAAS,GAAGT,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE3B;IACA,MAAMU,MAAM,GAAGN,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMO,UAAU,GAAGV,QAAQ,CAAC,MAAM;MAChC,OAAOQ,SAAS,CAACG,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,MAAMC,KAAK,GAAGC,UAAU,CAACF,IAAI,CAACG,WAAW,CAACF,KAAK,CAAC,IAAI,CAAC,CAAC,CAAC;QACvD,MAAMG,QAAQ,GAAGC,QAAQ,CAACL,IAAI,CAACI,QAAQ,CAAC,IAAI,CAAC,CAAC,CAAC;QAC/C,OAAOL,KAAK,GAAGE,KAAK,GAAGG,QAAQ;MACjC,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;;IAEF;IACA,MAAME,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMnB,KAAK,CAACoB,GAAG,CAC9B,8CAA8CjB,MAAM,EACtD,CAAC;;QAED;QACA,IAAIgB,QAAQ,CAACE,IAAI,CAACC,OAAO,IAAIC,KAAK,CAACC,OAAO,CAA