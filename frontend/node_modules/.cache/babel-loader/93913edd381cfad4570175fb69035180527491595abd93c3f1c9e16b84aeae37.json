{"ast":null,"code":"import { ref, computed } from \"vue\";\nimport { ElCarousel, ElCarouselItem, ElSelect, ElOption, ElButton, ElRow, ElCol, ElCard, ElPagination } from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter(); // 获取路由对象\n    const store = useStore(); // 获取 Vuex store\n\n    const searchQuery = ref(\"\");\n    const selectedCategory = ref(\"\");\n    const selectedSort = ref(\"\");\n    const currentPage = ref(1);\n    const pageSize = ref(8);\n    const ads = ref([{\n      image: require(\"@/assets/ad3.png\")\n    }, {\n      image: require(\"@/assets/ad6.png\")\n    }, {\n      image: require(\"@/assets/ad7.png\")\n    }]);\n\n    // 计算属性获取用户昵称\n    const userNickname = computed(() => store.getters.userNickname);\n    const products = ref([{\n      id: 1,\n      title: \"苹果 iPhone 16 Pro\",\n      price: 8999.0,\n      image: require(\"@/assets/苹果手机.png\")\n    }, {\n      id: 2,\n      title: \"哈密瓜\",\n      price: 5299.0,\n      image: require(\"@/assets/哈密瓜.png\")\n    }, {\n      id: 3,\n      title: \"华为 Mate 40 Pro\",\n      price: 7999.0,\n      image: require(\"@/assets/笔记本电脑.png\")\n    }]);\n    const filteredProducts = computed(() => {\n      let filtered = products.value;\n\n      // 搜索过滤\n      if (searchQuery.value) {\n        filtered = filtered.filter(product => product.title.includes(searchQuery.value));\n      }\n\n      // 分类过滤\n      if (selectedCategory.value) {\n        filtered = filtered.filter(product => product.category === selectedCategory.value);\n      }\n\n      // 排序\n      if (selectedSort.value === \"low-to-high\") {\n        filtered.sort((a, b) => a.price - b.price);\n      } else if (selectedSort.value === \"high-to-low\") {\n        filtered.sort((a, b) => b.price - a.price);\n      }\n\n      // 分页\n      const start = (currentPage.value - 1) * pageSize.value;\n      return filtered.slice(start, start + pageSize.value);\n    });\n\n    // 应用过滤\n    const applyFilters = () => {\n      currentPage.value = 1; // 重置为第一页\n    };\n\n    // 跳转到首页并刷新\n    const goHome = () => {\n      window.location.reload(); // 强制刷新页面\n    };\n\n    // 跳转到商品详情\n    const viewProductDetails = product => {\n      router.push(`/ProductPage/${product.id}`);\n    };\n\n    // 处理分页\n    const handlePageChange = page => {\n      currentPage.value = page;\n    };\n\n    // 选择分类\n    const selectCategory = category => {\n      selectedCategory.value = category; // 设置选中的分类\n    };\n    const __returned__ = {\n      router,\n      store,\n      searchQuery,\n      selectedCategory,\n      selectedSort,\n      currentPage,\n      pageSize,\n      ads,\n      userNickname,\n      products,\n      filteredProducts,\n      applyFilters,\n      goHome,\n      viewProductDetails,\n      handlePageChange,\n      selectCategory,\n      ref,\n      computed,\n      get ElCarousel() {\n        return ElCarousel;\n      },\n      get ElCarouselItem() {\n        return ElCarouselItem;\n      },\n      get ElSelect() {\n        return ElSelect;\n      },\n      get ElOption() {\n        return ElOption;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElRow() {\n        return ElRow;\n      },\n      get ElCol() {\n        return ElCol;\n      },\n      get ElCard() {\n        return ElCard;\n      },\n      get ElPagination() {\n        return ElPagination;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","ElCarousel","ElCarouselItem","ElSelect","ElOption","ElButton","ElRow","ElCol","ElCard","ElPagination","useRouter","useStore","router","store","searchQuery","selectedCategory","selectedSort","currentPage","pageSize","ads","image","require","userNickname","getters","products","id","title","price","filteredProducts","filtered","value","filter","product","includes","category","sort","a","b","start","slice","applyFilters","goHome","window","location","reload","viewProductDetails","push","handlePageChange","page","selectCategory"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<!-- src/views/home/HomePage.vue -->\n<template>\n  <div class=\"homepage\">\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <El-button class=\"home-button\" @click=\"goHome\">首页</El-button>\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userNickname }}</span>\n          <span class=\"user-action\">购物车</span>\n          <span class=\"user-action\">我的订单</span>\n          <span class=\"user-action\">店铺关注</span>\n          <span class=\"user-action\">浏览记录</span>\n          <input\n              v-model=\"searchQuery\"\n              type=\"text\"\n              class=\"search-input\"\n              placeholder=\"搜索商品\"\n          />\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"1\" class=\"category-menu\">\n          <!-- 商品分类菜单项 -->\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\">家用电器</El-menu-item>\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机/通讯/数码')\">手机/通讯/数码</El-menu-item>\n          <El-menu-item index=\"3\" @click=\"selectCategory('电脑/办公/文具用品')\">电脑/办公/文具用品</El-menu-item>\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具/家居/厨房')\">家具/家居/厨房</El-menu-item>\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装/女装/童装/内衣')\">男装/女装/童装/内衣</El-menu-item>\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆/个护清洁')\">美妆/个护清洁</El-menu-item>\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋/箱包/珠宝')\">女鞋/箱包/珠宝</El-menu-item>\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋/运动/户外')\">男鞋/运动/户外</El-menu-item>\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品/酒类/生鲜')\">食品/酒类/生鲜</El-menu-item>\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术/礼品花/园艺')\">艺术/礼品花/园艺</El-menu-item>\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书/文娱/教育')\">图书/文娱/教育</El-menu-item>\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票/酒店/旅游')\">机票/酒店/旅游</El-menu-item>\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付/保险/金融')\">支付/保险/金融</El-menu-item>\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具/乐器')\">玩具/乐器</El-menu-item>\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <section class=\"ad-banner\">\n          <!-- 广告栏 -->\n          <div class=\"static-ads\">\n            <img src=\"@/assets/ad1.png\" alt=\"广告1\" class=\"ad-image\" />\n            <img src=\"@/assets/ad2.png\" alt=\"广告2\" class=\"ad-image\" />\n          </div>\n          <El-carousel class=\"carousel\" :autoplay=\"true\" interval=\"5000\" arrow=\"always\">\n            <El-carousel-item v-for=\"ad in ads\" :key=\"ad.image\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </El-carousel-item>\n          </El-carousel>\n        </section>\n\n        <section class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n          </El-select>\n          <El-button type=\"primary\" @click=\"applyFilters\">应用</El-button>\n        </section>\n\n        <section class=\"products\">\n          <h2 class=\"section-title\">热卖商品</h2>\n          <El-row :gutter=\"20\">\n            <El-col v-for=\"product in filteredProducts\" :key=\"product.id\" :span=\"6\">\n              <El-card :body-style=\"{ padding: '10px' }\" class=\"product-card\">\n                <img :src=\"product.image\" class=\"product-image\" alt=\"\" />\n                <div class=\"product-info\">\n                  <h3>{{ product.title }}</h3>\n                  <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                  <El-button type=\"primary\" @click=\"viewProductDetails(product)\">查看商品详情</El-button>\n                </div>\n              </El-card>\n            </El-col>\n          </El-row>\n\n          <El-pagination\n              :current-page=\"currentPage\"\n              :page-size=\"pageSize\"\n              :total=\"filteredProducts.length\"\n              @current-change=\"handlePageChange\"\n          />\n        </section>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\nimport {\n  ElCarousel,\n  ElCarouselItem,\n  ElSelect,\n  ElOption,\n  ElButton,\n  ElRow,\n  ElCol,\n  ElCard,\n  ElPagination,\n} from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex store\n\nconst router = useRouter(); // 获取路由对象\nconst store = useStore(); // 获取 Vuex store\n\nconst searchQuery = ref(\"\");\nconst selectedCategory = ref(\"\");\nconst selectedSort = ref(\"\");\nconst currentPage = ref(1);\nconst pageSize = ref(8);\nconst ads = ref([\n  { image: require(\"@/assets/ad3.png\") },\n  { image: require(\"@/assets/ad6.png\") },\n  { image: require(\"@/assets/ad7.png\") },\n]);\n\n// 计算属性获取用户昵称\nconst userNickname = computed(() => store.getters.userNickname);\n\nconst products = ref([\n  {\n    id: 1,\n    title: \"苹果 iPhone 16 Pro\",\n    price: 8999.0,\n    image: require(\"@/assets/苹果手机.png\"),\n  },\n  {\n    id: 2,\n    title: \"哈密瓜\",\n    price: 5299.0,\n    image: require(\"@/assets/哈密瓜.png\"),\n  },\n  {\n    id: 3,\n    title: \"华为 Mate 40 Pro\",\n    price: 7999.0,\n    image: require(\"@/assets/笔记本电脑.png\"),\n  },\n]);\n\nconst filteredProducts = computed(() => {\n  let filtered = products.value;\n\n  // 搜索过滤\n  if (searchQuery.value) {\n    filtered = filtered.filter((product) =>\n        product.title.includes(searchQuery.value)\n    );\n  }\n\n  // 分类过滤\n  if (selectedCategory.value) {\n    filtered = filtered.filter(\n        (product) => product.category === selectedCategory.value\n    );\n  }\n\n  // 排序\n  if (selectedSort.value === \"low-to-high\") {\n    filtered.sort((a, b) => a.price - b.price);\n  } else if (selectedSort.value === \"high-to-low\") {\n    filtered.sort((a, b) => b.price - a.price);\n  }\n\n  // 分页\n  const start = (currentPage.value - 1) * pageSize.value;\n  return filtered.slice(start, start + pageSize.value);\n});\n\n// 应用过滤\nconst applyFilters = () => {\n  currentPage.value = 1; // 重置为第一页\n};\n\n// 跳转到首页并刷新\nconst goHome = () => {\n  window.location.reload(); // 强制刷新页面\n};\n\n// 跳转到商品详情\nconst viewProductDetails = (product) => {\n  router.push(`/ProductPage/${product.id}`);\n};\n\n// 处理分页\nconst handlePageChange = (page) => {\n  currentPage.value = page;\n};\n\n// 选择分类\nconst selectCategory = (category) => {\n  selectedCategory.value = category; // 设置选中的分类\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .home-button {\n        margin-right: 20px; /* 为首页按钮添加右边距 */\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n\n        .search-input {\n          padding: 8px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 200px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n\n  // 其他样式如原代码所示\n}\n</style>"],"mappings":"AA+FA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SACEC,UAAU,EACVC,cAAc,EACdC,QAAQ,EACRC,QAAQ,EACRC,QAAQ,EACRC,KAAK,EACLC,KAAK,EACLC,MAAM,EACNC,YAAY,QACP,cAAc;AACrB,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;;;;;;;;IAEjC,MAAMC,MAAM,GAAGF,SAAS,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMG,KAAK,GAAGF,QAAQ,CAAC,CAAC,CAAC,CAAC;;IAE1B,MAAMG,WAAW,GAAGf,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMgB,gBAAgB,GAAGhB,GAAG,CAAC,EAAE,CAAC;IAChC,MAAMiB,YAAY,GAAGjB,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMkB,WAAW,GAAGlB,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMmB,QAAQ,GAAGnB,GAAG,CAAC,CAAC,CAAC;IACvB,MAAMoB,GAAG,GAAGpB,GAAG,CAAC,CACd;MAAEqB,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC,EACtC;MAAED,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC,EACtC;MAAED,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IAAE,CAAC,CACvC,CAAC;;IAEF;IACA,MAAMC,YAAY,GAAGtB,QAAQ,CAAC,MAAMa,KAAK,CAACU,OAAO,CAACD,YAAY,CAAC;IAE/D,MAAME,QAAQ,GAAGzB,GAAG,CAAC,CACnB;MACE0B,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,kBAAkB;MACzBC,KAAK,EAAE,MAAM;MACbP,KAAK,EAAEC,OAAO,CAAC,mBAAmB;IACpC,CAAC,EACD;MACEI,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,KAAK;MACZC,KAAK,EAAE,MAAM;MACbP,KAAK,EAAEC,OAAO,CAAC,kBAAkB;IACnC,CAAC,EACD;MACEI,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,gBAAgB;MACvBC,KAAK,EAAE,MAAM;MACbP,KAAK,EAAEC,OAAO,CAAC,oBAAoB;IACrC,CAAC,CACF,CAAC;IAEF,MAAMO,gBAAgB,GAAG5B,QAAQ,CAAC