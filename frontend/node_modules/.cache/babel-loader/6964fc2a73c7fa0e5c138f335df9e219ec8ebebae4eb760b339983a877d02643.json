{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted, watch } from \"vue\";\nimport { ElCarousel, ElCarouselItem, ElButton, ElMenu, ElMenuItem, ElSelect, ElOption, ElRow, ElCol, ElCard, ElPagination, ElDialog, ElMessage } from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex Store\nimport axios from \"axios\";\nimport { User } from \"@element-plus/icons-vue\"; // 添加图标导入\n\nconst API_BASE_URL = \"http://localhost:5000\"; // 添加 API 基础 URL\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter(); // 获取路由对象\n    const store = useStore(); // 获取 Vuex Store\n    const searchQuery = ref(\"\"); // 搜索查询\n    const selectedSort = ref(\"default-sort\"); // 默认排序方式\n    const currentPage = ref(1); // 当前页码\n    const itemsPerPage = ref(8); // 每页显示的商品数量\n    const sortedProducts = computed(() => {\n      const products = store.getters.allProducts || [];\n      console.log(\"当前产品列表:\", products);\n      switch (selectedSort.value) {\n        case \"low-to-high\":\n          return [...products].sort((a, b) => a.price - b.price);\n        case \"high-to-low\":\n          return [...products].sort((a, b) => b.price - a.price);\n        case \"hot-to-high\":\n          return [...products].sort((a, b) => b.sales - a.sales);\n        default:\n          return products;\n      }\n    });\n    const ads = ref([{\n      image: \"/assets/苹果13.png\"\n    }, {\n      image: \"/assets/苹果15Pro.png\"\n    }, {\n      image: \"/assets/微软二合一ipad.png\"\n    }]);\n    const goToProfile = () => {\n      router.push({\n        name: \"UserPage\"\n      }); // 跳转到个人中心页面\n    };\n\n    // 获取产品数据\n    const fetchProductData = async () => {\n      try {\n        await store.dispatch(\"FetchProducts\");\n        console.log(\"产品数据获取成功\");\n      } catch (error) {\n        console.error(\"获取产品数据失败:\", error);\n      }\n    };\n    // 添加跳转到购物车的功能\n    const goToCart = () => {\n      router.push({\n        name: \"CartPage\"\n      }); // 跳转到购物车页面\n    };\n\n    // 添加跳转到我的订单的功能\n    const goToOrders = () => {\n      // 使用路径导航\n      router.push({\n        name: \"OrderPage\"\n      });\n    };\n\n    // 计算属性获取用户昵称\n    const userNickname = computed(() => store.getters.userNickname);\n    // 计算属性获取用户头像\n    const userAvatar = computed(() => {\n      const avatar = store.getters.userAvatar;\n      if (!avatar) {\n        return \"/assets/avatar.png\";\n      }\n      if (avatar === \"/assets/avatar.png\") {\n        return avatar;\n      }\n      return avatar.startsWith(\"http\") ? avatar : `http://localhost:5000${avatar}`;\n    });\n\n    // 获取当前页的产品\n    const paginatedProducts = computed(() => {\n      const start = (currentPage.value - 1) * itemsPerPage.value;\n      const end = start + itemsPerPage.value;\n      return sortedProducts.value.slice(start, end);\n    });\n\n    // 分页功能变化时的处理函数\n    const handlePageChange = newPage => {\n      currentPage.value = newPage; // 更新当前页\n    };\n\n    // 搜索功能\n    const applySearch = async () => {\n      console.log(\"搜索产品:\", searchQuery.value);\n      try {\n        if (searchQuery.value.trim()) {\n          await store.dispatch(\"SearchProducts\", searchQuery.value);\n        } else {\n          await store.dispatch(\"FetchProducts\");\n        }\n        currentPage.value = 1; // 重置页码\n      } catch (error) {\n        console.error(\"搜索产品失败:\", error);\n      }\n    };\n\n    // 跳转到首页并刷新\n    const goHome = () => {\n      window.location.reload(); // 强制刷新页面\n    };\n\n    // 跳转到商品详情\n    const viewProductDetails = product => {\n      console.log(`Navigating to product with ID: ${product.id}`); // 调试输出\n      router.push(`/product/${product.id}`);\n    };\n\n    // 选择分类\n    const selectCategory = async category => {\n      console.log(`选择了分类: ${category}`);\n      try {\n        if (category) {\n          await store.dispatch(\"FetchProductsByCategory\", category);\n        } else {\n          await store.dispatch(\"FetchProducts\");\n        }\n        currentPage.value = 1; // 重置页码\n      } catch (error) {\n        console.error(\"获取分类产品失败:\", error);\n      }\n    };\n\n    // 退出登录功能\n    const logout = () => {\n      console.log(\"用户已注销\");\n      store.commit(\"clearUser\"); // 清空用户信息\n      router.push({\n        name: \"Login\"\n      }); // 跳转到登录页面\n    };\n\n    // 拼团相关\n    const groupBuyDialogVisible = ref(false);\n    const myGroupBuys = ref([]);\n    const timers = ref({}); // 存储所有计时器\n\n    // 显示我的拼团对话框\n    const showMyGroupBuys = async () => {\n      groupBuyDialogVisible.value = true;\n      await fetchMyGroupBuys();\n    };\n\n    // 获取我的拼团列表\n    const fetchMyGroupBuys = async () => {\n      try {\n        const response = await axios.get(`${API_BASE_URL}/api/group-buys/user`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem(\"token\")}`\n          }\n        });\n        if (response.data.code === 200) {\n          console.log(\"拼团数据:\", response.data.data);\n          myGroupBuys.value = response.data.data.map(group => {\n            // 检查拼团状态\n            if (group.status === \"IN_PROGRESS\") {\n              // 只有在人数严格等于要求时才标记为成功\n              if (group.currentSize === group.requiredSize) {\n                group.status = \"SUCCESS\";\n              }\n              // 只有在时间到期且人数未达到要求时才标记为失败\n              else if (group.remainingSeconds <= 0 && group.currentSize < group.requiredSize) {\n                group.status = \"FAILED\";\n              }\n              // 其他情况保持进行中状态\n            }\n            return group;\n          });\n\n          // 为每个进行中的拼团启动倒计时\n          myGroupBuys.value.forEach(group => {\n            if (group.status === \"IN_PROGRESS\" && group.remainingSeconds > 0) {\n              startGroupCountdown(group);\n            }\n          });\n        }\n      } catch (error) {\n        console.error(\"获取拼团列表失败:\", error);\n        ElMessage.error(\"获取拼团列表失败\");\n      }\n    };\n\n    // 修改倒计时逻辑\n    const startGroupCountdown = group => {\n      const timer = setInterval(() => {\n        if (group.remainingSeconds <= 0) {\n          clearInterval(timer);\n          // 只有在时间到期且人数未达到要求时才标记为失败\n          if (group.currentSize < group.requiredSize) {\n            group.status = \"FAILED\";\n          }\n          return;\n        }\n        if (group.currentSize === group.requiredSize) {\n          clearInterval(timer);\n          group.status = \"SUCCESS\";\n          return;\n        }\n        group.remainingSeconds--;\n      }, 1000);\n\n      // 保存定时器ID以便在组件销毁时清除\n      timers.value[group.id] = timer;\n    };\n\n    // 格式化拼团状态\n    const formatGroupStatus = status => {\n      const statusMap = {\n        IN_PROGRESS: \"进行中\",\n        COMPLETED: \"拼团成功\",\n        FAILED: \"拼团失败\"\n      };\n      return statusMap[status] || status;\n    };\n\n    // 格式化剩余时间\n    const formatTime = seconds => {\n      if (seconds == null || isNaN(seconds)) return \"00:00:00\";\n      const hours = Math.floor(seconds / 3600);\n      const minutes = Math.floor(seconds % 3600 / 60);\n      const remainingSeconds = seconds % 60;\n      return `${hours.toString().padStart(2, \"0\")}:${minutes.toString().padStart(2, \"0\")}:${remainingSeconds.toString().padStart(2, \"0\")}`;\n    };\n\n    // 复制邀请码\n    const copyInviteCode = async inviteCode => {\n      try {\n        await navigator.clipboard.writeText(inviteCode);\n        ElMessage.success(\"邀请码已复制到剪贴板\");\n      } catch (error) {\n        console.error(\"复制失败:\", error);\n        ElMessage.error(\"复制失败，请手动复制\");\n      }\n    };\n\n    // 获取参与者头像\n    const getParticipantAvatar = participant => {\n      console.log(\"处理头像的参与者数据:\", participant); // 添加调试日志\n      if (!participant || !participant.avatar) {\n        return \"/assets/avatar.png\";\n      }\n\n      // 如果头像路径是相对路径，添加API基础URL\n      if (participant.avatar.startsWith(\"/\")) {\n        return `${API_BASE_URL}${participant.avatar}`;\n      }\n\n      // 如果是完整的URL或默认头像，直接返回\n      return participant.avatar;\n    };\n\n    // 在组件挂载时获取产品数据\n    onMounted(() => {\n      fetchProductData();\n    });\n\n    // 在对话框关闭时清理所有计时器\n    const cleanupTimers = () => {\n      Object.values(timers.value).forEach(timer => clearInterval(timer));\n      timers.value = {};\n    };\n\n    // 监听对话框关闭事件\n    watch(groupBuyDialogVisible, newValue => {\n      if (!newValue) {\n        cleanupTimers();\n      }\n    });\n\n    // 组件卸载时清理计时器\n    onUnmounted(() => {\n      cleanupTimers();\n    });\n    const __returned__ = {\n      API_BASE_URL,\n      router,\n      store,\n      searchQuery,\n      selectedSort,\n      currentPage,\n      itemsPerPage,\n      sortedProducts,\n      ads,\n      goToProfile,\n      fetchProductData,\n      goToCart,\n      goToOrders,\n      userNickname,\n      userAvatar,\n      paginatedProducts,\n      handlePageChange,\n      applySearch,\n      goHome,\n      viewProductDetails,\n      selectCategory,\n      logout,\n      groupBuyDialogVisible,\n      myGroupBuys,\n      timers,\n      showMyGroupBuys,\n      fetchMyGroupBuys,\n      startGroupCountdown,\n      formatGroupStatus,\n      formatTime,\n      copyInviteCode,\n      getParticipantAvatar,\n      cleanupTimers,\n      ref,\n      computed,\n      onMounted,\n      onUnmounted,\n      watch,\n      get ElCarousel() {\n        return ElCarousel;\n      },\n      get ElCarouselItem() {\n        return ElCarouselItem;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElMenu() {\n        return ElMenu;\n      },\n      get ElMenuItem() {\n        return ElMenuItem;\n      },\n      get ElSelect() {\n        return ElSelect;\n      },\n      get ElOption() {\n        return ElOption;\n      },\n      get ElRow() {\n        return ElRow;\n      },\n      get ElCol() {\n        return ElCol;\n      },\n      get ElCard() {\n        return ElCard;\n      },\n      get ElPagination() {\n        return ElPagination;\n      },\n      get ElDialog() {\n        return ElDialog;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      },\n      get axios() {\n        return axios;\n      },\n      get User() {\n        return User;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","watch","ElCarousel","ElCarouselItem","ElButton","ElMenu","ElMenuItem","ElSelect","ElOption","ElRow","ElCol","ElCard","ElPagination","ElDialog","ElMessage","useRouter","useStore","axios","User","API_BASE_URL","router","store","searchQuery","selectedSort","currentPage","itemsPerPage","sortedProducts","products","getters","allProducts","console","log","value","sort","a","b","price","sales","ads","image","goToProfile","push","name","fetchProductData","dispatch","error","goToCart","goToOrders","userNickname","userAvatar","avatar","startsWith","paginatedProducts","start","end","slice","handlePageChange","newPage","applySearch","trim","goHome","window","location","reload","viewProductDetails","product","id","selectCategory","category","logout","commit","groupBuyDialogVisible","myGroupBuys","timers","showMyGroupBuys","fetchMyGroupBuys","response","get","headers","Authorization","localStorage","getItem","data","code","map","group","status","currentSize","requiredSize","remainingSeconds","forEach","startGroupCountdown","timer","setInterval","clearInterval","formatGroupStatus","statusMap","IN_PROGRESS","COMPLETED","FAILED","formatTime","seconds","isNaN","hours","Math","floor","minutes","toString","padStart","copyInviteCode","inviteCode","navigator","clipboard","writeText","success","getParticipantAvatar","participant","cleanupTimers","Object","values","newValue"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <!-- Logo -->\n        <img src=\"/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <!-- 首页按钮 -->\n        <El-button class=\"home-button\" @click=\"goHome\">首页</El-button>\n        <!-- 用户功能 -->\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userNickname }}</span>\n          <img\n            v-if=\"userAvatar\"\n            :src=\"userAvatar\"\n            alt=\"用户头像\"\n            class=\"user-avatar\"\n          />\n          <span class=\"user-action\" @click=\"goToProfile\">用户中心</span>\n          <span class=\"user-action\" @click=\"goToCart\">购物车</span>\n          <span class=\"user-action\" @click=\"goToOrders\">我的订单</span>\n          <span class=\"user-action\" @click=\"showMyGroupBuys\">我的拼团</span>\n          <span class=\"user-action\" @click=\"logout\">退出登录</span>\n          <div class=\"search-container\">\n            <input\n              v-model=\"searchQuery\"\n              type=\"text\"\n              class=\"search-input\"\n              placeholder=\"搜索商品\"\n            />\n            <El-button type=\"primary\" @click=\"applySearch\">搜索</El-button>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <!-- 商品分类 -->\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"\" class=\"category-menu\">\n          <El-menu-item index=\"\" @click=\"selectCategory('')\"\n            >所有类目</El-menu-item\n          >\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\"\n            >家用电器</El-menu-item\n          >\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机通讯数码')\"\n            >手机/通讯/数码</El-menu-item\n          >\n          <El-menu-item index=\"3\" @click=\"selectCategory('电脑办公文具用品')\"\n            >电脑/办公/文具用品</El-menu-item\n          >\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具家居厨房')\"\n            >家具/家居/厨房</El-menu-item\n          >\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装女装童装内衣')\"\n            >男装/女装/童装/内衣</El-menu-item\n          >\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆个护清洁')\"\n            >美妆/个护清洁</El-menu-item\n          >\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋箱包珠宝')\"\n            >女鞋/箱包/珠宝</El-menu-item\n          >\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋运动户外')\"\n            >男鞋/运动/户外</El-menu-item\n          >\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品酒类生鲜')\"\n            >食品/酒类/生鲜</El-menu-item\n          >\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术礼品花园艺')\"\n            >艺术/礼品花/园艺</El-menu-item\n          >\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书文娱教育')\"\n            >图书/文娱/教育</El-menu-item\n          >\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票酒店旅游')\"\n            >机票/酒店/旅游</El-menu-item\n          >\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付保险金融')\"\n            >支付/保险/金融</El-menu-item\n          >\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具乐器')\"\n            >玩具/乐器</El-menu-item\n          >\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <section class=\"ad-banner\">\n          <div class=\"static-ads\">\n            <img src=\"/assets/车厘子.png\" alt=\"广告1\" class=\"ad-image\" />\n            <img src=\"/assets/广告1.png\" alt=\"广告2\" class=\"ad-image\" />\n          </div>\n          <El-carousel\n            class=\"carousel\"\n            :autoplay=\"true\"\n            interval=\"5000\"\n            arrow=\"always\"\n          >\n            <El-carousel-item v-for=\"ad in ads\" :key=\"ad.image\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </El-carousel-item>\n          </El-carousel>\n        </section>\n\n        <!-- 热卖商品标题 -->\n        <h2 class=\"section-title\">热卖商品</h2>\n\n        <!-- 排序选择框 -->\n        <div class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"默认排序\" value=\"default-sort\"></El-option>\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n            <El-option label=\"销量从高到低\" value=\"hot-to-high\"></El-option>\n          </El-select>\n        </div>\n\n        <!-- 商品展示区域 -->\n        <El-row :gutter=\"20\">\n          <El-col\n            v-for=\"product in paginatedProducts\"\n            :key=\"product.id\"\n            :span=\"6\"\n          >\n            <El-card :style=\"{ padding: '45px' }\" class=\"product-card\">\n              <img\n                :src=\"product.image || '/assets/default-product.png'\"\n                class=\"product-image\"\n                alt=\"\"\n              />\n              <div class=\"product-info\">\n                <h3>{{ product.name }}</h3>\n                <p class=\"price\">\n                  ¥{{ product.price ? product.price : \"暂无价格\" }}\n                </p>\n                <El-button type=\"primary\" @click=\"viewProductDetails(product)\"\n                  >查看商品详情</El-button\n                >\n              </div>\n            </El-card>\n          </El-col>\n        </El-row>\n        <p v-if=\"!paginatedProducts.length\">没有找到相关商品</p>\n\n        <!-- 分页 -->\n        <El-pagination\n          :current-page=\"currentPage\"\n          :page-size=\"itemsPerPage\"\n          :total=\"sortedProducts.length\"\n          @current-change=\"handlePageChange\"\n          layout=\"total, prev, pager, next, jumper\"\n        />\n      </section>\n    </div>\n\n    <!-- 我的拼团对话框 -->\n    <El-dialog\n      v-model=\"groupBuyDialogVisible\"\n      title=\"我的拼团\"\n      width=\"700px\"\n      :close-on-click-modal=\"false\"\n    >\n      <div class=\"my-group-buys\">\n        <div v-if=\"myGroupBuys.length === 0\" class=\"empty-message\">\n          暂无拼团记录\n        </div>\n        <div v-else class=\"group-buy-list\">\n          <div\n            v-for=\"group in myGroupBuys\"\n            :key=\"group.id\"\n            class=\"group-buy-item\"\n          >\n            <div class=\"group-info\">\n              <img\n                :src=\"group.productImage\"\n                alt=\"商品图片\"\n                class=\"product-image\"\n              />\n              <div class=\"group-details\">\n                <h3>{{ group.productName }}</h3>\n                <p class=\"group-price\">拼团价：¥{{ group.groupPrice }}</p>\n                <p class=\"group-status\">\n                  状态：\n                  <span\n                    :class=\"[\n                      'status',\n                      group.status === 'COMPLETED'\n                        ? 'success'\n                        : group.status === 'FAILED'\n                          ? 'failed'\n                          : 'ongoing',\n                    ]\"\n                  >\n                    {{ formatGroupStatus(group.status) }}\n                  </span>\n                </p>\n                <p class=\"group-progress\">\n                  进度：{{ group.currentSize }}/{{ group.requiredSize || 5 }}人\n                </p>\n                <p class=\"remaining-time\" v-if=\"group.status === 'IN_PROGRESS'\">\n                  剩余时间：{{ formatTime(group.remainingSeconds) }}\n                </p>\n                <!-- 添加参与者头像展示 -->\n                <div class=\"participants-avatars\">\n                  <div\n                    v-for=\"i in group.requiredSize || 5\"\n                    :key=\"i\"\n                    class=\"avatar-slot\"\n                    :class=\"{\n                      empty:\n                        !group.participants || i > group.participants.length,\n                    }\"\n                  >\n                    <template\n                      v-if=\"group.participants && group.participants[i - 1]\"\n                    >\n                      <el-tooltip\n                        :content=\"\n                          group.participants[i - 1].nickname || '参与者'\n                        \"\n                        placement=\"top\"\n                      >\n                        <img\n                          :src=\"getParticipantAvatar(group.participants[i - 1])\"\n                          :alt=\"group.participants[i - 1].nickname || '参与者'\"\n                          class=\"participant-avatar\"\n                        />\n                      </el-tooltip>\n                    </template>\n                    <el-icon v-else class=\"empty-avatar\"><User /></el-icon>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"group-actions\">\n              <El-button\n                v-if=\"group.status === 'IN_PROGRESS'\"\n                type=\"primary\"\n                size=\"small\"\n                @click=\"copyInviteCode(group.inviteCode)\"\n              >\n                复制邀请码\n              </El-button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </El-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted, onUnmounted, watch } from \"vue\";\nimport {\n  ElCarousel,\n  ElCarouselItem,\n  ElButton,\n  ElMenu,\n  ElMenuItem,\n  ElSelect,\n  ElOption,\n  ElRow,\n  ElCol,\n  ElCard,\n  ElPagination,\n  ElDialog,\n  ElMessage,\n} from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex Store\nimport axios from \"axios\";\nimport { User } from \"@element-plus/icons-vue\"; // 添加图标导入\n\nconst API_BASE_URL = \"http://localhost:5000\"; // 添加 API 基础 URL\nconst router = useRouter(); // 获取路由对象\nconst store = useStore(); // 获取 Vuex Store\nconst searchQuery = ref(\"\"); // 搜索查询\nconst selectedSort = ref(\"default-sort\"); // 默认排序方式\nconst currentPage = ref(1); // 当前页码\nconst itemsPerPage = ref(8); // 每页显示的商品数量\nconst sortedProducts = computed(() => {\n  const products = store.getters.allProducts || [];\n  console.log(\"当前产品列表:\", products);\n\n  switch (selectedSort.value) {\n    case \"low-to-high\":\n      return [...products].sort((a, b) => a.price - b.price);\n    case \"high-to-low\":\n      return [...products].sort((a, b) => b.price - a.price);\n    case \"hot-to-high\":\n      return [...products].sort((a, b) => b.sales - a.sales);\n    default:\n      return products;\n  }\n});\nconst ads = ref([\n  { image: \"/assets/苹果13.png\" },\n  { image: \"/assets/苹果15Pro.png\" },\n  { image: \"/assets/微软二合一ipad.png\" },\n]);\n\nconst goToProfile = () => {\n  router.push({ name: \"UserPage\" }); // 跳转到个人中心页面\n};\n\n// 获取产品数据\nconst fetchProductData = async () => {\n  try {\n    await store.dispatch(\"FetchProducts\");\n    console.log(\"产品数据获取成功\");\n  } catch (error) {\n    console.error(\"获取产品数据失败:\", error);\n  }\n};\n// 添加跳转到购物车的功能\nconst goToCart = () => {\n  router.push({ name: \"CartPage\" }); // 跳转到购物车页面\n};\n\n// 添加跳转到我的订单的功能\nconst goToOrders = () => {\n  // 使用路径导航\n  router.push({ name: \"OrderPage\" });\n};\n\n// 计算属性获取用户昵称\nconst userNickname = computed(() => store.getters.userNickname);\n// 计算属性获取用户头像\nconst userAvatar = computed(() => {\n  const avatar = store.getters.userAvatar;\n  if (!avatar) {\n    return \"/assets/avatar.png\";\n  }\n  if (avatar === \"/assets/avatar.png\") {\n    return avatar;\n  }\n  return avatar.startsWith(\"http\") ? avatar : `http://localhost:5000${avatar}`;\n});\n\n// 获取当前页的产品\nconst paginatedProducts = computed(() => {\n  const start = (currentPage.value - 1) * itemsPerPage.value;\n  const end = start + itemsPerPage.value;\n  return sortedProducts.value.slice(start, end);\n});\n\n// 分页功能变化时的处理函数\nconst handlePageChange = (newPage) => {\n  currentPage.value = newPage; // 更新当前页\n};\n\n// 搜索功能\nconst applySearch = async () => {\n  console.log(\"搜索产品:\", searchQuery.value);\n  try {\n    if (searchQuery.value.trim()) {\n      await store.dispatch(\"SearchProducts\", searchQuery.value);\n    } else {\n      await store.dispatch(\"FetchProducts\");\n    }\n    currentPage.value = 1; // 重置页码\n  } catch (error) {\n    console.error(\"搜索产品失败:\", error);\n  }\n};\n\n// 跳转到首页并刷新\nconst goHome = () => {\n  window.location.reload(); // 强制刷新页面\n};\n\n// 跳转到商品详情\nconst viewProductDetails = (product) => {\n  console.log(`Navigating to product with ID: ${product.id}`); // 调试输出\n  router.push(`/product/${product.id}`);\n};\n\n// 选择分类\nconst selectCategory = async (category) => {\n  console.log(`选择了分类: ${category}`);\n  try {\n    if (category) {\n      await store.dispatch(\"FetchProductsByCategory\", category);\n    } else {\n      await store.dispatch(\"FetchProducts\");\n    }\n    currentPage.value = 1; // 重置页码\n  } catch (error) {\n    console.error(\"获取分类产品失败:\", error);\n  }\n};\n\n// 退出登录功能\nconst logout = () => {\n  console.log(\"用户已注销\");\n  store.commit(\"clearUser\"); // 清空用户信息\n  router.push({ name: \"Login\" }); // 跳转到登录页面\n};\n\n// 拼团相关\nconst groupBuyDialogVisible = ref(false);\nconst myGroupBuys = ref([]);\nconst timers = ref({}); // 存储所有计时器\n\n// 显示我的拼团对话框\nconst showMyGroupBuys = async () => {\n  groupBuyDialogVisible.value = true;\n  await fetchMyGroupBuys();\n};\n\n// 获取我的拼团列表\nconst fetchMyGroupBuys = async () => {\n  try {\n    const response = await axios.get(`${API_BASE_URL}/api/group-buys/user`, {\n      headers: {\n        Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n      },\n    });\n    if (response.data.code === 200) {\n      console.log(\"拼团数据:\", response.data.data);\n      myGroupBuys.value = response.data.data.map((group) => {\n        // 检查拼团状态\n        if (group.status === \"IN_PROGRESS\") {\n          // 只有在人数严格等于要求时才标记为成功\n          if (group.currentSize === group.requiredSize) {\n            group.status = \"SUCCESS\";\n          }\n          // 只有在时间到期且人数未达到要求时才标记为失败\n          else if (\n            group.remainingSeconds <= 0 &&\n            group.currentSize < group.requiredSize\n          ) {\n            group.status = \"FAILED\";\n          }\n          // 其他情况保持进行中状态\n        }\n        return group;\n      });\n\n      // 为每个进行中的拼团启动倒计时\n      myGroupBuys.value.forEach((group) => {\n        if (group.status === \"IN_PROGRESS\" && group.remainingSeconds > 0) {\n          startGroupCountdown(group);\n        }\n      });\n    }\n  } catch (error) {\n    console.error(\"获取拼团列表失败:\", error);\n    ElMessage.error(\"获取拼团列表失败\");\n  }\n};\n\n// 修改倒计时逻辑\nconst startGroupCountdown = (group) => {\n  const timer = setInterval(() => {\n    if (group.remainingSeconds <= 0) {\n      clearInterval(timer);\n      // 只有在时间到期且人数未达到要求时才标记为失败\n      if (group.currentSize < group.requiredSize) {\n        group.status = \"FAILED\";\n      }\n      return;\n    }\n\n    if (group.currentSize === group.requiredSize) {\n      clearInterval(timer);\n      group.status = \"SUCCESS\";\n      return;\n    }\n\n    group.remainingSeconds--;\n  }, 1000);\n\n  // 保存定时器ID以便在组件销毁时清除\n  timers.value[group.id] = timer;\n};\n\n// 格式化拼团状态\nconst formatGroupStatus = (status) => {\n  const statusMap = {\n    IN_PROGRESS: \"进行中\",\n    COMPLETED: \"拼团成功\",\n    FAILED: \"拼团失败\",\n  };\n  return statusMap[status] || status;\n};\n\n// 格式化剩余时间\nconst formatTime = (seconds) => {\n  if (seconds == null || isNaN(seconds)) return \"00:00:00\";\n  const hours = Math.floor(seconds / 3600);\n  const minutes = Math.floor((seconds % 3600) / 60);\n  const remainingSeconds = seconds % 60;\n  return `${hours.toString().padStart(2, \"0\")}:${minutes\n    .toString()\n    .padStart(2, \"0\")}:${remainingSeconds.toString().padStart(2, \"0\")}`;\n};\n\n// 复制邀请码\nconst copyInviteCode = async (inviteCode) => {\n  try {\n    await navigator.clipboard.writeText(inviteCode);\n    ElMessage.success(\"邀请码已复制到剪贴板\");\n  } catch (error) {\n    console.error(\"复制失败:\", error);\n    ElMessage.error(\"复制失败，请手动复制\");\n  }\n};\n\n// 获取参与者头像\nconst getParticipantAvatar = (participant) => {\n  console.log(\"处理头像的参与者数据:\", participant); // 添加调试日志\n  if (!participant || !participant.avatar) {\n    return \"/assets/avatar.png\";\n  }\n\n  // 如果头像路径是相对路径，添加API基础URL\n  if (participant.avatar.startsWith(\"/\")) {\n    return `${API_BASE_URL}${participant.avatar}`;\n  }\n\n  // 如果是完整的URL或默认头像，直接返回\n  return participant.avatar;\n};\n\n// 在组件挂载时获取产品数据\nonMounted(() => {\n  fetchProductData();\n});\n\n// 在对话框关闭时清理所有计时器\nconst cleanupTimers = () => {\n  Object.values(timers.value).forEach((timer) => clearInterval(timer));\n  timers.value = {};\n};\n\n// 监听对话框关闭事件\nwatch(groupBuyDialogVisible, (newValue) => {\n  if (!newValue) {\n    cleanupTimers();\n  }\n});\n\n// 组件卸载时清理计时器\nonUnmounted(() => {\n  cleanupTimers();\n});\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .home-button {\n        margin-right: 20px; /* 为首页按钮添加右边距 */\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n        .search-container {\n          display: flex;\n          align-items: center;\n        }\n        .search-input {\n          padding: 10px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 600px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n\n  .user-avatar {\n    width: 40px; /* 头像宽度 */\n    height: 40px; /* 头像高度 */\n    border-radius: 50%; /* 圆形头像 */\n    margin-left: 10px; /* 与昵称之间的间距 */\n  }\n\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4;\n  }\n\n  .category-menu {\n    padding: 10px;\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .ad-banner {\n      display: flex;\n      align-items: center; /* 此时保持广告栏对齐 */\n      margin-bottom: 20px;\n\n      .static-ads {\n        display: flex; /* 使用 flexbox 使广告在同一行 */\n        flex: 1; /* 调整两侧静态广告的宽度 */\n        justify-content: space-between; /* 在广告之间留出间距 */\n        margin-right: 20px; /* 右侧留出间距 */\n      }\n\n      .ad-image {\n        height: 500px; /* 设置每个静态广告的高度 */\n        flex: 1; /* 每个广告等分宽度 */\n        object-fit: cover; /* 保持比例 */\n        margin: 0 10px; /* 设置广告之间的间隙 */\n      }\n\n      .carousel {\n        height: 500px; /* 高度设置为 500px 以对齐 */\n        flex: 2; /* 确保轮播占用更多空间 */\n        position: relative; /* 为了确保图片可以覆盖整个区域 */\n\n        .el-carousel__item {\n          height: 500px; /* 确保每个轮播项的高度为 500px */\n        }\n\n        .ad-image {\n          width: 100%; /* 确保图片宽度100% */\n          height: 100%; /* 确保图片高度为100% */\n          object-fit: cover; /* 确保图片填充，同时保持比例 */\n        }\n      }\n    }\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px; /* 排序框右边距 */\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n      height: 400px; /* 设置产品卡片的高度，根据需要调整 */\n      overflow: hidden; /* 隐藏溢出的部分 */\n      display: flex; /* 使用 flexbox 布局 */\n      flex-direction: column; /* 列方向排列子元素 */\n\n      .product-image {\n        flex: 1; /* 让产品图片占据剩余空间 */\n        width: 100%;\n        height: auto; /* 自适应高度 */\n        object-fit: cover; /* 确保图片填充，同时保持比例 */\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 10px; /* 调整与图片的间距 */\n        margin-bottom: 10px; /* 添加底部间距 */\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n\n.my-group-buys {\n  max-height: 500px;\n  overflow-y: auto;\n}\n\n.empty-message {\n  text-align: center;\n  color: #909399;\n  padding: 20px;\n}\n\n.group-buy-item {\n  border: 1px solid #ebeef5;\n  border-radius: 8px;\n  padding: 15px;\n  margin-bottom: 15px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.group-info {\n  display: flex;\n  gap: 15px;\n}\n\n.product-image {\n  width: 100px;\n  height: 100px;\n  object-fit: cover;\n  border-radius: 4px;\n}\n\n.group-details {\n  flex: 1;\n}\n\n.group-details h3 {\n  margin: 0 0 10px 0;\n  color: #303133;\n}\n\n.group-price {\n  color: #f56c6c;\n  font-weight: bold;\n  margin: 5px 0;\n}\n\n.group-status {\n  margin: 5px 0;\n}\n\n.status {\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.status.success {\n  background-color: #67c23a;\n  color: white;\n}\n\n.status.failed {\n  background-color: #f56c6c;\n  color: white;\n}\n\n.status.ongoing {\n  background-color: #409eff;\n  color: white;\n}\n\n.group-progress {\n  margin: 5px 0;\n  color: #606266;\n}\n\n.remaining-time {\n  color: #e6a23c;\n  font-weight: bold;\n  margin: 5px 0;\n}\n\n.group-actions {\n  margin-left: 15px;\n}\n\n.participants-avatars {\n  display: flex;\n  gap: 10px;\n  margin: 15px 0;\n  padding: 10px;\n  background-color: #f8f9fa;\n  border-radius: 8px;\n\n  .avatar-slot {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    border: 2px solid #409eff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    background-color: #fff;\n    transition: all 0.3s ease;\n\n    &:hover {\n      transform: scale(1.1);\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n    }\n\n    &.empty {\n      border-style: dashed;\n      border-color: #dcdfe6;\n      background-color: #f5f7fa;\n    }\n\n    .participant-avatar {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n\n    .empty-avatar {\n      font-size: 24px;\n      color: #dcdfe6;\n    }\n  }\n}\n</style>\n"],"mappings":"AA+PA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAK,QAAQ,KAAK;AAClE,SACEC,UAAU,EACVC,cAAc,EACdC,QAAQ,EACRC,MAAM,EACNC,UAAU,EACVC,QAAQ,EACRC,QAAQ,EACRC,KAAK,EACLC,KAAK,EACLC,MAAM,EACNC,YAAY,EACZC,QAAQ,EACRC,SAAS,QACJ,cAAc;AACrB,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;AACjC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAASC,IAAI,QAAQ,yBAAyB,CAAC,CAAC;;AAEhD,MAAMC,YAAY,GAAG,uBAAuB,CAAC,CAAC;;;;;;;;IAC9C,MAAMC,MAAM,GAAGL,SAAS,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMM,KAAK,GAAGL,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMM,WAAW,GAAGzB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC7B,MAAM0B,YAAY,GAAG1B,GAAG,CAAC,cAAc,CAAC,CAAC,CAAC;IAC1C,MAAM2B,WAAW,GAAG3B,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAM4B,YAAY,GAAG5B,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC;IAC7B,MAAM6B,cAAc,GAAG5B,QAAQ,CAAC,MAAM;MACpC,MAAM6B,QAAQ,GAAGN,KAAK,CAACO,OAAO,CAACC,WAAW,IAAI,EAAE;MAChDC,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEJ,QAAQ,CAAC;MAEhC,QAAQJ,YAAY,CAACS,KAAK;QACxB,KAAK,aAAa;UAChB,OAAO,CAAC,GAAGL,QAAQ,CAAC,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKD,CAAC,CAACE,KAAK,GAAGD,CAAC,CAACC,KAAK,CAAC;QACxD,KAAK,aAAa;UAChB,OAAO,CAAC,GAAGT,QAAQ,CAAC,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACC,KAAK,GAAGF,CAAC,CAACE,KAAK,CAAC;QACxD,KAAK,aAAa;UAChB,OAAO,CAAC,GAAGT,QAAQ,CAAC,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACE,KAAK,GAAGH