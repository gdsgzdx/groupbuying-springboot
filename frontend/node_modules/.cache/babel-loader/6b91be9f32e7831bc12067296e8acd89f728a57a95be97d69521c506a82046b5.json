{"ast":null,"code":"import { ref, computed } from \"vue\";\nimport { ElTable, ElTableColumn, ElButton, ElInputNumber } from \"element-plus\";\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const cartItems = ref([{\n      id: 1,\n      name: \"苹果13\",\n      price: 6999,\n      quantity: 1,\n      stock: 5,\n      image: \"/assets/苹果13.png\"\n    }, {\n      id: 2,\n      name: \"微软二合一ipad\",\n      price: 3488,\n      quantity: 2,\n      stock: 10,\n      image: \"/assets/微软二合一ipad.png\"\n    }\n    // 可以添加更多商品\n    ]);\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        return total + item.price * item.quantity;\n      }, 0);\n    });\n    const updateQuantity = item => {\n      // 这里可以实现动态更新商品数量的逻辑，比如更新后端数据\n      console.log(\"商品数量更新: \", item);\n    };\n    const removeItem = itemId => {\n      const index = cartItems.value.findIndex(item => item.id === itemId);\n      if (index !== -1) {\n        cartItems.value.splice(index, 1);\n      }\n    };\n    const checkout = () => {\n      // 跳转到结算页面或处理结算逻辑\n      console.log(\"去结算\", cartItems.value);\n    };\n    const __returned__ = {\n      cartItems,\n      totalPrice,\n      updateQuantity,\n      removeItem,\n      checkout,\n      ref,\n      computed,\n      get ElTable() {\n        return ElTable;\n      },\n      get ElTableColumn() {\n        return ElTableColumn;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElInputNumber() {\n        return ElInputNumber;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","ElTable","ElTableColumn","ElButton","ElInputNumber","cartItems","id","name","price","quantity","stock","image","totalPrice","value","reduce","total","item","updateQuantity","console","log","removeItem","itemId","index","findIndex","splice","checkout"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"120\">\n        <template #default=\"scope\">\n          <img :src=\"scope.row.image\" alt=\"商品图片\" class=\"cart-image\" />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\" />\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\" />\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"100\">\n        <template #default=\"scope\">\n          <El-input-number\n            v-model=\"scope.row.quantity\"\n            @change=\"updateQuantity(scope.row)\"\n            :min=\"1\"\n            :max=\"scope.row.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.id)\"\n            >删除</El-button\n          >\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>总计: ¥{{ totalPrice.toFixed(2) }}</h2>\n      <El-button type=\"primary\" @click=\"checkout\">去结算</El-button>\n    </div>\n\n    <p v-if=\"!cartItems.length\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from \"vue\";\nimport { ElTable, ElTableColumn, ElButton, ElInputNumber } from \"element-plus\";\n\nconst cartItems = ref([\n  {\n    id: 1,\n    name: \"苹果13\",\n    price: 6999,\n    quantity: 1,\n    stock: 5,\n    image: \"/assets/苹果13.png\",\n  },\n  {\n    id: 2,\n    name: \"微软二合一ipad\",\n    price: 3488,\n    quantity: 2,\n    stock: 10,\n    image: \"/assets/微软二合一ipad.png\",\n  },\n  // 可以添加更多商品\n]);\n\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    return total + item.price * item.quantity;\n  }, 0);\n});\n\nconst updateQuantity = (item) => {\n  // 这里可以实现动态更新商品数量的逻辑，比如更新后端数据\n  console.log(\"商品数量更新: \", item);\n};\n\nconst removeItem = (itemId) => {\n  const index = cartItems.value.findIndex((item) => item.id === itemId);\n  if (index !== -1) {\n    cartItems.value.splice(index, 1);\n  }\n};\n\nconst checkout = () => {\n  // 跳转到结算页面或处理结算逻辑\n  console.log(\"去结算\", cartItems.value);\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n</style>\n"],"mappings":"AAwCA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,OAAO,EAAEC,aAAa,EAAEC,QAAQ,EAAEC,aAAa,QAAQ,cAAc;;;;;;;IAE9E,MAAMC,SAAS,GAAGN,GAAG,CAAC,CACpB;MACEO,EAAE,EAAE,CAAC;MACLC,IAAI,EAAE,MAAM;MACZC,KAAK,EAAE,IAAI;MACXC,QAAQ,EAAE,CAAC;MACXC,KAAK,EAAE,CAAC;MACRC,KAAK,EAAE;IACT,CAAC,EACD;MACEL,EAAE,EAAE,CAAC;MACLC,IAAI,EAAE,WAAW;MACjBC,KAAK,EAAE,IAAI;MACXC,QAAQ,EAAE,CAAC;MACXC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE;IACT;IACA;IAAA,CACD,CAAC;IAEF,MAAMC,UAAU,GAAGZ,QAAQ,CAAC,MAAM;MAChC,OAAOK,SAAS,CAACQ,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,OAAOD,KAAK,GAAGC,IAAI,CAACR,KAAK,GAAGQ,IAAI,CAACP,QAAQ;MAC3C,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;IAEF,MAAMQ,cAAc,GAAID,IAAI,IAAK;MAC/B;MACAE,OAAO,CAACC,GAAG,CAAC,UAAU,EAAEH,IAAI,CAAC;IAC/B,CAAC;IAED,MAAMI,UAAU,GAAIC,MAAM,IAAK;MAC7B,MAAMC,KAAK,GAAGjB,SAAS,CAACQ,KAAK,CAACU,SAAS,CAAEP,IAAI,IAAKA,IAAI,CAACV,EAAE,KAAKe,MAAM,CAAC;MACrE,IAAIC,KAAK,KAAK,CAAC,CAAC,EAAE;QAChBjB,SAAS,CAACQ,KAAK,CAACW,MAAM,CAACF,KAAK,EAAE,CAAC,CAAC;MAClC;IACF,CAAC;IAED,MAAMG,QAAQ,GAAGA,CAAA,KAAM;MACrB;MACAP,OAAO,CAACC,GAAG,CAAC,KAAK,EAAEd,SAAS,CAACQ,KAAK,CAAC;IACrC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}