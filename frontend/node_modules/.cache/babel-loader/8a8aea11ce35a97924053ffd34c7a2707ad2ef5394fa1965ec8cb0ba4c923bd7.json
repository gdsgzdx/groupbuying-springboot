{"ast":null,"code":"import { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { useStore } from \"vuex\";\nimport { ElMessage } from \"element-plus\";\nconst logo = \"/assets/logo.png\";\nexport default {\n  __name: 'LoginPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loginFormRef = ref(null);\n    const router = useRouter();\n    const store = useStore();\n\n    // 登录表单数据\n    const loginForm = reactive({\n      username: \"\",\n      password: \"\"\n    });\n\n    // 表单验证规则\n    const loginRules = {\n      username: [{\n        required: true,\n        message: \"请输入用户名\",\n        trigger: \"blur\"\n      }],\n      password: [{\n        required: true,\n        message: \"请输入密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        message: \"密码不能少于6位\",\n        trigger: \"blur\"\n      }]\n    };\n\n    // 加载状态\n    const isLoading = ref(false);\n\n    // 登录处理\n    const handleLogin = () => {\n      if (!loginFormRef.value) return;\n      loginFormRef.value.validate(async valid => {\n        if (valid) {\n          try {\n            isLoading.value = true;\n            const loginData = {\n              username: loginForm.username,\n              password: loginForm.password\n            };\n            const result = await store.dispatch(\"login\", loginData);\n            if (result && result.user) {\n              ElMessage.success(`欢迎回来，${result.user.nickname || result.user.username}`);\n              router.push(\"/\");\n            }\n          } catch (error) {\n            console.error(\"登录失败:\", error);\n            ElMessage.error(error.message || \"登录失败，请检查用户名和密码\");\n          } finally {\n            isLoading.value = false;\n          }\n        } else {\n          ElMessage.warning(\"请填写完整的登录信息\");\n          return false;\n        }\n      });\n    };\n\n    // 注册处理\n    const handleRegister = () => {\n      router.push({\n        name: \"Register\"\n      });\n    };\n\n    // 找回密码处理\n    const handleForgotPassword = () => {\n      router.push({\n        name: \"ForgetPassword\"\n      });\n    };\n    const __returned__ = {\n      logo,\n      loginFormRef,\n      router,\n      store,\n      loginForm,\n      loginRules,\n      isLoading,\n      handleLogin,\n      handleRegister,\n      handleForgotPassword,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","useStore","ElMessage","logo","loginFormRef","router","store","loginForm","username","password","loginRules","required","message","trigger","min","isLoading","handleLogin","value","validate","valid","loginData","result","dispatch","user","success","nickname","push","error","console","warning","handleRegister","name","handleForgotPassword"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/login/LoginPage.vue"],"sourcesContent":["<!-- frontend/src/views/login/LoginPage.vue -->\n<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">团团赚拼购</h1>\n      </div>\n\n      <El-form\n        ref=\"loginFormRef\"\n        :model=\"loginForm\"\n        :rules=\"loginRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"username\">\n          <El-input\n            v-model=\"loginForm.username\"\n            prefix-icon=\"User\"\n            placeholder=\"用户名\"\n            clearable\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"password\">\n          <El-input\n            v-model=\"loginForm.password\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"密码\"\n            show-password\n            @keyup.enter=\"handleLogin\"\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button\n            type=\"primary\"\n            class=\"login-btn\"\n            :loading=\"isLoading\"\n            :disabled=\"isLoading\"\n            @click=\"handleLogin\"\n          >\n            登录\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"handleRegister\">立即注册</El-link>\n          <El-link type=\"info\" @click=\"handleForgotPassword\">忘记密码</El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { useStore } from \"vuex\";\nimport { ElMessage } from \"element-plus\";\n\nconst logo = \"/assets/logo.png\";\nconst loginFormRef = ref(null);\nconst router = useRouter();\nconst store = useStore();\n\n// 登录表单数据\nconst loginForm = reactive({\n  username: \"\",\n  password: \"\",\n});\n\n// 表单验证规则\nconst loginRules = {\n  username: [\n    {\n      required: true,\n      message: \"请输入用户名\",\n      trigger: \"blur\",\n    },\n  ],\n  password: [\n    {\n      required: true,\n      message: \"请输入密码\",\n      trigger: \"blur\",\n    },\n    {\n      min: 6,\n      message: \"密码不能少于6位\",\n      trigger: \"blur\",\n    },\n  ],\n};\n\n// 加载状态\nconst isLoading = ref(false);\n\n// 登录处理\nconst handleLogin = () => {\n  if (!loginFormRef.value) return;\n  \n  loginFormRef.value.validate(async (valid) => {\n    if (valid) {\n      try {\n        isLoading.value = true;\n        const loginData = {\n          username: loginForm.username,\n          password: loginForm.password,\n        };\n        const result = await store.dispatch(\"login\", loginData);\n        if (result && result.user) {\n          ElMessage.success(\n            `欢迎回来，${result.user.nickname || result.user.username}`,\n          );\n          router.push(\"/\");\n        }\n      } catch (error) {\n        console.error(\"登录失败:\", error);\n        ElMessage.error(error.message || \"登录失败，请检查用户名和密码\");\n      } finally {\n        isLoading.value = false;\n      }\n    } else {\n      ElMessage.warning(\"请填写完整的登录信息\");\n      return false;\n    }\n  });\n};\n\n// 注册处理\nconst handleRegister = () => {\n  router.push({ name: \"Register\" });\n};\n\n// 找回密码处理\nconst handleForgotPassword = () => {\n  router.push({ name: \"ForgetPassword\" });\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(to right, #3494e6, #ec6ead);\n}\n\n.login-wrapper {\n  background: white;\n  padding: 30px;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  width: 400px;\n}\n\n.logo-title-container {\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n.logo {\n  width: 80px;\n  height: 80px;\n  margin-bottom: 10px;\n}\n\n.system-title {\n  font-size: 24px;\n  color: #303133;\n  margin: 0;\n}\n\n.login-form {\n  margin-top: 20px;\n}\n\n.login-btn {\n  width: 100%;\n}\n\n.login-extra {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 15px;\n}\n</style>\n"],"mappings":"AAyDA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,QAAQ,QAAQ,MAAM;AAC/B,SAASC,SAAS,QAAQ,cAAc;AAExC,MAAMC,IAAI,GAAG,kBAAkB;;;;;;;IAC/B,MAAMC,YAAY,GAAGL,GAAG,CAAC,IAAI,CAAC;IAC9B,MAAMM,MAAM,GAAGL,SAAS,CAAC,CAAC;IAC1B,MAAMM,KAAK,GAAGL,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMM,SAAS,GAAGT,QAAQ,CAAC;MACzBU,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,UAAU,GAAG;MACjBF,QAAQ,EAAE,CACR;QACEG,QAAQ,EAAE,IAAI;QACdC,OAAO,EAAE,QAAQ;QACjBC,OAAO,EAAE;MACX,CAAC,CACF;MACDJ,QAAQ,EAAE,CACR;QACEE,QAAQ,EAAE,IAAI;QACdC,OAAO,EAAE,OAAO;QAChBC,OAAO,EAAE;MACX,CAAC,EACD;QACEC,GAAG,EAA