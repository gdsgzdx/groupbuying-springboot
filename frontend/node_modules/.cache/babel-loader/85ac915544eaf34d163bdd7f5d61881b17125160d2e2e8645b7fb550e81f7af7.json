{"ast":null,"code":"import { computed, ref, onMounted } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport { useRoute } from \"vue-router\";\nimport axios from \"axios\";\nexport default {\n  __name: 'UserPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n\n    // 编辑对话框相关\n    const editDialogVisible = ref(false);\n    const editForm = ref({\n      avatar: \"\",\n      nickname: \"\",\n      phone: \"\",\n      address: \"\"\n    });\n\n    // 上传头像相关\n    const uploadHeaders = computed(() => {\n      const token = localStorage.getItem(\"token\");\n      console.log(\"当前token:\", token);\n      return {\n        Authorization: `Bearer ${token}`\n      };\n    });\n\n    // 头像上传前的验证\n    const beforeAvatarUpload = file => {\n      const isImage = file.type.startsWith(\"image/\");\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isImage) {\n        ElMessage.error(\"上传头像图片只能是图片格式!\");\n        return false;\n      }\n      if (!isLt2M) {\n        ElMessage.error(\"上传头像图片大小不能超过 2MB!\");\n        return false;\n      }\n      return true;\n    };\n\n    // 头像上传成功处理\n    const handleAvatarSuccess = response => {\n      console.log(\"头像上传响应:\", response);\n      if (response.code === 200) {\n        editForm.value.avatar = response.data;\n        // 更新Vuex store中的用户头像\n        store.commit(\"setUserAvatar\", response.data);\n        ElMessage.success(\"头像上传成功\");\n      } else {\n        ElMessage.error(\"头像上传失败：\" + response.message);\n      }\n    };\n\n    // 计算用户信息\n    const userNickname = computed(() => store.getters.userNickname);\n    const userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\n    const userAddress = computed(() => store.getters.userAddress || \"未提供\");\n    const userBalance = computed(() => store.getters.userBalance || 0);\n    const userAvatar = computed(() => store.getters.userAvatar ? `http://localhost:5000${store.getters.userAvatar}` : \"/assets/avatar.png\");\n    const comments = ref([{\n      id: 1,\n      content: \"这个产品很不错！\",\n      likes: 10\n    }, {\n      id: 2,\n      content: \"相当满意的购物体验。\",\n      likes: 5\n    }]);\n    // 在组件挂载时获取账户余额\n    onMounted(async () => {\n      await store.getters.userBalance; // 调用 Action\n    });\n\n    // 显示编辑对话框\n    const showEditDialog = () => {\n      editForm.value = {\n        avatar: userAvatar.value,\n        nickname: userNickname.value,\n        phone: userPhone.value,\n        address: userAddress.value\n      };\n      editDialogVisible.value = true;\n    };\n\n    // 保存资料\n    const saveProfile = async () => {\n      try {\n        await store.dispatch(\"updateUserProfile\", {\n          avatar: editForm.value.avatar,\n          nickname: editForm.value.nickname,\n          phone: editForm.value.phone,\n          address: editForm.value.address\n        });\n        ElMessage.success(\"资料更新成功\");\n        editDialogVisible.value = false;\n      } catch (error) {\n        ElMessage.error(\"资料更新失败：\" + error.message);\n      }\n    };\n    const viewFavorites = () => router.push({\n      name: \"MyFavorites\"\n    });\n    const likeComment = commentId => {\n      const comment = comments.value.find(c => c.id === commentId);\n      if (comment) {\n        comment.likes += 1;\n        console.log(`点赞了评论：${commentId}`);\n      }\n    };\n    const logout = () => {\n      console.log(\"用户已注销\");\n      store.commit(\"clearUser\");\n      router.push({\n        name: \"Login\"\n      });\n    };\n    const goToHome = () => {\n      router.push(\"/\");\n    };\n    const userId = ref(route.params.id);\n    const userInfo = ref({});\n    const posts = ref([]);\n    const newComment = ref(\"\");\n    const loading = ref(false);\n\n    // 获取用户信息\n    const fetchUserInfo = async () => {\n      try {\n        const response = await axios.get(`/api/users/${userId.value}`);\n        userInfo.value = response.data;\n      } catch (error) {\n        ElMessage.error(\"获取用户信息失败\");\n      }\n    };\n\n    // 获取用户帖子\n    const fetchUserPosts = async () => {\n      try {\n        loading.value = true;\n        const response = await axios.get(`/api/posts/user/${userId.value}`, {\n          params: {\n            page: 0,\n            size: 10\n          }\n        });\n        posts.value = response.data.content.map(post => ({\n          ...post,\n          showCommentInput: false\n        }));\n      } catch (error) {\n        ElMessage.error(\"获取帖子列表失败\");\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 提交评论\n    const submitComment = async postId => {\n      if (!newComment.value.trim()) {\n        ElMessage.warning(\"评论内容不能为空\");\n        return;\n      }\n      try {\n        await axios.post(`/api/posts/${postId}/comments`, newComment.value);\n        ElMessage.success(\"评论成功\");\n        newComment.value = \"\";\n        // 重新加载帖子列表以更新评论\n        await fetchUserPosts();\n      } catch (error) {\n        ElMessage.error(\"评论失败\");\n      }\n    };\n\n    // 点赞/取消点赞\n    const toggleLike = async postId => {\n      try {\n        await axios.post(`/api/posts/${postId}/like`);\n        // 重新加载帖子列表以更新点赞数\n        await fetchUserPosts();\n      } catch (error) {\n        ElMessage.error(\"操作失败\");\n      }\n    };\n\n    // 显示评论输入框\n    const showCommentInput = postId => {\n      posts.value = posts.value.map(post => ({\n        ...post,\n        showCommentInput: post.id === postId\n      }));\n    };\n\n    // 格式化日期\n    const formatDate = date => {\n      return new Date(date).toLocaleString();\n    };\n    onMounted(() => {\n      fetchUserInfo();\n      fetchUserPosts();\n    });\n    const __returned__ = {\n      store,\n      router,\n      route,\n      editDialogVisible,\n      editForm,\n      uploadHeaders,\n      beforeAvatarUpload,\n      handleAvatarSuccess,\n      userNickname,\n      userPhone,\n      userAddress,\n      userBalance,\n      userAvatar,\n      comments,\n      showEditDialog,\n      saveProfile,\n      viewFavorites,\n      likeComment,\n      logout,\n      goToHome,\n      userId,\n      userInfo,\n      posts,\n      newComment,\n      loading,\n      fetchUserInfo,\n      fetchUserPosts,\n      submitComment,\n      toggleLike,\n      showCommentInput,\n      formatDate,\n      computed,\n      ref,\n      onMounted,\n      get useStore() {\n        return useStore;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get useRoute() {\n        return useRoute;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","useStore","useRouter","ElMessage","useRoute","axios","store","router","route","editDialogVisible","editForm","avatar","nickname","phone","address","uploadHeaders","token","localStorage","getItem","console","log","Authorization","beforeAvatarUpload","file","isImage","type","startsWith","isLt2M","size","error","handleAvatarSuccess","response","code","value","data","commit","success","message","userNickname","getters","userPhone","userPhoneNumber","userAddress","userBalance","userAvatar","comments","id","content","likes","showEditDialog","saveProfile","dispatch","viewFavorites","push","name","likeComment","commentId","comment","find","c","logout","goToHome","userId","params","userInfo","posts","newComment","loading","fetchUserInfo","get","fetchUserPosts","page","map","post","showCommentInput","submitComment","postId","trim","warning","toggleLike","formatDate","date","Date","toLocaleString"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/user/UserPage.vue"],"sourcesContent":["<template>\n  <div class=\"user-page\">\n    <div class=\"back-home\">\n      <el-button type=\"primary\" @click=\"goToHome\">返回首页</el-button>\n    </div>\n    <h1 class=\"page-title\">用户中心</h1>\n    <p class=\"welcome-message\">欢迎回来，{{ userNickname }}</p>\n\n    <div class=\"user-info card\">\n      <h2>个人信息</h2>\n      <img\n        v-if=\"userAvatar\"\n        :src=\"userAvatar\"\n        alt=\"用户头像\"\n        class=\"user-avatar\"\n      />\n      <ul>\n        <li>昵称：{{ userNickname }}</li>\n        <li>手机：{{ userPhone }}</li>\n        <li>地址：{{ userAddress }}</li>\n        <li>\n          账户余额：¥{{ userBalance.toFixed(2) }}\n          <span class=\"balance-warning\"\n            >（账户余额变更后需要退出账号重新登录才能刷新）</span\n          >\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"user-actions\">\n      <El-button type=\"primary\" @click=\"showEditDialog\" class=\"action-button\"\n        >编辑资料</El-button\n      >\n      <El-button type=\"warning\" @click=\"viewFavorites\" class=\"action-button\"\n        >我的收藏</El-button\n      >\n      <El-button type=\"danger\" @click=\"logout\" class=\"action-button\"\n        >注销登录</El-button\n      >\n    </div>\n\n    <!-- 编辑资料对话框 -->\n    <El-dialog\n      v-model=\"editDialogVisible\"\n      title=\"编辑资料\"\n      width=\"500px\"\n      :close-on-click-modal=\"false\"\n    >\n      <El-form :model=\"editForm\" label-width=\"80px\">\n        <El-form-item label=\"头像\">\n          <div class=\"avatar-upload\">\n            <img\n              v-if=\"editForm.avatar\"\n              :src=\"editForm.avatar\"\n              class=\"avatar-preview\"\n              alt=\"用户头像\"\n            />\n            <El-upload\n              class=\"avatar-uploader\"\n              action=\"http://localhost:5000/api/user/upload-avatar\"\n              :show-file-list=\"false\"\n              :on-success=\"handleAvatarSuccess\"\n              :before-upload=\"beforeAvatarUpload\"\n              :headers=\"uploadHeaders\"\n              :with-credentials=\"true\"\n            >\n              <El-button type=\"primary\">上传头像</El-button>\n            </El-upload>\n          </div>\n        </El-form-item>\n\n        <El-form-item label=\"昵称\">\n          <El-input v-model=\"editForm.nickname\" placeholder=\"请输入昵称\" />\n        </El-form-item>\n\n        <El-form-item label=\"手机\">\n          <El-input v-model=\"editForm.phone\" placeholder=\"请输入手机号码\" />\n        </El-form-item>\n\n        <El-form-item label=\"地址\">\n          <El-input v-model=\"editForm.address\" placeholder=\"请输入地址\" />\n        </El-form-item>\n      </El-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <El-button @click=\"editDialogVisible = false\">取消</El-button>\n          <El-button type=\"primary\" @click=\"saveProfile\">保存</El-button>\n        </span>\n      </template>\n    </El-dialog>\n\n    <div class=\"user-community card\">\n      <h2>社区互动</h2>\n      <div v-if=\"comments.length === 0\">暂无参与的评论。</div>\n      <ul>\n        <li v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\n          <p>{{ comment.content }}</p>\n          <p>\n            点赞数：{{ comment.likes }}\n            <El-button @click=\"likeComment(comment.id)\" class=\"like-button\"\n              >点赞</El-button\n            >\n          </p>\n        </li>\n      </ul>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { computed, ref, onMounted } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport { useRoute } from \"vue-router\";\nimport axios from \"axios\";\n\nconst store = useStore();\nconst router = useRouter();\nconst route = useRoute();\n\n// 编辑对话框相关\nconst editDialogVisible = ref(false);\nconst editForm = ref({\n  avatar: \"\",\n  nickname: \"\",\n  phone: \"\",\n  address: \"\",\n});\n\n// 上传头像相关\nconst uploadHeaders = computed(() => {\n  const token = localStorage.getItem(\"token\");\n  console.log(\"当前token:\", token);\n  return {\n    Authorization: `Bearer ${token}`,\n  };\n});\n\n// 头像上传前的验证\nconst beforeAvatarUpload = (file) => {\n  const isImage = file.type.startsWith(\"image/\");\n  const isLt2M = file.size / 1024 / 1024 < 2;\n\n  if (!isImage) {\n    ElMessage.error(\"上传头像图片只能是图片格式!\");\n    return false;\n  }\n  if (!isLt2M) {\n    ElMessage.error(\"上传头像图片大小不能超过 2MB!\");\n    return false;\n  }\n  return true;\n};\n\n// 头像上传成功处理\nconst handleAvatarSuccess = (response) => {\n  console.log(\"头像上传响应:\", response);\n  if (response.code === 200) {\n    editForm.value.avatar = response.data;\n    // 更新Vuex store中的用户头像\n    store.commit(\"setUserAvatar\", response.data);\n    ElMessage.success(\"头像上传成功\");\n  } else {\n    ElMessage.error(\"头像上传失败：\" + response.message);\n  }\n};\n\n// 计算用户信息\nconst userNickname = computed(() => store.getters.userNickname);\nconst userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\nconst userAddress = computed(() => store.getters.userAddress || \"未提供\");\nconst userBalance = computed(() => store.getters.userBalance || 0);\nconst userAvatar = computed(() =>\n  store.getters.userAvatar\n    ? `http://localhost:5000${store.getters.userAvatar}`\n    : \"/assets/avatar.png\",\n);\nconst comments = ref([\n  { id: 1, content: \"这个产品很不错！\", likes: 10 },\n  { id: 2, content: \"相当满意的购物体验。\", likes: 5 },\n]);\n// 在组件挂载时获取账户余额\nonMounted(async () => {\n  await store.getters.userBalance; // 调用 Action\n});\n\n// 显示编辑对话框\nconst showEditDialog = () => {\n  editForm.value = {\n    avatar: userAvatar.value,\n    nickname: userNickname.value,\n    phone: userPhone.value,\n    address: userAddress.value,\n  };\n  editDialogVisible.value = true;\n};\n\n// 保存资料\nconst saveProfile = async () => {\n  try {\n    await store.dispatch(\"updateUserProfile\", {\n      avatar: editForm.value.avatar,\n      nickname: editForm.value.nickname,\n      phone: editForm.value.phone,\n      address: editForm.value.address,\n    });\n    ElMessage.success(\"资料更新成功\");\n    editDialogVisible.value = false;\n  } catch (error) {\n    ElMessage.error(\"资料更新失败：\" + error.message);\n  }\n};\n\nconst viewFavorites = () => router.push({ name: \"MyFavorites\" });\nconst likeComment = (commentId) => {\n  const comment = comments.value.find((c) => c.id === commentId);\n  if (comment) {\n    comment.likes += 1;\n    console.log(`点赞了评论：${commentId}`);\n  }\n};\nconst logout = () => {\n  console.log(\"用户已注销\");\n  store.commit(\"clearUser\");\n  router.push({ name: \"Login\" });\n};\n\nconst goToHome = () => {\n  router.push(\"/\");\n};\n\nconst userId = ref(route.params.id);\nconst userInfo = ref({});\nconst posts = ref([]);\nconst newComment = ref(\"\");\nconst loading = ref(false);\n\n// 获取用户信息\nconst fetchUserInfo = async () => {\n  try {\n    const response = await axios.get(`/api/users/${userId.value}`);\n    userInfo.value = response.data;\n  } catch (error) {\n    ElMessage.error(\"获取用户信息失败\");\n  }\n};\n\n// 获取用户帖子\nconst fetchUserPosts = async () => {\n  try {\n    loading.value = true;\n    const response = await axios.get(`/api/posts/user/${userId.value}`, {\n      params: {\n        page: 0,\n        size: 10,\n      },\n    });\n    posts.value = response.data.content.map((post) => ({\n      ...post,\n      showCommentInput: false,\n    }));\n  } catch (error) {\n    ElMessage.error(\"获取帖子列表失败\");\n  } finally {\n    loading.value = false;\n  }\n};\n\n// 提交评论\nconst submitComment = async (postId) => {\n  if (!newComment.value.trim()) {\n    ElMessage.warning(\"评论内容不能为空\");\n    return;\n  }\n\n  try {\n    await axios.post(`/api/posts/${postId}/comments`, newComment.value);\n    ElMessage.success(\"评论成功\");\n    newComment.value = \"\";\n    // 重新加载帖子列表以更新评论\n    await fetchUserPosts();\n  } catch (error) {\n    ElMessage.error(\"评论失败\");\n  }\n};\n\n// 点赞/取消点赞\nconst toggleLike = async (postId) => {\n  try {\n    await axios.post(`/api/posts/${postId}/like`);\n    //