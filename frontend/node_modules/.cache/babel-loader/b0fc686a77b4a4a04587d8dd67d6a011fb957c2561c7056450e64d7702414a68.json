{"ast":null,"code":"import { ref, onMounted } from \"vue\";\nimport * as echarts from \"echarts\";\n\n// 订单统计数据\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const orderStats = ref({\n      total: 1568,\n      success: 1342\n    });\n\n    // 最新拼购商品列表\n    const latestProducts = ref([{\n      id: \"PG20250107001\",\n      name: \"苹果14Pro max 256G\",\n      price: 6999,\n      status: \"ongoing\"\n    }, {\n      id: \"PG20250107002\",\n      name: \"小米智能电视 65寸\",\n      price: 3299,\n      status: \"success\"\n    }, {\n      id: \"PG20250107003\",\n      name: \"大疆无人机 mini3\",\n      price: 4599,\n      status: \"failed\"\n    }]);\n\n    // 获取状态标签类型\n    const getStatusType = status => {\n      const statusMap = {\n        ongoing: \"warning\",\n        success: \"success\",\n        failed: \"danger\"\n      };\n      return statusMap[status] || \"info\";\n    };\n\n    // 获取状态标签文字\n    const getStatusLabel = status => {\n      const statusLabel = {\n        ongoing: \"进行中\",\n        success: \"拼购成功\",\n        failed: \"拼购失败\"\n      };\n      return statusLabel[status] || \"未知\";\n    };\n\n    // 查看商品详情\n    const handleProductDetail = product => {\n      console.log(\"查看商品详情\", product);\n      // 可以跳转到商品详情页或打开详情弹窗\n    };\n\n    // 初始化图表\n    const initChart = () => {\n      const chartDom = document.getElementById(\"trend-chart\");\n      const myChart = echarts.init(chartDom);\n      const option = {\n        xAxis: {\n          type: \"category\",\n          data: [\"01\", \"02\", \"03\", \"04\", \"05\", \"06\", \"07\"]\n        },\n        yAxis: {\n          type: \"value\"\n        },\n        series: [{\n          data: [120, 200, 150, 80, 70, 110, 130],\n          type: \"line\",\n          smooth: true\n        }]\n      };\n      myChart.setOption(option);\n    };\n    onMounted(() => {\n      initChart();\n    });\n    const __returned__ = {\n      orderStats,\n      latestProducts,\n      getStatusType,\n      getStatusLabel,\n      handleProductDetail,\n      initChart,\n      ref,\n      onMounted,\n      get echarts() {\n        return echarts;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","echarts","orderStats","total","success","latestProducts","id","name","price","status","getStatusType","statusMap","ongoing","failed","getStatusLabel","statusLabel","handleProductDetail","product","console","log","initChart","chartDom","document","getElementById","myChart","init","option","xAxis","type","data","yAxis","series","smooth","setOption"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"home-container\">\n    <El-row :gutter=\"20\">\n      <El-col :span=\"6\">\n        <El-card shadow=\"hover\">\n          <template #header>\n            <div class=\"card-header\">\n              <span>今日数据</span>\n            </div>\n          </template>\n          <div class=\"data-item\">\n            <div class=\"data-label\">总拼购订单</div>\n            <div class=\"data-value\">{{ orderStats.total }}</div>\n          </div>\n          <div class=\"data-item\">\n            <div class=\"data-label\">成功拼购</div>\n            <div class=\"data-value success\">{{ orderStats.success }}</div>\n          </div>\n        </El-card>\n      </El-col>\n\n      <El-col :span=\"18\">\n        <El-card shadow=\"hover\">\n          <template #header>\n            <div class=\"card-header\">\n              <span>拼购趋势</span>\n            </div>\n          </template>\n          <!-- 这里可以放置图表 -->\n          <div id=\"trend-chart\" style=\"height: 300px\"></div>\n        </El-card>\n      </El-col>\n    </El-row>\n\n    <El-row :gutter=\"20\" style=\"margin-top: 20px\">\n      <El-col :span=\"24\">\n        <El-card shadow=\"hover\">\n          <template #header>\n            <div class=\"card-header\">\n              <span>最新拼购商品</span>\n            </div>\n          </template>\n          <El-table :data=\"latestProducts\" stripe>\n            <El-table-column\n              prop=\"id\"\n              label=\"商品ID\"\n              width=\"180\"\n            ></El-table-column>\n            <El-table-column prop=\"name\" label=\"商品名称\"></El-table-column>\n            <El-table-column prop=\"price\" label=\"价格\"></El-table-column>\n            <El-table-column prop=\"status\" label=\"状态\">\n              <template #default=\"scope\">\n                <El-tag :type=\"getStatusType(scope.row.status)\">\n                  {{ getStatusLabel(scope.row.status) }}\n                </El-tag>\n              </template>\n            </El-table-column>\n            <El-table-column label=\"操作\">\n              <template #default=\"scope\">\n                <El-button\n                  size=\"small\"\n                  type=\"primary\"\n                  @click=\"handleProductDetail(scope.row)\"\n                >\n                  查看详情\n                </El-button>\n              </template>\n            </El-table-column>\n          </El-table>\n        </El-card>\n      </El-col>\n    </El-row>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from \"vue\";\nimport * as echarts from \"echarts\";\n\n// 订单统计数据\nconst orderStats = ref({\n  total: 1568,\n  success: 1342,\n});\n\n// 最新拼购商品列表\nconst latestProducts = ref([\n  {\n    id: \"PG20250107001\",\n    name: \"苹果14Pro max 256G\",\n    price: 6999,\n    status: \"ongoing\",\n  },\n  {\n    id: \"PG20250107002\",\n    name: \"小米智能电视 65寸\",\n    price: 3299,\n    status: \"success\",\n  },\n  {\n    id: \"PG20250107003\",\n    name: \"大疆无人机 mini3\",\n    price: 4599,\n    status: \"failed\",\n  },\n]);\n\n// 获取状态标签类型\nconst getStatusType = (status) => {\n  const statusMap = {\n    ongoing: \"warning\",\n    success: \"success\",\n    failed: \"danger\",\n  };\n  return statusMap[status] || \"info\";\n};\n\n// 获取状态标签文字\nconst getStatusLabel = (status) => {\n  const statusLabel = {\n    ongoing: \"进行中\",\n    success: \"拼购成功\",\n    failed: \"拼购失败\",\n  };\n  return statusLabel[status] || \"未知\";\n};\n\n// 查看商品详情\nconst handleProductDetail = (product) => {\n  console.log(\"查看商品详情\", product);\n  // 可以跳转到商品详情页或打开详情弹窗\n};\n\n// 初始化图表\nconst initChart = () => {\n  const chartDom = document.getElementById(\"trend-chart\");\n  const myChart = echarts.init(chartDom);\n\n  const option = {\n    xAxis: {\n      type: \"category\",\n      data: [\"01\", \"02\", \"03\", \"04\", \"05\", \"06\", \"07\"],\n    },\n    yAxis: {\n      type: \"value\",\n    },\n    series: [\n      {\n        data: [120, 200, 150, 80, 70, 110, 130],\n        type: \"line\",\n        smooth: true,\n      },\n    ],\n  };\n\n  myChart.setOption(option);\n};\n\nonMounted(() => {\n  initChart();\n});\n</script>\n\n<style scoped>\n.home-container {\n  padding: 20px;\n  background-color: #f5f5f5;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.data-item {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 10px;\n  padding: 10px;\n  background-color: #f9f9f9;\n  border-radius: 4px;\n}\n\n.data-label {\n  color: #666;\n}\n\n.data-value {\n  font-weight: bold;\n  color: #333;\n}\n\n.data-value.success {\n  color: #67c23a;\n}\n</style>\n"],"mappings":"AA4EA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,OAAO,KAAKC,OAAO,MAAM,SAAS;;AAElC;;;;;;;;IACA,MAAMC,UAAU,GAAGH,GAAG,CAAC;MACrBI,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE;IACX,CAAC,CAAC;;IAEF;IACA,MAAMC,cAAc,GAAGN,GAAG,CAAC,CACzB;MACEO,EAAE,EAAE,eAAe;MACnBC,IAAI,EAAE,kBAAkB;MACxBC,KAAK,EAAE,IAAI;MACXC,MAAM,EAAE;IACV,CAAC,EACD;MACEH,EAAE,EAAE,eAAe;MACnBC,IAAI,EAAE,YAAY;MAClBC,KAAK,EAAE,IAAI;MACXC,MAAM,EAAE;IACV,CAAC,EACD;MACEH,EAAE,EAAE,eAAe;MACnBC,IAAI,EAAE,aAAa;MACnBC,KAAK,EAAE,IAAI;MACXC,MAAM,EAAE;IACV,CAAC,CACF,CAAC;;IAEF;IACA,MAA