{"ast":null,"code":"import { ref, reactive } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport request from '@/utils/request';\nexport default {\n  name: 'LoginPage',\n  setup() {\n    const router = useRouter();\n    const loginForm = reactive({\n      username: '',\n      password: ''\n    });\n    const loginRules = {\n      username: [{\n        required: true,\n        message: '请输入用户名',\n        trigger: 'blur'\n      }],\n      password: [{\n        required: true,\n        message: '请输入密码',\n        trigger: 'blur'\n      }]\n    };\n    const loading = ref(false);\n    const loginFormRef = ref(null);\n    const handleLogin = async () => {\n      if (!loginFormRef.value) return;\n      try {\n        loading.value = true;\n        await loginFormRef.value.validate();\n        const response = await request({\n          url: '/api/auth/login',\n          method: 'post',\n          data: loginForm\n        });\n\n        // 保存 token 到 localStorage\n        localStorage.setItem('token', response.data);\n        ElMessage.success('登录成功');\n\n        // 跳转到首页\n        router.push('/');\n      } catch (error) {\n        console.error('登录失败:', error);\n        ElMessage.error(error.response?.data?.message || '登录失败，请检查用户名和密码');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loginForm,\n      loginRules,\n      loading,\n      loginFormRef,\n      handleLogin\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","useRouter","ElMessage","request","name","setup","router","loginForm","username","password","loginRules","required","message","trigger","loading","loginFormRef","handleLogin","value","validate","response","url","method","data","localStorage","setItem","success","push","error","console"],"sources":["D:\\在线拼团\\groupbuying-springboot\\frontend\\src\\views\\login\\LoginPage.vue"],"sourcesContent":["<!-- frontend/src/views/login/LoginPage.vue -->\n<template>\n  <div class=\"login-container\">\n    <el-form\n      ref=\"loginForm\"\n      :model=\"loginForm\"\n      :rules=\"loginRules\"\n      class=\"login-form\"\n      auto-complete=\"on\"\n      label-position=\"left\"\n    >\n      <div class=\"title-container\">\n        <h3 class=\"title\">登录</h3>\n      </div>\n\n      <el-form-item prop=\"username\">\n        <el-input\n          ref=\"username\"\n          v-model=\"loginForm.username\"\n          placeholder=\"用户名\"\n          name=\"username\"\n          type=\"text\"\n          auto-complete=\"on\"\n        />\n      </el-form-item>\n\n      <el-form-item prop=\"password\">\n        <el-input\n          ref=\"password\"\n          v-model=\"loginForm.password\"\n          placeholder=\"密码\"\n          name=\"password\"\n          type=\"password\"\n          auto-complete=\"on\"\n          @keyup.enter=\"handleLogin\"\n        />\n      </el-form-item>\n\n      <el-button\n        :loading=\"loading\"\n        type=\"primary\"\n        style=\"width: 100%; margin-bottom: 30px\"\n        @click=\"handleLogin\"\n      >\n        登录\n      </el-button>\n\n      <div class=\"register-link\">\n        <router-link to=\"/register\">没有账号？立即注册</router-link>\n      </div>\n    </el-form>\n  </div>\n</template>\n\n<script>\nimport { ref, reactive } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { ElMessage } from 'element-plus'\nimport request from '@/utils/request'\n\nexport default {\n  name: 'LoginPage',\n  setup() {\n    const router = useRouter()\n    const loginForm = reactive({\n      username: '',\n      password: ''\n    })\n\n    const loginRules = {\n      username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n      password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n    }\n\n    const loading = ref(false)\n    const loginFormRef = ref(null)\n\n    const handleLogin = async () => {\n      if (!loginFormRef.value) return\n\n      try {\n        loading.value = true\n        await loginFormRef.value.validate()\n\n        const response = await request({\n          url: '/api/auth/login',\n          method: 'post',\n          data: loginForm\n        })\n\n        // 保存 token 到 localStorage\n        localStorage.setItem('token', response.data)\n        ElMessage.success('登录成功')\n        \n        // 跳转到首页\n        router.push('/')\n      } catch (error) {\n        console.error('登录失败:', error)\n        ElMessage.error(error.response?.data?.message || '登录失败，请检查用户名和密码')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      loginForm,\n      loginRules,\n      loading,\n      loginFormRef,\n      handleLogin\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.login-container {\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  background-color: #f3f3f3;\n\n  .login-form {\n    width: 400px;\n    max-width: 100%;\n    padding: 35px;\n    margin: 0 auto;\n    background: #ffffff;\n    border-radius: 6px;\n    box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  }\n\n  .title-container {\n    text-align: center;\n    margin-bottom: 30px;\n\n    .title {\n      font-size: 26px;\n      color: #333;\n      margin: 0;\n      font-weight: bold;\n    }\n  }\n\n  .register-link {\n    text-align: center;\n    font-size: 14px;\n    \n    a {\n      color: #409EFF;\n      text-decoration: none;\n      \n      &:hover {\n        text-decoration: underline;\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AAuDA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,SAAQ,QAAS,cAAa;AACvC,OAAOC,OAAM,MAAO,iBAAgB;AAEpC,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAMM,SAAQ,GAAIP,QAAQ,CAAC;MACzBQ,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ,CAAC;IAED,MAAMC,UAAS,GAAI;MACjBF,QAAQ,EAAE,CAAC;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,CAAC;MAClEJ,QAAQ,EAAE,CAAC;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QA