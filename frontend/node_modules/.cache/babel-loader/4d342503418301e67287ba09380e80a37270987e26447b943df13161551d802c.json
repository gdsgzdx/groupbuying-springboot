{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { useRouter } from \"vue-router\"; // 导入 vue-router\nimport { ElMessage, ElMessageBox } from \"element-plus\"; // 导入提示消息组件和消息框组件\n\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const cartItems = ref([]); // 初始化购物车项\n\n    // 获取路由实例\n    const router = useRouter();\n\n    // 总计计算\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n        const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n        return total + price * quantity;\n      }, 0);\n    });\n\n    // 获取购物车数据的函数\n    const fetchCartItems = async () => {\n      try {\n        const token = localStorage.getItem(\"token\");\n        if (!token) {\n          console.error(\"未登录\");\n          cartItems.value = [];\n          return;\n        }\n        const response = await axios.get(\"http://localhost:5000/api/cart\", {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        if (response.data.code === 200 && Array.isArray(response.data.data)) {\n          cartItems.value = response.data.data.map(item => ({\n            id: item.id,\n            product_id: item.productId,\n            quantity: item.quantity,\n            cartProduct: {\n              id: item.productId,\n              name: item.productName,\n              price: item.price,\n              imageUrl: item.imageUrl\n            }\n          }));\n        } else {\n          cartItems.value = [];\n        }\n      } catch (error) {\n        console.error(\"获取购物车数据失败:\", error);\n        cartItems.value = [];\n      }\n    };\n\n    // 组件加载时获取数据\n    onMounted(() => {\n      fetchCartItems();\n    });\n\n    // 更新商品数量\n    const updateQuantity = async item => {\n      try {\n        const token = localStorage.getItem(\"token\");\n        if (!token) {\n          ElMessage.error(\"请先登录\");\n          return;\n        }\n        const response = await axios.put(`http://localhost:5000/api/cart?productId=${item.product_id}&quantity=${item.quantity}`, {}, {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        if (response.data.code === 200) {\n          ElMessage.success(\"数量更新成功\");\n          fetchCartItems(); // 重新获取购物车数据\n        } else {\n          ElMessage.error(\"数量更新失败: \" + response.data.message);\n        }\n      } catch (error) {\n        console.error(\"更新数量失败:\", error);\n        ElMessage.error(\"更新数量失败: \" + (error.response?.data?.message || error.message));\n      }\n    };\n\n    // 删除商品\n    const removeItem = async productId => {\n      try {\n        const token = localStorage.getItem(\"token\");\n        if (!token) {\n          ElMessage.error(\"请先登录\");\n          return;\n        }\n        const response = await axios.delete(`http://localhost:5000/api/cart?productId=${productId}`, {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        if (response.data.code === 200) {\n          cartItems.value = cartItems.value.filter(item => item.product_id !== productId);\n          ElMessage.success(\"商品删除成功\");\n        } else {\n          ElMessage.error(\"商品删除失败\");\n        }\n      } catch (error) {\n        console.error(\"删除商品失败:\", error);\n        ElMessage.error(\"删除商品失败\");\n      }\n    };\n\n    // 返回首页功能\n    const goHome = () => {\n      router.push(\"/\");\n    };\n\n    // 结算功能\n    const checkout = async () => {\n      if (!cartItems.value.length) {\n        ElMessage.warning(\"购物车是空的\");\n        return;\n      }\n      try {\n        const token = localStorage.getItem(\"token\");\n        const userId = localStorage.getItem(\"userId\");\n        if (!token || !userId) {\n          ElMessage.error(\"请先登录\");\n          return;\n        }\n\n        // 显示支付密码输入框\n        const paymentPassword = await ElMessageBox.prompt(\"请输入支付密码\", \"支付确认\", {\n          confirmButtonText: \"确定\",\n          cancelButtonText: \"取消\",\n          inputType: \"password\",\n          inputPattern: /.+/,\n          inputErrorMessage: \"支付密码不能为空\"\n        }).catch(() => {\n          return {\n            action: \"cancel\"\n          };\n        });\n        if (paymentPassword.action === \"cancel\") {\n          return;\n        }\n\n        // 为每个商品创建订单\n        for (const item of cartItems.value) {\n          const orderData = {\n            userId: userId,\n            productId: item.product_id,\n            quantity: item.quantity,\n            totalAmount: (item.quantity * parseFloat(item.cartProduct.price)).toFixed(2),\n            paymentPassword: paymentPassword.value\n          };\n          console.log(\"创建订单数据:\", {\n            ...orderData,\n            paymentPassword: \"***\"\n          });\n          const response = await axios.post(\"http://localhost:5000/api/orders\", orderData, {\n            headers: {\n              Authorization: `Bearer ${token}`,\n              \"Content-Type\": \"application/json\"\n            }\n          });\n          if (response.data.code !== 200) {\n            throw new Error(response.data.message || \"创建订单失败\");\n          }\n        }\n        ElMessage.success(\"订单创建成功！\");\n        // 清空购物车\n        await clearCart();\n        // 跳转到订单页面\n        router.push(\"/orders\");\n      } catch (error) {\n        console.error(\"结算时发生错误:\", error);\n        ElMessage.error(error.response?.data?.message || error.message || \"结算失败，请稍后重试\");\n      }\n    };\n\n    // 清空购物车\n    const clearCart = async () => {\n      try {\n        const token = localStorage.getItem(\"token\");\n        if (!token) return;\n        await axios.delete(\"http://localhost:5000/api/cart/clear\", {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n      } catch (error) {\n        console.error(\"清空购物车失败:\", error);\n      }\n    };\n    const __returned__ = {\n      cartItems,\n      router,\n      totalPrice,\n      fetchCartItems,\n      updateQuantity,\n      removeItem,\n      goHome,\n      checkout,\n      clearCart,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","useRouter","ElMessage","ElMessageBox","cartItems","router","totalPrice","value","reduce","total","item","price","parseFloat","cartProduct","quantity","parseInt","fetchCartItems","token","localStorage","getItem","console","error","response","get","headers","Authorization","data","code","Array","isArray","map","id","product_id","productId","name","productName","imageUrl","updateQuantity","put","success","message","removeItem","delete","filter","goHome","push","checkout","length","warning","userId","paymentPassword","prompt","confirmButtonText","cancelButtonText","inputType","inputPattern","inputErrorMessage","catch","action","orderData","totalAmount","toFixed","log","post","Error","clearCart"],"sources":["D:/在线拼团/groupbuying-springboot/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"150\">\n        <template #default=\"scope\">\n          <img\n            :src=\"scope.row.cartProduct.imageUrl\"\n            alt=\"商品图片\"\n            class=\"cart-image\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\">\n        <template #default=\"scope\">\n          <span class=\"product-name\">{{ scope.row.cartProduct.name }}</span>\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\">\n        <template #default=\"scope\">\n          <span class=\"product-price\"\n            >¥{{ parseFloat(scope.row.cartProduct.price).toFixed(2) }}</span\n          >\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"160\">\n        <template #default=\"scope\">\n          <El-input-number\n            v-model=\"scope.row.quantity\"\n            @change=\"updateQuantity(scope.row)\"\n            :min=\"1\"\n            :max=\"scope.row.cartProduct.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.product_id)\"\n            >删除</El-button\n          >\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>\n        总计: <span class=\"total-price\">¥{{ totalPrice.toFixed(2) }}</span>\n      </h2>\n      <div class=\"button-group\">\n        <El-button class=\"checkout-button\" type=\"primary\" @click=\"checkout\"\n          >去结算</El-button\n        >\n        <El-button type=\"default\" @click=\"goHome\">返回首页</El-button>\n      </div>\n    </div>\n\n    <p v-if=\"!cartItems.length\" class=\"empty-cart\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { useRouter } from \"vue-router\"; // 导入 vue-router\nimport { ElMessage, ElMessageBox } from \"element-plus\"; // 导入提示消息组件和消息框组件\n\nconst cartItems = ref([]); // 初始化购物车项\n\n// 获取路由实例\nconst router = useRouter();\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    const price = parseFloat(item.cartProduct.price) || 0; // 确保 price 为数字\n    const quantity = parseInt(item.quantity) || 0; // 确保 quantity 为数字\n    return total + price * quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const token = localStorage.getItem(\"token\");\n    if (!token) {\n      console.error(\"未登录\");\n      cartItems.value = [];\n      return;\n    }\n\n    const response = await axios.get(\"http://localhost:5000/api/cart\", {\n      headers: {\n        Authorization: `Bearer ${token}`,\n      },\n    });\n\n    if (response.data.code === 200 && Array.isArray(response.data.data)) {\n      cartItems.value = response.data.data.map((item) => ({\n        id: item.id,\n        product_id: item.productId,\n        quantity: item.quantity,\n        cartProduct: {\n          id: item.productId,\n          name: item.productName,\n          price: item.price,\n          imageUrl: item.imageUrl,\n        },\n      }));\n    } else {\n      cartItems.value = [];\n    }\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n    cartItems.value = [];\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\n// 更新商品数量\nconst updateQuantity = async (item) => {\n  try {\n    const token = localStorage.getItem(\"token\");\n    if (!token) {\n      ElMessage.error(\"请先登录\");\n      return;\n    }\n\n    const response = await axios.put(\n      `http://localhost:5000/api/cart?productId=${item.product_id}&quantity=${item.quantity}`,\n      {},\n      {\n        headers: {\n          Authorization: `Bearer ${token}`,\n        },\n      },\n    );\n\n    if (response.data.code === 200) {\n      ElMessage.success(\"数量更新成功\");\n      fetchCartItems(); // 重新获取购物车数据\n    } else {\n      ElMessage.error(\"数量更新失败: \" + response.data.message);\n    }\n  } catch (error) {\n    console.error(\"更新数量失败:\", error);\n    ElMessage.error(\n      \"更新数量失败: \" + (error.response?.data?.message || error.message),\n    );\n  }\n};\n\n// 删除商品\nconst removeItem = async (productId) => {\n  try {\n    const token = localStorage.getItem(\"token\");\n    if (!token) {\n      ElMessage.error(\"请先登录\");\n      return;\n    }\n\n    const response = await axios.delete(\n      `http://localhost:5000/api/cart?productId=${productId}`,\n      {\n        headers: {\n          Authorization: `Bearer ${token}`,\n        },\n      },\n    );\n\n    if (response.data.code === 200) {\n      cartItems.value = cartItems.value.filter(\n        (item) => item.product_id !== productId,\n      );\n      ElMessage.success(\"商品删除成功\");\n    } else {\n      ElMessage.error(\"商品删除失败\");\n    }\n  } catch (error) {\n    console.error(\"删除商品失败:\", error);\n    ElMessage.error(\"删除商品失败\");\n  }\n};\n\n// 返回首页功能\nconst goHome = () => {\n  router.push(\"/\");\n};\n\n// 结算功能\nconst checkout = async () => {\n  if (!cartItems.value.length) {\n    ElMessage.warning(\"购物车是空的\");\n    return;\n  }\n\n  try {\n    const token = localStorage.getItem(\"token\");\n    const userId = localStorage.getItem(\"userId\");\n    if (!token || !userId) {\n      ElMessage.error(\"请先登录\");\n      return;\n    }\n\n    // 显示支付密码输入框\n    const paymentPassword = await ElMessageBox.prompt(\n      \"请输入支付密码\",\n      \"支付确认\",\n      {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        inputType: \"password\",\n        inputPattern: /.+/,\n        inputErrorMessage: \"支付密码不能为空\",\n      },\n    ).catch(() => {\n      return { action: \"cancel\" };\n    });\n\n    if (paymentPassword.action === \"cancel\") {\n      return;\n    }\n\n    // 为每个商品创建订单\n    for (const item of cartItems.value) {\n      const orderData = {\n        userId: userId,\n        productId: item.product_id,\n        quantity: item.quantity,\n        totalAmount: (\n          item.quantity * parseFloat(item.cartProduct.price)\n        ).toFixed(2),\n        paymentPassword: paymentPassword.value,\n      };\n\n      console.log(\"创建订单数据:\", { ...orderData, paymentPassword: \"***\" });\n\n      const response = await axios.post(\n        \"http://localhost:5000/api/orders\",\n        orderData,\n        {\n          headers: {\n            Authorization: `Bearer ${token}`,\n            \"Content-Type\": \"application/json\",\n          },\n        },\n      );\n\n      if (response.data.code !== 200) {\n        throw new Error(response.data.message || \"创建订单失败\");\n      }\n    }\n\n    ElMessage.success(\"订单创建成功！\");\n    // 清空购物车\n    await clearCart();\n    // 跳转到订单页面\n    router.push(\"/orders\");\n  } catch (error) {\n    console.error(\"结算时发生错误:\", error);\n    ElMessage.error(\n      error.response?.data?.message || error.message || \"结算失败，请稍后重试\",\n    );\n  }\n};\n\n// 清空购物车\nconst clearCart = async () => {\n  try {\n    const token = localStorage.getItem(\"token\");\n    if (!token) return;\n\n    await axios.delete(\"http://localhost:5000/api/cart/clear\", {\n      headers: {\n        Authorization: `Bearer ${token}`,\n      },\n    });\n  } catch (error) {\n    console.error(\"清空购物车失败:\", error);\n  }\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  background: #f9f9f9; /* 背景颜色 */\n  border-radius: 10px; /* 圆角 */\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  padding: 10px 20px;\n  background: #ffffff; /* 总计背景 */\n  border-radius: 5px;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* 阴影 */\n}\n\n.product-name {\n  font-weight: bold;\n  color: #333; /* 商品名称颜色 */\n}\n\n.product-price {\n  color: #e94e77; /* 价格颜色 */\n  font-weight: bold; /* 加粗 */\n}\n\n.total-price {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n\n.checkout-button {\n  padding: 10px 20px; /* 按钮内边距 */\n  font-size: 16px; /* 按钮字体大小 */\n}\n\n.empty-cart {\n  text-align: center;\n  color: #999; /* 空购物车提示颜色 */\n  font-style: italic; /* 斜体 */\n}\n\n.button-group {\n  display: flex; /* 使用 Flexbox 布局 */\n  gap: 10px; /* 按钮之间的间距 */\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n}\n</style>\n"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;AAC3B,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,SAAS,EAAEC,YAAY,QAAQ,cAAc,CAAC,CAAC;;;;;;;;IAExD,MAAMC,SAAS,GAAGP,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE3B;IACA,MAAMQ,MAAM,GAAGJ,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMK,UAAU,GAAGR,QAAQ,CAAC,MAAM;MAChC,OAAOM,SAAS,CAACG,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,MAAMC,KAAK,GAAGC,UAAU,CAACF,IAAI,CAACG,WAAW,CAACF,KAAK,CAAC,IAAI,CAAC,CAAC,CAAC;QACvD,MAAMG,QAAQ,GAAGC,QAAQ,CAACL,IAAI,CAACI,QAAQ,CAAC,IAAI,CAAC,CAAC,CAAC;QAC/C,OAAOL,KAAK,GAAGE,KAAK,GAAGG,QAAQ;MACjC,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;;IAEF;IACA,MAAME,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,KAAK,GAAGC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVG,OAAO,CAACC,KAAK,CAAC,KAAK,CAAC;UACpBjB,SAAS,CAACG,KAAK,GAAG,EAAE;UACpB;QACF;QAEA,MAAMe,QAAQ,GAAG,MAAMtB,KAAK,CAACuB,GAAG,CAAC,gCAAgC,EAAE;UACjEC,OAAO,EAAE;YACPC,aAAa,EAAE,UAAUR,KAAK;UAChC;QACF,CAAC,CAAC;QAEF,IAAIK,QAAQ,CAACI,IAAI,CAACC,IAAI,KAAK,GAAG,IAAIC,KAAK,CAACC,OAAO,CAACP,QAAQ,CAACI,IAAI,CAACA,IAAI,CAAC,EAAE;UACnEtB,SAAS,CAACG,KAAK,GAAGe,QAAQ,CAACI,IAAI,CAACA,IAAI,CAACI,GAAG,CAAEpB,IAAI,KAAM;YAClDqB,EAAE,EAAErB,IAAI,CAACqB,EAAE;YACXC,UAAU,EAAEtB,IAAI,CAACuB,SAAS;YAC1BnB,QAAQ,EAAEJ,IAAI,CAACI,QAAQ;YACvBD,WAAW,EAAE;cACXkB,EAAE,EAAErB,IAAI,CAACuB,SAAS;cAClBC,IAAI,EAAExB,IAAI,CAACyB,WAAW;cACtBxB,KAAK,EAAED,IAAI,CAACC,KAAK;cACjByB,QAAQ,EAAE1B,IAAI,CAAC0B;YACjB;UACF,CAAC,CAAC,CAAC;QACL,CAAC,MAAM;UACLhC,SAAS,CAACG,KAAK,GAAG,EAAE;QACtB;MACF,CAAC,CAAC,OAAOc,KAAK,EAAE;QACdD,OAAO,CAACC,KAAK,CAAC,YAAY,EAAEA,KAAK,CA