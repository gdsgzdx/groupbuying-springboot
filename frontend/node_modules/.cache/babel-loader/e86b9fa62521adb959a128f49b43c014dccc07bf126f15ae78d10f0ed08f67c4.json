{"ast":null,"code":"import { ref } from \"vue\";\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\nexport default {\n  __name: 'RegisterPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const registerForm = ref({\n      username: '',\n      phone: '',\n      verifyCode: '',\n      password: '',\n      confirmPassword: ''\n    });\n    const countDown = ref(0); // 用于验证码倒计时\n\n    const registerRules = {\n      username: [{\n        required: true,\n        message: '请输入用户名',\n        trigger: 'blur'\n      }],\n      phone: [{\n        required: true,\n        message: '请输入手机号',\n        trigger: 'blur'\n      }, {\n        pattern: /^[1][3-9][0-9]{9}$/,\n        message: '手机号格式不正确',\n        trigger: 'blur'\n      }],\n      verifyCode: [{\n        required: true,\n        message: '请输入验证码',\n        trigger: 'blur'\n      }],\n      password: [{\n        required: true,\n        message: '请输入密码',\n        trigger: 'blur'\n      }],\n      confirmPassword: [{\n        required: true,\n        message: '请确认密码',\n        trigger: 'blur'\n      }, {\n        validator: (rule, value, callback) => {\n          if (value !== registerForm.value.password) {\n            callback(new Error('两次密码输入不一致'));\n          } else {\n            callback();\n          }\n        },\n        trigger: 'blur'\n      }]\n    };\n\n    // 注册处理函数\n    const handleRegister = () => {\n      registerFormRef.value.validate(valid => {\n        if (valid) {\n          console.log('注册成功:', registerForm.value);\n          // 发送注册请求的逻辑\n        } else {\n          console.log('注册失败!');\n          return false;\n        }\n      });\n    };\n\n    // 发送验证码\n    const sendVerifyCode = () => {\n      if (registerForm.value.phone) {\n        console.log('发送验证码到', registerForm.value.phone);\n        // 实际的发送验证码逻辑\n        countDown.value = 60; // 60秒倒计时\n        const timer = setInterval(() => {\n          countDown.value--;\n          if (countDown.value <= 0) {\n            clearInterval(timer);\n          }\n        }, 1000);\n      } else {\n        alert('请输入手机号');\n      }\n    };\n    const __returned__ = {\n      registerForm,\n      countDown,\n      registerRules,\n      handleRegister,\n      sendVerifyCode,\n      ref,\n      get User() {\n        return User;\n      },\n      get Mobile() {\n        return Mobile;\n      },\n      get Lock() {\n        return Lock;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get logo() {\n        return logo;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","User","Mobile","Lock","ChatDotRound","logo","registerForm","username","phone","verifyCode","password","confirmPassword","countDown","registerRules","required","message","trigger","pattern","validator","rule","value","callback","Error","handleRegister","registerFormRef","validate","valid","console","log","sendVerifyCode","timer","setInterval","clearInterval","alert"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/RegisterPage.vue"],"sourcesContent":["<template>\n  <div class=\"register-container\">\n    <div class=\"register-wrapper\">\n      <div class=\"register-form-container\">\n        <div class=\"register-header\">\n          <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n          <h2>用户注册</h2>\n        </div>\n\n        <El-form\n            ref=\"registerFormRef\"\n            :model=\"registerForm\"\n            :rules=\"registerRules\"\n            class=\"register-form\"\n        >\n          <El-form-item prop=\"username\">\n            <El-input\n                v-model=\"registerForm.username\"\n                placeholder=\"用户名\"\n                clearable\n            >\n              <template #prefix>\n                <El-icon><User /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"phone\">\n            <El-input\n                v-model=\"registerForm.phone\"\n                placeholder=\"手机号\"\n                clearable\n            >\n              <template #prefix>\n                <El-icon><Mobile /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"verifyCode\" class=\"verify-code-item\">\n            <El-input\n                v-model=\"registerForm.verifyCode\"\n                placeholder=\"验证码\"\n                class=\"verify-code-input\"\n            >\n              <template #prefix>\n                <El-icon><ChatDotRound /></El-icon>\n              </template>\n              <template #append>\n                <El-button\n                    :disabled=\"countDown > 0\"\n                    type=\"primary\"\n                    plain\n                    @click=\"sendVerifyCode\"\n                >\n                  {{ countDown > 0 ? `重发(${countDown}s)` : \"获取验证码\" }}\n                </El-button>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"password\">\n            <El-input\n                v-model=\"registerForm.password\"\n                type=\"password\"\n                placeholder=\"密码\"\n                show-password\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"confirmPassword\">\n            <El-input\n                v-model=\"registerForm.confirmPassword\"\n                type=\"password\"\n                placeholder=\"确认密码\"\n                show-password\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item>\n            <El-button\n                type=\"primary\"\n                class=\"register-btn\"\n                round\n                block\n                @click=\"handleRegister\"\n            >\n              注 册\n            </El-button>\n          </El-form-item>\n\n          <div class=\"register-footer\">\n            <El-link type=\"primary\" @click=\"$router.push('/login')\">\n              已有账号？立即登录\n            </El-link>\n          </div>\n        </El-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from \"vue\";\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\n\nconst registerForm = ref({\n  username: '',\n  phone: '',\n  verifyCode: '',\n  password: '',\n  confirmPassword: '',\n});\n\nconst countDown = ref(0);  // 用于验证码倒计时\n\nconst registerRules = {\n  username: [\n    { required: true, message: '请输入用户名', trigger: 'blur' },\n  ],\n  phone: [\n    { required: true, message: '请输入手机号', trigger: 'blur' },\n    { pattern: /^[1][3-9][0-9]{9}$/, message: '手机号格式不正确', trigger: 'blur' },\n  ],\n  verifyCode: [\n    { required: true, message: '请输入验证码', trigger: 'blur' },\n  ],\n  password: [\n    { required: true, message: '请输入密码', trigger: 'blur' },\n  ],\n  confirmPassword: [\n    { required: true, message: '请确认密码', trigger: 'blur' },\n    { validator: (rule, value, callback) => {\n        if (value !== registerForm.value.password) {\n          callback(new Error('两次密码输入不一致'));\n        } else {\n          callback();\n        }\n      }, trigger: 'blur' },\n  ],\n};\n\n// 注册处理函数\nconst handleRegister = () => {\n  registerFormRef.value.validate((valid) => {\n    if (valid) {\n      console.log('注册成功:', registerForm.value);\n      // 发送注册请求的逻辑\n    } else {\n      console.log('注册失败!');\n      return false;\n    }\n  });\n};\n\n// 发送验证码\nconst sendVerifyCode = () => {\n  if (registerForm.value.phone) {\n    console.log('发送验证码到', registerForm.value.phone);\n    // 实际的发送验证码逻辑\n    countDown.value = 60; // 60秒倒计时\n    const timer = setInterval(() => {\n      countDown.value--;\n      if (countDown.value <= 0) {\n        clearInterval(timer);\n      }\n    }, 1000);\n  } else {\n    alert('请输入手机号');\n  }\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.register-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(135deg, #f3f4f6, #e4e7ec);\n}\n\n.register-wrapper {\n  background: white;\n  border-radius: 10px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n  padding: 30px;\n  width: 400px;\n}\n\n.register-header {\n  margin-bottom: 20px;\n  text-align: center;\n}\n\n.logo {\n  width: 80px;\n}\n\n.register-form {\n  max-width: 350px;\n  margin: 0 auto;\n}\n\n.register-btn {\n  margin-top: 20px;\n  padding: 10px;\n  font-size: 16px;\n}\n\n.register-footer {\n  margin-top: 20px;\n  text-align: center;\n}\n</style>"],"mappings":"AA+GA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,IAAI,EAAEC,MAAM,EAAEC,IAAI,EAAEC,YAAY,QAAQ,yBAAyB;AAC1E,OAAOC,IAAI,MAAM,mBAAmB;;;;;;;IAEpC,MAAMC,YAAY,GAAGN,GAAG,CAAC;MACvBO,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,UAAU,EAAE,EAAE;MACdC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE;IACnB,CAAC,CAAC;IAEF,MAAMC,SAAS,GAAGZ,GAAG,CAAC,CAAC,CAAC,CAAC,CAAE;;IAE3B,MAAMa,aAAa,GAAG;MACpBN,QAAQ,EAAE,CACR;QAAEO,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,CACvD;MACDR,KAAK,EAAE,CACL;QAAEM,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,EACtD;QAAEC,OAAO,EAAE,oBAAoB;QAAEF,OAAO,EAAE,UAAU;QAAEC,OAAO,EAAE;MAAO,CAAC,CACxE;MACDP,UAAU,EAAE,CACV;QAAEK,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,QAAQ;QAAEC,OAAO,EAAE;MAAO,CAAC,CACvD;MACDN,QAAQ,EAAE,CACR;QAAEI,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,CACtD;MACDL,eAAe,EAAE,CACf;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC,EACrD;QAAEE,SAAS,EAAEA,CAACC,IAAI,EAAEC,KAAK,EAAEC,QAAQ,KAAK;UACpC,IAA