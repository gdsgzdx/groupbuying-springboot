{"ast":null,"code":"import { computed, ref } from \"vue\"; // 导入 computed 和 ref\nimport { useStore } from \"vuex\"; // 导入 Vuex store\nimport { useRouter } from \"vue-router\"; // 引入 router\n\nexport default {\n  __name: 'UserPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore(); // 获取 Vuex store\n    const router = useRouter();\n\n    // 计算用户信息\n    const userNickname = computed(() => store.getters.userNickname);\n    const userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\n    const userBalance = computed(() => store.getters.userBalance || 0); // 从状态中获取账户余额\n\n    // 假设用户的评论数据\n    const comments = ref([{\n      id: 1,\n      content: \"这个产品很不错！\",\n      likes: 10\n    }, {\n      id: 2,\n      content: \"相当满意的购物体验。\",\n      likes: 5\n    }]);\n\n    // 编辑资料的方法\n    const editProfile = () => {\n      router.push({\n        name: \"EditProfile\"\n      }); // 跳转到编辑资料页面\n    };\n\n    // 查看订单的方法\n    const viewOrders = () => {\n      router.push({\n        name: \"MyOrders\"\n      }); // 跳转到我的订单页面\n    };\n\n    // 查看收藏的方法\n    const viewFavorites = () => {\n      router.push({\n        name: \"MyFavorites\"\n      }); // 跳转到我的收藏页面\n    };\n\n    // 点赞评论的方法\n    const likeComment = commentId => {\n      const comment = comments.value.find(c => c.id === commentId);\n      if (comment) {\n        comment.likes += 1; // 点赞数加一\n        console.log(`点赞了评论：${commentId}`);\n      }\n    };\n\n    // 注销登录的方法\n    const logout = () => {\n      console.log(\"用户已注销\");\n      store.commit(\"clearUser\"); // 清空用户信息\n      router.push({\n        name: \"Login\"\n      }); // 跳转到登录页面\n    };\n    const __returned__ = {\n      store,\n      router,\n      userNickname,\n      userPhone,\n      userBalance,\n      comments,\n      editProfile,\n      viewOrders,\n      viewFavorites,\n      likeComment,\n      logout,\n      computed,\n      ref,\n      get useStore() {\n        return useStore;\n      },\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","useRouter","store","router","userNickname","getters","userPhone","userPhoneNumber","userBalance","comments","id","content","likes","editProfile","push","name","viewOrders","viewFavorites","likeComment","commentId","comment","value","find","c","console","log","logout","commit"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/user/UserPage.vue"],"sourcesContent":["<template>\n  <div class=\"user-page\">\n    <h1>个人中心</h1>\n    <p>欢迎回来，{{ userNickname }}</p>\n\n    <div class=\"user-info\">\n      <h2>个人信息</h2>\n      <ul>\n        <li>昵称：{{ userNickname }}</li>\n        <li>手机：{{ userPhone }}</li>\n        <li>账户余额：¥{{ userBalance.toFixed(2) }}</li>\n      </ul>\n    </div>\n\n    <div class=\"user-actions\">\n      <El-button @click=\"editProfile\">编辑资料</El-button>\n      <El-button @click=\"viewOrders\">我的订单</El-button>\n      <El-button @click=\"viewFavorites\">我的收藏</El-button>\n      <El-button @click=\"logout\">注销登录</El-button>\n    </div>\n\n    <div class=\"user-community\">\n      <h2>社区互动</h2>\n      <div v-if=\"comments.length === 0\">暂无参与的评论。</div>\n      <ul>\n        <li v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\n          <p>{{ comment.content }}</p>\n          <p>\n            点赞数：{{ comment.likes }}\n            <El-button @click=\"likeComment(comment.id)\">点赞</El-button>\n          </p>\n        </li>\n      </ul>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { computed, ref } from \"vue\"; // 导入 computed 和 ref\nimport { useStore } from \"vuex\"; // 导入 Vuex store\nimport { useRouter } from \"vue-router\"; // 引入 router\n\nconst store = useStore(); // 获取 Vuex store\nconst router = useRouter();\n\n// 计算用户信息\nconst userNickname = computed(() => store.getters.userNickname);\nconst userPhone = computed(() => store.getters.userPhoneNumber || \"未提供\");\nconst userBalance = computed(() => store.getters.userBalance || 0); // 从状态中获取账户余额\n\n// 假设用户的评论数据\nconst comments = ref([\n  { id: 1, content: \"这个产品很不错！\", likes: 10 },\n  { id: 2, content: \"相当满意的购物体验。\", likes: 5 },\n]);\n\n// 编辑资料的方法\nconst editProfile = () => {\n  router.push({ name: \"EditProfile\" }); // 跳转到编辑资料页面\n};\n\n// 查看订单的方法\nconst viewOrders = () => {\n  router.push({ name: \"MyOrders\" }); // 跳转到我的订单页面\n};\n\n// 查看收藏的方法\nconst viewFavorites = () => {\n  router.push({ name: \"MyFavorites\" }); // 跳转到我的收藏页面\n};\n\n// 点赞评论的方法\nconst likeComment = (commentId) => {\n  const comment = comments.value.find((c) => c.id === commentId);\n  if (comment) {\n    comment.likes += 1; // 点赞数加一\n    console.log(`点赞了评论：${commentId}`);\n  }\n};\n\n// 注销登录的方法\nconst logout = () => {\n  console.log(\"用户已注销\");\n  store.commit(\"clearUser\"); // 清空用户信息\n  router.push({ name: \"Login\" }); // 跳转到登录页面\n};\n</script>\n\n<style scoped>\n.user-page {\n  padding: 20px;\n}\n\n.user-info,\n.user-community {\n  margin-bottom: 20px;\n\n  h2 {\n    margin-bottom: 10px;\n  }\n\n  ul {\n    list-style-type: none;\n    padding: 0;\n  }\n}\n\n.user-actions {\n  display: flex;\n  gap: 10px; /* 为按钮添加间距 */\n}\n\n.comment-item {\n  margin-top: 10px;\n  padding: 10px;\n  border: 1px solid #e0e0e0;\n  border-radius: 5px;\n}\n</style>\n"],"mappings":"AAsCA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK,CAAC,CAAC;AACrC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;AACjC,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;;;;;;;;IAExC,MAAMC,KAAK,GAAGF,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMG,MAAM,GAAGF,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMG,YAAY,GAAGN,QAAQ,CAAC,MAAMI,KAAK,CAACG,OAAO,CAACD,YAAY,CAAC;IAC/D,MAAME,SAAS,GAAGR,QAAQ,CAAC,MAAMI,KAAK,CAACG,OAAO,CAACE,eAAe,IAAI,KAAK,CAAC;IACxE,MAAMC,WAAW,GAAGV,QAAQ,CAAC,MAAMI,KAAK,CAACG,OAAO,CAACG,WAAW,IAAI,CAAC,CAAC,CAAC,CAAC;;IAEpE;IACA,MAAMC,QAAQ,GAAGV,GAAG,CAAC,CACnB;MAAEW,EAAE,EAAE,CAAC;MAAEC,OAAO,EAAE,UAAU;MAAEC,KAAK,EAAE;IAAG,CAAC,EACzC;MAAEF,EAAE,EAAE,CAAC;MAAEC,OAAO,EAAE,YAAY;MAAEC,KAAK,EAAE;IAAE,CAAC,CAC3C,CAAC;;IAEF;IACA,MAAMC,WAAW,GAAGA,CAAA,KAAM;MACxBV,MAAM,CAACW,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAc,CAAC,CAAC,CAAC,CAAC;IACxC,CAAC;;IAED;IACA,MAAMC,UAAU,GAAGA,CAAA,KAAM;MACvBb,MAAM,CAACW,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAW,CAAC,CAAC,CAAC,CAAC;IACrC,CAAC;;IAED;IACA,MAAME,aAAa,GAAGA,CAAA,KAAM;MAC1Bd,MAAM,CAACW,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAc,CAAC,CAAC,CAAC,CAAC;IACxC,CAAC;;IAED;IACA,MAAMG,WAAW,GAAIC,SAAS,IAAK;MACjC,MAAMC,OAAO,GAAGX,QAAQ,CAACY,KAAK,CAACC,IAAI,CAAEC,CAAC,IAAKA,CAAC,CAACb,EAAE,KAAKS,SAAS,CAAC;MAC9D,IAAIC,OAAO,EAAE;QACXA,OAAO,CAACR,KAAK,IAAI,CAAC,CAAC,CAAC;QACpBY,OAAO,CAACC,GAAG,CAAC,SAASN,SAAS,EAAE,CAAC;MACnC;IACF,CAAC;;IAED;IACA,MAAMO,MAAM,GAAGA,CAAA,KAAM;MACnBF,OAAO,CAACC,GAAG,CAAC,OAAO,CAAC;MACpBvB,KAAK,CAACyB,MAAM,CAAC,WAAW,CAAC,CAAC,CAAC;MAC3BxB,MAAM,CAACW,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAQ,CAAC,CAAC,CAAC,CAAC;IAClC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}