{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { ElTable, ElTableColumn, ElButton, ElInputNumber } from \"element-plus\";\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const cartItems = ref([]); // 初始化购物车项\n\n    // 总计计算\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        return total + item.price * item.quantity;\n      }, 0);\n    });\n\n    // 获取购物车数据的函数\n    const fetchCartItems = async () => {\n      try {\n        const userId = 1; // 这里是示例，您需要使用实际用户 ID\n        const response = await axios.get(`http://localhost:5000/api/cart/${userId}`); // 从后端获取购物车数据\n        cartItems.value = response.data; // 将获取到的数据赋值给 cartItems\n      } catch (error) {\n        console.error(\"获取购物车数据失败:\", error);\n      }\n    };\n\n    // 组件加载时获取数据\n    onMounted(() => {\n      fetchCartItems();\n    });\n    const updateQuantity = item => {\n      console.log(\"商品数量更新: \", item);\n    };\n    const removeItem = itemId => {\n      const index = cartItems.value.findIndex(item => item.id === itemId);\n      if (index !== -1) {\n        cartItems.value.splice(index, 1);\n      }\n    };\n    const checkout = () => {\n      console.log(\"去结算\", cartItems.value);\n    };\n    const __returned__ = {\n      cartItems,\n      totalPrice,\n      fetchCartItems,\n      updateQuantity,\n      removeItem,\n      checkout,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get ElTable() {\n        return ElTable;\n      },\n      get ElTableColumn() {\n        return ElTableColumn;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElInputNumber() {\n        return ElInputNumber;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","ElTable","ElTableColumn","ElButton","ElInputNumber","cartItems","totalPrice","value","reduce","total","item","price","quantity","fetchCartItems","userId","response","get","data","error","console","updateQuantity","log","removeItem","itemId","index","findIndex","id","splice","checkout"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"120\">\n        <template #default=\"scope\">\n          <img :src=\"scope.row.image\" alt=\"商品图片\" class=\"cart-image\" />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\" />\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\" />\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"100\">\n        <template #default=\"scope\">\n          <El-input-number\n            v-model=\"scope.row.quantity\"\n            @change=\"updateQuantity(scope.row)\"\n            :min=\"1\"\n            :max=\"scope.row.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.id)\"\n            >删除</El-button\n          >\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>总计: ¥{{ totalPrice.toFixed(2) }}</h2>\n      <El-button type=\"primary\" @click=\"checkout\">去结算</El-button>\n    </div>\n\n    <p v-if=\"!cartItems.length\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\nimport { ElTable, ElTableColumn, ElButton, ElInputNumber } from \"element-plus\";\n\nconst cartItems = ref([]); // 初始化购物车项\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    return total + item.price * item.quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const userId = 1; // 这里是示例，您需要使用实际用户 ID\n    const response = await axios.get(\n      `http://localhost:5000/api/cart/${userId}`,\n    ); // 从后端获取购物车数据\n    cartItems.value = response.data; // 将获取到的数据赋值给 cartItems\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\nconst updateQuantity = (item) => {\n  console.log(\"商品数量更新: \", item);\n};\n\nconst removeItem = (itemId) => {\n  const index = cartItems.value.findIndex((item) => item.id === itemId);\n  if (index !== -1) {\n    cartItems.value.splice(index, 1);\n  }\n};\n\nconst checkout = () => {\n  console.log(\"去结算\", cartItems.value);\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n</style>\n"],"mappings":"AAwCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;AAC3B,SAASC,OAAO,EAAEC,aAAa,EAAEC,QAAQ,EAAEC,aAAa,QAAQ,cAAc;;;;;;;IAE9E,MAAMC,SAAS,GAAGR,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE3B;IACA,MAAMS,UAAU,GAAGR,QAAQ,CAAC,MAAM;MAChC,OAAOO,SAAS,CAACE,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,OAAOD,KAAK,GAAGC,IAAI,CAACC,KAAK,GAAGD,IAAI,CAACE,QAAQ;MAC3C,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;;IAEF;IACA,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,MAAM,GAAG,CAAC,CAAC,CAAC;QAClB,MAAMC,QAAQ,GAAG,MAAMf,KAAK,CAACgB,GAAG,CAC9B,kCAAkCF,M