{"ast":null,"code":"import { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nimport { useStore } from \"vuex\"; // 引入 Vuex\nconst logo = \"/assets/logo.png\";\nexport default {\n  __name: 'LoginPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loginFormRef = ref(null);\n    const router = useRouter();\n    const store = useStore(); // 获取 Vuex userStore\n\n    // 登录表单数据\n    const loginForm = reactive({\n      username: \"\",\n      password: \"\"\n    });\n\n    // 表单验证规则\n    const loginRules = {\n      username: [{\n        required: true,\n        message: \"请输入用户名\",\n        trigger: \"blur\"\n      }],\n      password: [{\n        required: true,\n        message: \"请输入密码\",\n        trigger: \"blur\"\n      }, {\n        min: 6,\n        message: \"密码不能少于6位\",\n        trigger: \"blur\"\n      }]\n    };\n\n    // 加载状态\n    const isLoading = ref(false);\n    const handleLogin = async () => {\n      try {\n        const valid = await loginFormRef.value.validate();\n        if (!valid) {\n          ElMessage.error(\"请检查输入，确保用户名和密码都已填写。\");\n          return;\n        }\n        isLoading.value = true;\n        // 调用 Vuex 的 userLogin action\n        const response = await store.dispatch(\"userLogin\", {\n          username: loginForm.username,\n          password: loginForm.password\n        });\n        // 使用从 response 中提取出来的用户数据\n        const user = response.user; // 此处应当是 response.data.data.user\n        store.commit(\"setUser\", user);\n        localStorage.setItem(\"user\", JSON.stringify(user));\n        // 从用户对象中提取 userId\n        if (user && user.id) {\n          // 假设用户对象中有 id 属性\n          localStorage.setItem(\"userId\", user.id); // 保存 userId\n        }\n        ElMessage.success(\"登录成功\");\n        await router.push({\n          name: \"Home\"\n        });\n      } catch (error) {\n        ElMessage.error(error.message || \"登录失败，请重试。\");\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // 注册处理\n    const handleRegister = () => {\n      router.push({\n        name: \"Register\"\n      }); // 跳转到注册页面\n    };\n\n    // 找回密码处理\n    const handleForgotPassword = () => {\n      router.push({\n        name: \"ForgetPassword\"\n      }); // 跳转到找回密码界面\n    };\n    const __returned__ = {\n      logo,\n      loginFormRef,\n      router,\n      store,\n      loginForm,\n      loginRules,\n      isLoading,\n      handleLogin,\n      handleRegister,\n      handleForgotPassword,\n      reactive,\n      ref,\n      get useRouter() {\n        return useRouter;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get useStore() {\n        return useStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","useRouter","ElMessage","useStore","logo","loginFormRef","router","store","loginForm","username","password","loginRules","required","message","trigger","min","isLoading","handleLogin","valid","value","validate","error","response","dispatch","user","commit","localStorage","setItem","JSON","stringify","id","success","push","name","handleRegister","handleForgotPassword"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/LoginPage.vue"],"sourcesContent":["<!-- frontend/src/views/login/LoginPage.vue -->\n<template>\n  <div class=\"login-container\">\n    <div class=\"login-wrapper\">\n      <div class=\"logo-title-container\">\n        <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n        <h1 class=\"system-title\">团团赚拼购</h1>\n      </div>\n\n      <El-form\n        ref=\"loginFormRef\"\n        :model=\"loginForm\"\n        :rules=\"loginRules\"\n        class=\"login-form\"\n      >\n        <El-form-item prop=\"username\">\n          <El-input\n            v-model=\"loginForm.username\"\n            prefix-icon=\"User\"\n            placeholder=\"用户名\"\n            clearable\n          />\n        </El-form-item>\n\n        <El-form-item prop=\"password\">\n          <El-input\n            v-model=\"loginForm.password\"\n            type=\"password\"\n            prefix-icon=\"Lock\"\n            placeholder=\"密码\"\n            show-password\n          />\n        </El-form-item>\n\n        <El-form-item>\n          <El-button\n            type=\"primary\"\n            class=\"login-btn\"\n            :loading=\"isLoading\"\n            :disabled=\"isLoading\"\n            @click=\"handleLogin\"\n          >\n            登录\n          </El-button>\n        </El-form-item>\n\n        <div class=\"login-extra\">\n          <El-link type=\"primary\" @click=\"handleRegister\">立即注册</El-link>\n          <El-link type=\"info\" @click=\"handleForgotPassword\">忘记密码</El-link>\n        </div>\n      </El-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { ElMessage } from \"element-plus\";\nconst logo = \"/assets/logo.png\";\nimport { useStore } from \"vuex\"; // 引入 Vuex\nconst loginFormRef = ref(null);\nconst router = useRouter();\nconst store = useStore(); // 获取 Vuex userStore\n\n// 登录表单数据\nconst loginForm = reactive({\n  username: \"\",\n  password: \"\",\n});\n\n// 表单验证规则\nconst loginRules = {\n  username: [\n    {\n      required: true,\n      message: \"请输入用户名\",\n      trigger: \"blur\",\n    },\n  ],\n  password: [\n    {\n      required: true,\n      message: \"请输入密码\",\n      trigger: \"blur\",\n    },\n    {\n      min: 6,\n      message: \"密码不能少于6位\",\n      trigger: \"blur\",\n    },\n  ],\n};\n\n// 加载状态\nconst isLoading = ref(false);\nconst handleLogin = async () => {\n  try {\n    const valid = await loginFormRef.value.validate();\n    if (!valid) {\n      ElMessage.error(\"请检查输入，确保用户名和密码都已填写。\");\n      return;\n    }\n    isLoading.value = true;\n    // 调用 Vuex 的 userLogin action\n    const response = await store.dispatch(\"userLogin\", {\n      username: loginForm.username,\n      password: loginForm.password,\n    });\n    // 使用从 response 中提取出来的用户数据\n    const user = response.user; // 此处应当是 response.data.data.user\n    store.commit(\"setUser\", user);\n    localStorage.setItem(\"user\", JSON.stringify(user));\n    // 从用户对象中提取 userId\n    if (user && user.id) {\n      // 假设用户对象中有 id 属性\n      localStorage.setItem(\"userId\", user.id); // 保存 userId\n    }\n    ElMessage.success(\"登录成功\");\n    await router.push({ name: \"Home\" });\n  } catch (error) {\n    ElMessage.error(error.message || \"登录失败，请重试。\");\n  } finally {\n    isLoading.value = false;\n  }\n};\n\n// 注册处理\nconst handleRegister = () => {\n  router.push({ name: \"Register\" }); // 跳转到注册页面\n};\n\n// 找回密码处理\nconst handleForgotPassword = () => {\n  router.push({ name: \"ForgetPassword\" }); // 跳转到找回密码界面\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(to right, #3494e6, #ec6ead);\n}\n\n.login-wrapper {\n  width: 400px;\n  padding: 30px;\n  background: white;\n  border-radius: 10px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  text-align: center;\n}\n\n.logo-title-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.logo {\n  width: 140px;\n  height: 80px;\n  margin-bottom: 10px;\n}\n\n.system-title {\n  font-size: 24px;\n  color: #333;\n  font-weight: bold;\n}\n\n.login-form {\n  width: 100%;\n}\n\n.login-btn {\n  width: 100%;\n  margin-top: 10px;\n}\n\n.login-extra {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 10px;\n}\n</style>\n"],"mappings":"AAwDA,SAASA,QAAQ,EAAEC,GAAG,QAAQ,KAAK;AACnC,SAASC,SAAS,QAAQ,YAAY;AACtC,SAASC,SAAS,QAAQ,cAAc;AAExC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;AADjC,MAAMC,IAAI,GAAG,kBAAkB;;;;;;;IAE/B,MAAMC,YAAY,GAAGL,GAAG,CAAC,IAAI,C