{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\n\nexport default {\n  __name: 'CartPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\n    const cartItems = ref([]); // 初始化购物车项\n\n    // 总计计算\n    const totalPrice = computed(() => {\n      return cartItems.value.reduce((total, item) => {\n        return total + item.price * item.quantity;\n      }, 0);\n    });\n\n    // 获取购物车数据的函数\n    const fetchCartItems = async () => {\n      try {\n        const response = await axios.get(`http://localhost:5000/api/cart/${userId}`);\n\n        // 检查 `success` 字段并获取 `data`\n        if (response.data.success && Array.isArray(response.data.data)) {\n          cartItems.value = response.data.data; // 只赋值有效的数组\n        } else {\n          console.error(\"返回的数据不是一个有效的数组:\", response.data);\n          cartItems.value = []; // 或其他处理\n        }\n      } catch (error) {\n        console.error(\"获取购物车数据失败:\", error);\n      }\n    };\n\n    // 组件加载时获取数据\n    onMounted(() => {\n      fetchCartItems();\n    });\n    const updateQuantity = item => {\n      console.log(\"商品数量更新: \", item);\n      // TODO: 这里可以添加更新数量的逻辑，比如同步到后端\n    };\n    const removeItem = itemId => {\n      const index = cartItems.value.findIndex(item => item.id === itemId);\n      if (index !== -1) {\n        cartItems.value.splice(index, 1); // 从购物车中删除商品\n      }\n    };\n    const checkout = () => {\n      console.log(\"去结算\", cartItems.value);\n      // TODO: 添加结算逻辑\n    };\n    const __returned__ = {\n      userId,\n      cartItems,\n      totalPrice,\n      fetchCartItems,\n      updateQuantity,\n      removeItem,\n      checkout,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","userId","localStorage","getItem","cartItems","totalPrice","value","reduce","total","item","price","quantity","fetchCartItems","response","get","data","success","Array","isArray","console","error","updateQuantity","log","removeItem","itemId","index","findIndex","id","splice","checkout"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/user/CartPage.vue"],"sourcesContent":["<template>\n  <div class=\"cart-page\">\n    <h1>购物车</h1>\n    <El-table :data=\"cartItems\" border>\n      <El-table-column prop=\"image\" label=\"商品图片\" width=\"120\">\n        <template #default=\"scope\">\n          <img :src=\"scope.row.imageUrl\" alt=\"商品图片\" class=\"cart-image\" />\n        </template>\n      </El-table-column>\n      <El-table-column prop=\"name\" label=\"商品名称\" />\n      <El-table-column prop=\"price\" label=\"价格\" width=\"100\" />\n      <El-table-column prop=\"quantity\" label=\"数量\" width=\"100\">\n        <template #default=\"scope\">\n          <El-input-number\n              v-model=\"scope.row.quantity\"\n              @change=\"updateQuantity(scope.row)\"\n              :min=\"1\"\n              :max=\"scope.row.stock\"\n          />\n        </template>\n      </El-table-column>\n      <El-table-column label=\"操作\" width=\"100\">\n        <template #default=\"scope\">\n          <El-button type=\"danger\" @click=\"removeItem(scope.row.id)\">删除</El-button>\n        </template>\n      </El-table-column>\n    </El-table>\n\n    <div class=\"cart-total\">\n      <h2>总计: ¥{{ totalPrice.toFixed(2) }}</h2>\n      <El-button type=\"primary\" @click=\"checkout\">去结算</El-button>\n    </div>\n\n    <p v-if=\"!cartItems.length\">购物车是空的</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport axios from \"axios\"; // 导入 axios\n\nconst userId = localStorage.getItem(\"userId\"); // 动态获取的 userId\nconst cartItems = ref([]); // 初始化购物车项\n\n// 总计计算\nconst totalPrice = computed(() => {\n  return cartItems.value.reduce((total, item) => {\n    return total + item.price * item.quantity;\n  }, 0);\n});\n\n// 获取购物车数据的函数\nconst fetchCartItems = async () => {\n  try {\n    const response = await axios.get(`http://localhost:5000/api/cart/${userId}`);\n\n    // 检查 `success` 字段并获取 `data`\n    if (response.data.success && Array.isArray(response.data.data)) {\n      cartItems.value = response.data.data; // 只赋值有效的数组\n    } else {\n      console.error(\"返回的数据不是一个有效的数组:\", response.data);\n      cartItems.value = []; // 或其他处理\n    }\n  } catch (error) {\n    console.error(\"获取购物车数据失败:\", error);\n  }\n};\n\n// 组件加载时获取数据\nonMounted(() => {\n  fetchCartItems();\n});\n\nconst updateQuantity = (item) => {\n  console.log(\"商品数量更新: \", item);\n  // TODO: 这里可以添加更新数量的逻辑，比如同步到后端\n};\n\nconst removeItem = (itemId) => {\n  const index = cartItems.value.findIndex((item) => item.id === itemId);\n  if (index !== -1) {\n    cartItems.value.splice(index, 1); // 从购物车中删除商品\n  }\n};\n\nconst checkout = () => {\n  console.log(\"去结算\", cartItems.value);\n  // TODO: 添加结算逻辑\n};\n</script>\n\n<style scoped>\n.cart-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n}\n\n.cart-image {\n  width: 60px; /* 设置商品图片的宽度 */\n  height: auto; /* 自适应高度 */\n  border-radius: 4px; /* 圆角 */\n}\n\n.cart-total {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n}\n\nh1 {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\nh2 {\n  font-size: 24px;\n  color: #f65a8b; /* 强调总计金额的颜色 */\n}\n</style>"],"mappings":"AAsCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO,CAAC,CAAC;;;;;;;;IAE3B,MAAMC,MAAM,GAAGC,YAAY,CAACC,OAAO,CAAC,QAAQ,CAAC,CAAC,CAAC;IAC/C,MAAMC,SAAS,GAAGP,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;;IAE3B;IACA,MAAMQ,UAAU,GAAGP,QAAQ,CAAC,MAAM;MAChC,OAAOM,SAAS,CAACE,KAAK,CAACC,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC7C,OAAOD,KAAK,GAAGC,IAAI,CAACC,KAAK,GAAGD,IAAI,CAACE,QAAQ;MAC3C,CAAC,EAAE,CAAC,CAAC;IACP,CAAC,CAAC;;IAEF;IACA,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMb,KAAK,CAACc,GAAG,CAAC,kCAAkCb,MAAM,EAAE,CAAC;;QAE5E;QACA,IAAIY,QAAQ,CAACE,IAAI,CAACC,OAAO,IAAIC,KAAK,CAACC,OAAO,CAACL,QAAQ,CAACE,IAAI,CAACA,IAAI,CAAC,EAAE;UAC9DX,SAAS,CAACE,KAAK,GAAGO,QAAQ,CAACE,IAAI,CAACA,IAAI,CAAC,CAAC;QACxC,CAAC,MAAM;UACLI,OAAO,CAACC,KAAK,CAAC,iBAAiB,EAAEP,QAAQ,CAACE,IAAI,CAAC;UAC/CX,SAAS,CAACE,KAAK,GAAG,EAAE,CAAC,CAAC;QACxB;MACF,CAAC,CAAC,OAAOc,KAAK,EAAE;QACdD,OAAO,CAACC,KAAK,CAAC,YAAY,EAAEA,KAAK,CAAC;MACpC;IACF,CAAC;;IAED;IACArB,SAAS,CAAC,MAAM;MACda,cAAc,CAAC,CAAC;IAClB,CAAC,CAAC;IAEF,MAAMS,cAAc,GAAIZ,IAAI,IAAK;MAC/BU,OAAO,CAACG,GAAG,CAAC,UAAU,EAAEb,IAAI,CAAC;MAC7B;IACF,CAAC;IAED,MAAMc,UAAU,GAAIC,MAAM,IAAK;MAC7B,MAAMC,KAAK,GAAGrB,SAAS,CAACE,KAAK,CAACoB,SAAS,CAAEjB,IAAI,IAAKA,IAAI,CAACkB,EAAE,KAAKH,MAAM,CAAC;MACrE,IAAIC,KAAK,KAAK,CAAC,CAAC,EAAE;QAChBrB,SAAS,CAACE,KAAK,CAACsB,MAAM,CAACH,KAAK,EAAE,CAAC,CAAC,CAAC,CAAC;MACpC;IACF,CAAC;IAED,MAAMI,QAAQ,GAAGA,CAAA,KAAM;MACrBV,OAAO,CAACG,GAAG,CAAC,KAAK,EAAElB,SAAS,CAACE,KAAK,CAAC;MACnC;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}