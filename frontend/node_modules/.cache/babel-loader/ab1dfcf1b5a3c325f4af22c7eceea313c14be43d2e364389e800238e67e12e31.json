{"ast":null,"code":"import { ref } from \"vue\";\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\nexport default {\n  __name: 'RegisterPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const registerForm = ref({\n      username: '',\n      phone: '',\n      verifyCode: '',\n      password: '',\n      confirmPassword: ''\n    });\n\n    // [保持原有的逻辑不变]\n\n    const __returned__ = {\n      registerForm,\n      ref,\n      get User() {\n        return User;\n      },\n      get Mobile() {\n        return Mobile;\n      },\n      get Lock() {\n        return Lock;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get logo() {\n        return logo;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","User","Mobile","Lock","ChatDotRound","logo","registerForm","username","phone","verifyCode","password","confirmPassword"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/login/RegisterPage.vue"],"sourcesContent":["<template>\n  <div class=\"register-container\">\n    <div class=\"register-wrapper\">\n      <div class=\"register-form-container\">\n        <div class=\"register-header\">\n          <img :src=\"logo\" alt=\"团团赚拼购\" class=\"logo\" />\n          <h2>用户注册</h2>\n        </div>\n\n        <El-form\n            ref=\"registerFormRef\"\n            :model=\"registerForm\"\n            :rules=\"registerRules\"\n            class=\"register-form\"\n        >\n          <El-form-item prop=\"username\">\n            <El-input\n                v-model=\"registerForm.username\"\n                placeholder=\"用户名\"\n                clearable\n                class=\"register-input\"\n            >\n              <template #prefix>\n                <El-icon><User /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"phone\">\n            <El-input\n                v-model=\"registerForm.phone\"\n                placeholder=\"手机号\"\n                clearable\n                class=\"register-input\"\n            >\n              <template #prefix>\n                <El-icon><Mobile /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"verifyCode\" class=\"verify-code-item\">\n            <El-input\n                v-model=\"registerForm.verifyCode\"\n                placeholder=\"验证码\"\n                class=\"verify-code-input register-input\"\n            >\n              <template #prefix>\n                <El-icon><ChatDotRound /></El-icon>\n              </template>\n              <template #append>\n                <El-button\n                    :disabled=\"countDown > 0\"\n                    type=\"primary\"\n                    plain\n                    @click=\"sendVerifyCode\"\n                >\n                  {{ countDown > 0 ? `重发(${countDown}s)` : \"获取验证码\" }}\n                </El-button>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"password\">\n            <El-input\n                v-model=\"registerForm.password\"\n                type=\"password\"\n                placeholder=\"密码\"\n                clearable\n                show-password\n                class=\"register-input\"\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item prop=\"confirmPassword\">\n            <El-input\n                v-model=\"registerForm.confirmPassword\"\n                type=\"password\"\n                placeholder=\"确认密码\"\n                clearable\n                show-password\n                class=\"register-input\"\n            >\n              <template #prefix>\n                <El-icon><Lock /></El-icon>\n              </template>\n            </El-input>\n          </El-form-item>\n\n          <El-form-item>\n            <El-button\n                type=\"primary\"\n                class=\"register-btn\"\n                @click=\"handleRegister\"\n                round\n                block\n            >\n              注 册\n            </El-button>\n          </El-form-item>\n\n          <div class=\"register-footer\">\n            <El-link type=\"primary\" @click=\"$router.push('/login')\">\n              已有账号？立即登录\n            </El-link>\n          </div>\n        </El-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from \"vue\";\nimport { User, Mobile, Lock, ChatDotRound } from \"@element-plus/icons-vue\";\nimport logo from \"@/assets/logo.png\";\n\nconst registerForm = ref({\n  username: '',\n  phone: '',\n  verifyCode: '',\n  password: '',\n  confirmPassword: '',\n});\n\n// [保持原有的逻辑不变]\n</script>\n\n<style lang=\"scss\" scoped>\n.register-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: linear-gradient(135deg, #f3f4f6, #e4e7ec);\n}\n\n.register-wrapper {\n  background: white;\n  border-radius: 10px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n  padding: 30px;\n  width: 400px;\n  text-align: center;\n}\n\n.register-header {\n  margin-bottom: 20px;\n}\n\n.logo {\n  width: 80px;\n}\n\n.register-form {\n  max-width: 350px;\n  margin: 0 auto;\n}\n\n.register-input {\n  margin-bottom: 15px;\n}\n\n.register-btn {\n  margin-top: 20px;\n  padding: 10px;\n  font-size: 16px;\n}\n\n.register-footer {\n  margin-top: 20px;\n}\n</style>"],"mappings":"AAqHA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,IAAI,EAAEC,MAAM,EAAEC,IAAI,EAAEC,YAAY,QAAQ,yBAAyB;AAC1E,OAAOC,IAAI,MAAM,mBAAmB;;;;;;;IAEpC,MAAMC,YAAY,GAAGN,GAAG,CAAC;MACvBO,QAAQ,EAAE,EAAE;MACZC,KAAK