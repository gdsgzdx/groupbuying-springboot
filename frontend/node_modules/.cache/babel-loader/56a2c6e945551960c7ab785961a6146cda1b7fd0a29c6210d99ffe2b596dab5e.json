{"ast":null,"code":"import { ref, onMounted, onBeforeUnmount } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ElButton } from \"element-plus\";\nexport default {\n  __name: 'ProductPage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const product = ref({\n      name: \"\",\n      price: 0,\n      imageUrl: \"\",\n      description: \"\",\n      stock: 0\n    });\n    const optionsVisible = ref(false); // 控制购买选项的显示状态\n    const canvasRef = ref(null); // Canvas 引用\n    // 获取商品详细信息\n    onMounted(async () => {\n      const productId = route.params.id;\n      console.log(`请求商品 ID: ${productId}`);\n      const response = await fetch(`http://localhost:5000/api/products/${productId}`);\n      if (response.ok) {\n        const productData = await response.json();\n        product.value = productData.data;\n        product.value.price = parseFloat(product.value.price) || 0;\n        drawBackground(canvasRef.value);\n      } else {\n        console.error(\"获取商品详情失败，状态码:\", response.status);\n      }\n    });\n    // 随机生成颜色\n    const randomColor = () => {\n      return `hsl(${Math.random() * 360}, 100%, 50%)`;\n    };\n\n    // 生成动态背景\n    const drawBackground = canvas => {\n      if (!canvas) return;\n      const ctx = canvas.getContext(\"2d\");\n      const w = canvas.width = window.innerWidth;\n      const h = canvas.height = window.innerHeight;\n      const particles = [];\n      const numberOfParticles = 200;\n\n      // 生成随机粒子\n      for (let i = 0; i < numberOfParticles; i++) {\n        particles.push({\n          x: Math.random() * w,\n          y: Math.random() * h,\n          radius: Math.random() * 20,\n          color: randomColor(),\n          speedX: Math.random() * 5 - 2.5,\n          speedY: Math.random() * 5 - 2.5\n        });\n      }\n      const animate = () => {\n        ctx.clearRect(0, 0, w, h);\n        particles.forEach(p => {\n          ctx.beginPath();\n          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2, false);\n          ctx.fillStyle = p.color;\n          ctx.fill();\n          p.x += p.speedX;\n          p.y += p.speedY;\n\n          // 碰撞检测\n          if (p.x + p.radius > w || p.x - p.radius < 0) p.speedX *= -1;\n          if (p.y + p.radius > h || p.y - p.radius < 0) p.speedY *= -1;\n        });\n        requestAnimationFrame(animate);\n      };\n      animate();\n    };\n    // 加入购物车\n    const addToCart = async () => {\n      // 可以使用默认数量，例如 1\n      const quantity = 1;\n      try {\n        const response = await fetch(\"http://localhost:5000/api/cart\", {\n          method: \"POST\",\n          headers: {\n            \"Content-Type\": \"application/json\"\n          },\n          body: JSON.stringify({\n            userId: localStorage.getItem(\"userId\"),\n            // 从 localStorage 中获取用户 ID\n            productId: product.value.id,\n            // 使用当前商品的 ID\n            quantity: quantity\n          })\n        });\n        if (response.ok) {\n          alert(`${product.value.name} 已加入购物车！`);\n        } else {\n          console.error(\"加入购物车失败，状态码:\", response.status);\n          const errorData = await response.json();\n          alert(\"加入购物车失败: \" + errorData.message);\n        }\n      } catch (error) {\n        console.error(\"加入购物车时发生错误:\", error);\n        alert(\"加入购物车失败，请稍后重试。\");\n      }\n    };\n\n    // 显示购买选项\n    const showPurchaseOptions = () => {\n      optionsVisible.value = true; // 显示购买选项\n    };\n    // 组件卸载时清理\n    onBeforeUnmount(() => {\n      const canvas = canvasRef.value;\n      if (canvas) {\n        const ctx = canvas.getContext(\"2d\");\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n      }\n    });\n    // 拼团购买\n    const purchaseAsGroup = () => {\n      alert(\"选择拼团购买功能！\");\n    };\n\n    // 单独购买\n    const purchaseSeparately = () => {\n      alert(\"选择单独购买功能！\");\n    };\n    const __returned__ = {\n      route,\n      product,\n      optionsVisible,\n      canvasRef,\n      randomColor,\n      drawBackground,\n      addToCart,\n      showPurchaseOptions,\n      purchaseAsGroup,\n      purchaseSeparately,\n      ref,\n      onMounted,\n      onBeforeUnmount,\n      get useRoute() {\n        return useRoute;\n      },\n      get ElButton() {\n        return ElButton;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onBeforeUnmount","useRoute","ElButton","route","product","name","price","imageUrl","description","stock","optionsVisible","canvasRef","productId","params","id","console","log","response","fetch","ok","productData","json","value","data","parseFloat","drawBackground","error","status","randomColor","Math","random","canvas","ctx","getContext","w","width","window","innerWidth","h","height","innerHeight","particles","numberOfParticles","i","push","x","y","radius","color","speedX","speedY","animate","clearRect","forEach","p","beginPath","arc","PI","fillStyle","fill","requestAnimationFrame","addToCart","quantity","method","headers","body","JSON","stringify","userId","localStorage","getItem","alert","errorData","message","showPurchaseOptions","purchaseAsGroup","purchaseSeparately"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/product/ProductPage.vue"],"sourcesContent":["<template>\n  <div class=\"product-page\">\n    <canvas class=\"background-canvas\" ref=\"canvas\"></canvas>\n    <div class=\"product-container\">\n      <div class=\"product-header\">\n        <h1>{{ product.name }}</h1>\n        <p class=\"price\">价格: ¥{{ product.price }}</p>\n      </div>\n\n      <div class=\"product-content\">\n        <img :src=\"product.imageUrl\" alt=\"商品图片\" class=\"product-image\" />\n\n        <div class=\"product-details\">\n          <p class=\"description\">{{ product.description }}</p>\n          <p class=\"stock\">库存: {{ product.stock }}件</p>\n\n          <div class=\"action-buttons\">\n            <ElButton type=\"primary\" @click=\"addToCart\">加入购物车</ElButton>\n            <ElButton type=\"danger\" @click=\"showPurchaseOptions\"\n              >立即购买</ElButton\n            >\n          </div>\n\n          <!-- 新增的购买方式选项 -->\n          <div v-if=\"optionsVisible\" class=\"purchase-options\">\n            <p>请选择购买方式：</p>\n            <ElButton type=\"success\" @click=\"purchaseAsGroup\"\n              >拼团购买</ElButton\n            >\n            <ElButton type=\"warning\" @click=\"purchaseSeparately\"\n              >单独购买</ElButton\n            >\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, onBeforeUnmount } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ElButton } from \"element-plus\";\n\nconst route = useRoute();\n\nconst product = ref({\n  name: \"\",\n  price: 0,\n  imageUrl: \"\",\n  description: \"\",\n  stock: 0,\n});\nconst optionsVisible = ref(false); // 控制购买选项的显示状态\nconst canvasRef = ref(null); // Canvas 引用\n// 获取商品详细信息\nonMounted(async () => {\n  const productId = route.params.id;\n  console.log(`请求商品 ID: ${productId}`);\n  const response = await fetch(\n    `http://localhost:5000/api/products/${productId}`,\n  );\n\n  if (response.ok) {\n    const productData = await response.json();\n    product.value = productData.data;\n    product.value.price = parseFloat(product.value.price) || 0;\n    drawBackground(canvasRef.value);\n  } else {\n    console.error(\"获取商品详情失败，状态码:\", response.status);\n  }\n});\n// 随机生成颜色\nconst randomColor = () => {\n  return `hsl(${Math.random() * 360}, 100%, 50%)`;\n};\n\n// 生成动态背景\nconst drawBackground = (canvas) => {\n  if (!canvas) return;\n  const ctx = canvas.getContext(\"2d\");\n  const w = (canvas.width = window.innerWidth);\n  const h = (canvas.height = window.innerHeight);\n\n  const particles = [];\n  const numberOfParticles = 200;\n\n  // 生成随机粒子\n  for (let i = 0; i < numberOfParticles; i++) {\n    particles.push({\n      x: Math.random() * w,\n      y: Math.random() * h,\n      radius: Math.random() * 20,\n      color: randomColor(),\n      speedX: Math.random() * 5 - 2.5,\n      speedY: Math.random() * 5 - 2.5,\n    });\n  }\n\n  const animate = () => {\n    ctx.clearRect(0, 0, w, h);\n    particles.forEach((p) => {\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2, false);\n      ctx.fillStyle = p.color;\n      ctx.fill();\n      p.x += p.speedX;\n      p.y += p.speedY;\n\n      // 碰撞检测\n      if (p.x + p.radius > w || p.x - p.radius < 0) p.speedX *= -1;\n      if (p.y + p.radius > h || p.y - p.radius < 0) p.speedY *= -1;\n    });\n    requestAnimationFrame(animate);\n  };\n  animate();\n};\n// 加入购物车\nconst addToCart = async () => {\n  // 可以使用默认数量，例如 1\n  const quantity = 1;\n\n  try {\n    const response = await fetch(\"http://localhost:5000/api/cart\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n      },\n      body: JSON.stringify({\n        userId: localStorage.getItem(\"userId\"), // 从 localStorage 中获取用户 ID\n        productId: product.value.id, // 使用当前商品的 ID\n        quantity: quantity,\n      }),\n    });\n\n    if (response.ok) {\n      alert(`${product.value.name} 已加入购物车！`);\n    } else {\n      console.error(\"加入购物车失败，状态码:\", response.status);\n      const errorData = await response.json();\n      alert(\"加入购物车失败: \" + errorData.message);\n    }\n  } catch (error) {\n    console.error(\"加入购物车时发生错误:\", error);\n    alert(\"加入购物车失败，请稍后重试。\");\n  }\n};\n\n// 显示购买选项\nconst showPurchaseOptions = () => {\n  optionsVisible.value = true; // 显示购买选项\n};\n// 组件卸载时清理\nonBeforeUnmount(() => {\n  const canvas = canvasRef.value;\n  if (canvas) {\n    const ctx = canvas.getContext(\"2d\");\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n  }\n});\n// 拼团购买\nconst purchaseAsGroup = () => {\n  alert(\"选择拼团购买功能！\");\n};\n\n// 单独购买\nconst purchaseSeparately = () => {\n  alert(\"选择单独购买功能！\");\n};\n</script>\n\n<style scoped>\n.product-page {\n  max-width: 800px;\n  margin: auto;\n  padding: 20px;\n  position: relative; /* 使 canvas 能够相对定位 */\n  z-index: 1; /* 保持其他元素在上层 */\n}\n.background-canvas {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 0; /* 设置为最底层 */\n}\n\n.product-container {\n  display: flex;\n  flex-direction: column;\n}\n\n.product-header {\n  margin-bottom: 20px;\n}\n\n.price {\n  font-size: 24px;\n  color: #f65a8b;\n}\n\n.product-content {\n  display: flex;\n  align-items: flex-start;\n}\n\n.product-image {\n  max-width: 400px;\n  height: auto;\n  border-radius: 8px;\n  margin-right: 20px;\n}\n\n.product-details {\n  flex-grow: 1;\n}\n\n.description {\n  font-size: 20px;\n  line-height: 1.5;\n  margin-bottom: 10px;\n}\n\n.stock {\n  font-size: 16px;\n  margin-bottom: 20px;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 10px;\n}\n\n.purchase-options {\n  margin-top: 20px;\n  display: flex;\n  flex-direction: column; /* 垂直排列按钮 */\n  gap: 10px; /* 按钮间距 */\n}\n</style>\n"],"mappings":"AAwCA,SAASA,GAAG,EAAEC,SAAS,EAAEC,eAAe,QAAQ,KAAK;AACrD,SAASC,QAAQ,QAAQ,YAAY;AACrC,SAASC,QAAQ,QAAQ,cAAc;;;;;;;IAEvC,MAAMC,KAAK,GAAGF,QAAQ,CAAC,CAAC;IAExB,MAAMG,OAAO,GAAGN,GAAG,CAAC;MAClBO,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,CAAC;MACRC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,KAAK,EAAE;IACT,CAAC,CAAC;IACF,MAAMC,cAAc,GAAGZ,GAAG,CAAC,KAAK,CAAC,CAAC,CAAC;IACnC,MAAMa,SAAS,GAAGb,GAAG,CAAC,IAAI,CAAC,CAAC,CAAC;IAC7B;IACAC,SAAS,CAAC,YAAY;MACpB,MAAMa,SAAS,GAAGT,KAAK,CAACU,MAAM,CAACC,EAAE;MACjCC,OAAO,CAACC,GAAG,CAAC,YAAYJ,SAAS,EAAE,CAAC;MACpC,MAAMK,QAAQ,GAAG,MAAMC,KAAK,CAC1B,sCAAsCN,SAAS,EACjD,CAAC;MAED,IAAIK,QAAQ,CAACE,EAAE,EAAE;QACf,MAAMC,WAAW,GAAG,MAAMH,QAAQ,CAACI,IAAI,CAAC,CAAC;QACzCjB,OAAO,CAACkB,KAAK,GAAGF,WAAW,CAACG,IAAI;QAChCnB,OAAO,CAACkB,KAAK,CAAChB,KAAK,GAAGkB,UAAU,CAACpB,OAAO,CAACkB,KAAK,CAAChB,KAAK,CAAC,IAAI,CAAC;QAC1DmB,cAAc,CAACd,SAAS,CAACW,KAAK,CAAC;MACjC,CAAC,MAAM;QACLP,OAAO,CAACW,KA