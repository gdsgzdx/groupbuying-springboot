{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport { ElCarousel, ElCarouselItem, ElButton, ElMenu, ElMenuItem, ElSelect, ElOption, ElRow, ElCol, ElCard, ElPagination } from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex Store\n\nexport default {\n  __name: 'HomePage',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter(); // 获取路由对象\n    const store = useStore(); // 获取 Vuex Store\n    const searchQuery = ref(\"\"); // 搜索查询\n    const selectedSort = ref(\"default-sort\"); // 默认排序方式\n    const currentPage = ref(1); // 当前页码\n    const itemsPerPage = ref(8); // 每页显示的商品数量\n    const sortedProducts = ref([]); // 存储排序后的产品\n    const ads = ref([{\n      image: \"/assets/苹果13.png\"\n    }, {\n      image: \"/assets/苹果15Pro.png\"\n    }, {\n      image: \"/assets/微软二合一ipad.png\"\n    }]);\n    const goToProfile = () => {\n      router.push({\n        name: \"UsersPage\"\n      }); // 跳转到个人中心页面\n    };\n\n    // 获取产品数据\n    const fetchProductData = async () => {\n      await store.dispatch(\"FetchProducts\"); // 调用 Vuex action 来加载产品数据\n    };\n    // 添加跳转到购物车的功能\n    const goToCart = () => {\n      router.push({\n        name: \"CartPage\"\n      }); // 跳转到购物车页面\n    };\n\n    // 添加跳转到我的订单的功能\n    const goToOrders = () => {\n      router.push({\n        name: \"OrderPage\"\n      }); // 跳转到我的订单页面\n    };\n    // 排序函数\n    const sortProducts = products => {\n      let sorted = [...products].map(product => ({\n        ...product,\n        price: parseFloat(product.price) || 0,\n        sales: parseInt(product.sales) || 0,\n        createdAt: new Date(product.createdAt)\n      }));\n      switch (selectedSort.value) {\n        case \"low-to-high\":\n          sorted.sort((a, b) => a.price - b.price);\n          break;\n        case \"high-to-low\":\n          sorted.sort((a, b) => b.price - a.price);\n          break;\n        case \"hot-to-high\":\n          sorted.sort((a, b) => b.sales - a.sales);\n          break;\n        case \"default-sort\":\n        default:\n          sorted.sort((a, b) => b.createdAt - a.createdAt);\n          break;\n      }\n      return sorted;\n    };\n    onMounted(async () => {\n      await fetchProductData(); // 获取产品数据\n      const products = store.state.product.products; // 获取最新的产品列表\n      console.log(\"产品列表为：\", store.state.product.products);\n      if (products.length > 0) {\n        sortedProducts.value = sortProducts(products); // 对产品进行排序\n      }\n    });\n\n    // 计算属性获取用户昵称\n    const userNickname = computed(() => store.getters.userNickname);\n    // 计算属性获取用户头像\n    const userAvatar = computed(() => store.getters.userAvatar || \"/assets/avatar.png\");\n\n    // 获取当前页的产品\n    const paginatedProducts = computed(() => {\n      const start = (currentPage.value - 1) * itemsPerPage.value;\n      const end = start + itemsPerPage.value;\n      return sortedProducts.value.slice(start, end); // 返回当前页的产品\n    });\n\n    // 分页功能变化时的处理函数\n    const handlePageChange = newPage => {\n      currentPage.value = newPage; // 更新当前页\n    };\n\n    // 搜索功能\n    const applySearch = () => {\n      console.log(\"搜索产品:\", searchQuery.value);\n    };\n\n    // 跳转到首页并刷新\n    const goHome = () => {\n      window.location.reload(); // 强制刷新页面\n    };\n\n    // 跳转到商品详情\n    const viewProductDetails = product => {\n      console.log(`Navigating to product with ID: ${product.id}`); // 调试输出\n      router.push(`/product/${product.id}`);\n    };\n\n    // 选择分类\n    const selectCategory = category => {\n      console.log(`选择了分类: ${category}`);\n    };\n\n    // 退出登录功能\n    const logout = () => {\n      console.log(\"用户已注销\");\n      store.commit(\"clearUser\"); // 清空用户信息\n      router.push({\n        name: \"Login\"\n      }); // 跳转到登录页面\n    };\n    const __returned__ = {\n      router,\n      store,\n      searchQuery,\n      selectedSort,\n      currentPage,\n      itemsPerPage,\n      sortedProducts,\n      ads,\n      goToProfile,\n      fetchProductData,\n      goToCart,\n      goToOrders,\n      sortProducts,\n      userNickname,\n      userAvatar,\n      paginatedProducts,\n      handlePageChange,\n      applySearch,\n      goHome,\n      viewProductDetails,\n      selectCategory,\n      logout,\n      ref,\n      computed,\n      onMounted,\n      get ElCarousel() {\n        return ElCarousel;\n      },\n      get ElCarouselItem() {\n        return ElCarouselItem;\n      },\n      get ElButton() {\n        return ElButton;\n      },\n      get ElMenu() {\n        return ElMenu;\n      },\n      get ElMenuItem() {\n        return ElMenuItem;\n      },\n      get ElSelect() {\n        return ElSelect;\n      },\n      get ElOption() {\n        return ElOption;\n      },\n      get ElRow() {\n        return ElRow;\n      },\n      get ElCol() {\n        return ElCol;\n      },\n      get ElCard() {\n        return ElCard;\n      },\n      get ElPagination() {\n        return ElPagination;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useStore() {\n        return useStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","ElCarousel","ElCarouselItem","ElButton","ElMenu","ElMenuItem","ElSelect","ElOption","ElRow","ElCol","ElCard","ElPagination","useRouter","useStore","router","store","searchQuery","selectedSort","currentPage","itemsPerPage","sortedProducts","ads","image","goToProfile","push","name","fetchProductData","dispatch","goToCart","goToOrders","sortProducts","products","sorted","map","product","price","parseFloat","sales","parseInt","createdAt","Date","value","sort","a","b","state","console","log","length","userNickname","getters","userAvatar","paginatedProducts","start","end","slice","handlePageChange","newPage","applySearch","goHome","window","location","reload","viewProductDetails","id","selectCategory","category","logout","commit"],"sources":["D:/在线拼团系统/groupbuyingsystem/frontend/src/views/home/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"homepage\">\n    <!-- 页头 -->\n    <header class=\"header\">\n      <div class=\"header-container\">\n        <!-- Logo -->\n        <img src=\"/assets/logo.png\" alt=\"Logo\" class=\"logo\" />\n        <div class=\"title\">团团赚</div>\n        <!-- 首页按钮 -->\n        <El-button class=\"home-button\" @click=\"goHome\">首页</El-button>\n        <!-- 用户功能 -->\n        <div class=\"user-actions\">\n          <span class=\"user-nickname\">欢迎，{{ userNickname }}</span>\n          <img\n            v-if=\"userAvatar\"\n            :src=\"userAvatar\"\n            alt=\"用户头像\"\n            class=\"user-avatar\"\n          />\n          <span class=\"user-action\" @click=\"goToProfile\">个人中心</span>\n          <span class=\"user-action\" @click=\"goToCart\">购物车</span>\n          <span class=\"user-action\" @click=\"goToOrders\">我的订单</span>\n          <span class=\"user-action\" @click=\"logout\">退出登录</span>\n          <div class=\"search-container\">\n            <input\n              v-model=\"searchQuery\"\n              type=\"text\"\n              class=\"search-input\"\n              placeholder=\"搜索商品\"\n            />\n            <El-button type=\"primary\" @click=\"applySearch\">搜索</El-button>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"main-content\">\n      <!-- 商品分类 -->\n      <aside class=\"sidebar\">\n        <El-menu default-active=\"\" class=\"category-menu\">\n          <El-menu-item index=\"\" @click=\"selectCategory('')\"\n            >所有类目</El-menu-item\n          >\n          <El-menu-item index=\"1\" @click=\"selectCategory('家用电器')\"\n            >家用电器</El-menu-item\n          >\n          <El-menu-item index=\"2\" @click=\"selectCategory('手机/通讯/数码')\"\n            >手机/通讯/数码</El-menu-item\n          >\n          <El-menu-item index=\"3\" @click=\"selectCategory('电脑/办公/文具用品')\"\n            >电脑/办公/文具用品</El-menu-item\n          >\n          <El-menu-item index=\"4\" @click=\"selectCategory('家具/家居/厨房')\"\n            >家具/家居/厨房</El-menu-item\n          >\n          <El-menu-item index=\"5\" @click=\"selectCategory('男装/女装/童装/内衣')\"\n            >男装/女装/童装/内衣</El-menu-item\n          >\n          <El-menu-item index=\"6\" @click=\"selectCategory('美妆/个护清洁')\"\n            >美妆/个护清洁</El-menu-item\n          >\n          <El-menu-item index=\"7\" @click=\"selectCategory('女鞋/箱包/珠宝')\"\n            >女鞋/箱包/珠宝</El-menu-item\n          >\n          <El-menu-item index=\"8\" @click=\"selectCategory('男鞋/运动/户外')\"\n            >男鞋/运动/户外</El-menu-item\n          >\n          <El-menu-item index=\"9\" @click=\"selectCategory('食品/酒类/生鲜')\"\n            >食品/酒类/生鲜</El-menu-item\n          >\n          <El-menu-item index=\"10\" @click=\"selectCategory('艺术/礼品花/园艺')\"\n            >艺术/礼品花/园艺</El-menu-item\n          >\n          <El-menu-item index=\"11\" @click=\"selectCategory('图书/文娱/教育')\"\n            >图书/文娱/教育</El-menu-item\n          >\n          <El-menu-item index=\"12\" @click=\"selectCategory('机票/酒店/旅游')\"\n            >机票/酒店/旅游</El-menu-item\n          >\n          <El-menu-item index=\"13\" @click=\"selectCategory('支付/保险/金融')\"\n            >支付/保险/金融</El-menu-item\n          >\n          <El-menu-item index=\"14\" @click=\"selectCategory('玩具/乐器')\"\n            >玩具/乐器</El-menu-item\n          >\n        </El-menu>\n      </aside>\n\n      <section class=\"product-section\">\n        <section class=\"ad-banner\">\n          <div class=\"static-ads\">\n            <img src=\"/assets/车厘子.png\" alt=\"广告1\" class=\"ad-image\" />\n            <img src=\"/assets/广告1.png\" alt=\"广告2\" class=\"ad-image\" />\n          </div>\n          <El-carousel\n            class=\"carousel\"\n            :autoplay=\"true\"\n            interval=\"5000\"\n            arrow=\"always\"\n          >\n            <El-carousel-item v-for=\"ad in ads\" :key=\"ad.image\">\n              <img :src=\"ad.image\" alt=\"广告\" class=\"ad-image\" />\n            </El-carousel-item>\n          </El-carousel>\n        </section>\n\n        <!-- 热卖商品标题 -->\n        <h2 class=\"section-title\">热卖商品</h2>\n\n        <!-- 排序选择框 -->\n        <div class=\"filter-section\">\n          <El-select v-model=\"selectedSort\" placeholder=\"排序方式\">\n            <El-option label=\"默认排序\" value=\"default-sort\"></El-option>\n            <El-option label=\"价格从低到高\" value=\"low-to-high\"></El-option>\n            <El-option label=\"价格从高到低\" value=\"high-to-low\"></El-option>\n            <El-option label=\"销量从高到低\" value=\"hot-to-high\"></El-option>\n          </El-select>\n        </div>\n\n        <!-- 商品展示区域 -->\n        <El-row :gutter=\"20\">\n          <El-col\n            v-for=\"product in paginatedProducts\"\n            :key=\"product.id\"\n            :span=\"6\"\n          >\n            <El-card :style=\"{ padding: '45px' }\" class=\"product-card\">\n              <img :src=\"product.imageUrl\" class=\"product-image\" alt=\"\" />\n              <div class=\"product-info\">\n                <h3>{{ product.name }}</h3>\n                <p class=\"price\">¥{{ product.price.toFixed(2) }}</p>\n                <El-button type=\"primary\" @click=\"viewProductDetails(product)\"\n                  >查看商品详情</El-button\n                >\n              </div>\n            </El-card>\n          </El-col>\n        </El-row>\n        <p v-if=\"!paginatedProducts.length\">没有找到相关商品</p>\n\n        <!-- 分页 -->\n        <El-pagination\n          :current-page=\"currentPage\"\n          :page-size=\"itemsPerPage\"\n          :total=\"sortedProducts.length\"\n          @current-change=\"handlePageChange\"\n          layout=\"total, prev, pager, next, jumper\"\n        />\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from \"vue\";\nimport {\n  ElCarousel,\n  ElCarouselItem,\n  ElButton,\n  ElMenu,\n  ElMenuItem,\n  ElSelect,\n  ElOption,\n  ElRow,\n  ElCol,\n  ElCard,\n  ElPagination,\n} from \"element-plus\";\nimport { useRouter } from \"vue-router\"; // 导入路由\nimport { useStore } from \"vuex\"; // 导入 Vuex Store\n\nconst router = useRouter(); // 获取路由对象\nconst store = useStore(); // 获取 Vuex Store\nconst searchQuery = ref(\"\"); // 搜索查询\nconst selectedSort = ref(\"default-sort\"); // 默认排序方式\nconst currentPage = ref(1); // 当前页码\nconst itemsPerPage = ref(8); // 每页显示的商品数量\nconst sortedProducts = ref([]); // 存储排序后的产品\nconst ads = ref([\n  { image: \"/assets/苹果13.png\" },\n  { image: \"/assets/苹果15Pro.png\" },\n  { image: \"/assets/微软二合一ipad.png\" },\n]);\n\nconst goToProfile = () => {\n  router.push({ name: \"UsersPage\" }); // 跳转到个人中心页面\n};\n\n// 获取产品数据\nconst fetchProductData = async () => {\n  await store.dispatch(\"FetchProducts\"); // 调用 Vuex action 来加载产品数据\n};\n// 添加跳转到购物车的功能\nconst goToCart = () => {\n  router.push({ name: \"CartPage\" }); // 跳转到购物车页面\n};\n\n// 添加跳转到我的订单的功能\nconst goToOrders = () => {\n  router.push({ name: \"OrderPage\" }); // 跳转到我的订单页面\n};\n// 排序函数\nconst sortProducts = (products) => {\n  let sorted = [...products].map((product) => ({\n    ...product,\n    price: parseFloat(product.price) || 0,\n    sales: parseInt(product.sales) || 0,\n    createdAt: new Date(product.createdAt),\n  }));\n\n  switch (selectedSort.value) {\n    case \"low-to-high\":\n      sorted.sort((a, b) => a.price - b.price);\n      break;\n    case \"high-to-low\":\n      sorted.sort((a, b) => b.price - a.price);\n      break;\n    case \"hot-to-high\":\n      sorted.sort((a, b) => b.sales - a.sales);\n      break;\n    case \"default-sort\":\n    default:\n      sorted.sort((a, b) => b.createdAt - a.createdAt);\n      break;\n  }\n  return sorted;\n};\n\nonMounted(async () => {\n  await fetchProductData(); // 获取产品数据\n  const products = store.state.product.products; // 获取最新的产品列表\n  console.log(\"产品列表为：\", store.state.product.products);\n  if (products.length > 0) {\n    sortedProducts.value = sortProducts(products); // 对产品进行排序\n  }\n});\n\n// 计算属性获取用户昵称\nconst userNickname = computed(() => store.getters.userNickname);\n// 计算属性获取用户头像\nconst userAvatar = computed(\n  () => store.getters.userAvatar || \"/assets/avatar.png\",\n);\n\n// 获取当前页的产品\nconst paginatedProducts = computed(() => {\n  const start = (currentPage.value - 1) * itemsPerPage.value;\n  const end = start + itemsPerPage.value;\n  return sortedProducts.value.slice(start, end); // 返回当前页的产品\n});\n\n// 分页功能变化时的处理函数\nconst handlePageChange = (newPage) => {\n  currentPage.value = newPage; // 更新当前页\n};\n\n// 搜索功能\nconst applySearch = () => {\n  console.log(\"搜索产品:\", searchQuery.value);\n};\n\n// 跳转到首页并刷新\nconst goHome = () => {\n  window.location.reload(); // 强制刷新页面\n};\n\n// 跳转到商品详情\nconst viewProductDetails = (product) => {\n  console.log(`Navigating to product with ID: ${product.id}`); // 调试输出\n  router.push(`/product/${product.id}`);\n};\n\n// 选择分类\nconst selectCategory = (category) => {\n  console.log(`选择了分类: ${category}`);\n};\n\n// 退出登录功能\nconst logout = () => {\n  console.log(\"用户已注销\");\n  store.commit(\"clearUser\"); // 清空用户信息\n  router.push({ name: \"Login\" }); // 跳转到登录页面\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.homepage {\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n\n  .header {\n    background-color: #f8f8f8;\n    padding: 10px;\n    display: flex;\n    align-items: center;\n\n    .header-container {\n      display: flex;\n      align-items: center;\n      width: 100%;\n\n      .logo {\n        width: 50px;\n        height: auto;\n        margin-right: 10px;\n      }\n\n      .title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-right: 20px;\n      }\n\n      .home-button {\n        margin-right: 20px; /* 为首页按钮添加右边距 */\n      }\n\n      .user-actions {\n        display: flex;\n        align-items: center;\n        margin-right: 20px;\n\n        .user-nickname {\n          margin-right: 15px;\n          font-size: 16px;\n          color: #333;\n        }\n\n        .user-action {\n          cursor: pointer;\n          color: #333;\n          margin-right: 10px;\n        }\n        .search-container {\n          display: flex;\n          align-items: center;\n        }\n        .search-input {\n          padding: 10px;\n          border: 1px solid #ccc;\n          border-radius: 4px;\n          width: 600px;\n          margin-left: 10px;\n        }\n      }\n    }\n  }\n\n  .main-content {\n    display: flex;\n    flex-direction: row;\n  }\n\n  .user-avatar {\n    width: 40px; /* 头像宽度 */\n    height: 40px; /* 头像高度 */\n    border-radius: 50%; /* 圆形头像 */\n    margin-left: 10px; /* 与昵称之间的间距 */\n  }\n\n  .sidebar {\n    width: 200px;\n    background-color: #f4f4f4;\n    border-right: 1px solid #e4e4e4;\n  }\n\n  .category-menu {\n    padding: 10px;\n  }\n\n  .product-section {\n    flex-grow: 1;\n    padding: 20px;\n\n    .ad-banner {\n      display: flex;\n      align-items: center; /* 此时保持广告栏对齐 */\n      margin-bottom: 20px;\n\n      .static-ads {\n        display: flex; /* 使用 flexbox 使广告在同一行 */\n        flex: 1; /* 调整两侧静态广告的宽度 */\n        justify-content: space-between; /* 在广告之间留出间距 */\n        margin-right: 20px; /* 右侧留出间距 */\n      }\n\n      .ad-image {\n        height: 500px; /* 设置每个静态广告的高度 */\n        flex: 1; /* 每个广告等分宽度 */\n        object-fit: cover; /* 保持比例 */\n        margin: 0 10px; /* 设置广告之间的间隙 */\n      }\n\n      .carousel {\n        height: 500px; /* 高度设置为 500px 以对齐 */\n        flex: 2; /* 确保轮播占用更多空间 */\n        position: relative; /* 为了确保图片可以覆盖整个区域 */\n\n        .el-carousel__item {\n          height: 500px; /* 确保每个轮播项的高度为 500px */\n        }\n\n        .ad-image {\n          width: 100%; /* 确保图片宽度100% */\n          height: 100%; /* 确保图片高度为100% */\n          object-fit: cover; /* 确保图片填充，同时保持比例 */\n        }\n      }\n    }\n\n    .filter-section {\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n\n      El-select {\n        margin-right: 10px; /* 排序框右边距 */\n      }\n    }\n\n    .section-title {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    .product-card {\n      text-align: center;\n      height: 400px; /* 设置产品卡片的高度，根据需要调整 */\n      overflow: hidden; /* 隐藏溢出的部分 */\n      display: flex; /* 使用 flexbox 布局 */\n      flex-direction: column; /* 列方向排列子元素 */\n\n      .product-image {\n        flex: 1; /* 让产品图片占据剩余空间 */\n        width: 100%;\n        height: auto; /* 自适应高度 */\n        object-fit: cover; /* 确保图片填充，同时保持比例 */\n        border-radius: 4px;\n      }\n\n      .product-info {\n        margin-top: 10px; /* 调整与图片的间距 */\n        margin-bottom: 10px; /* 添加底部间距 */\n\n        .price {\n          font-size: 18px;\n          color: #f65a8b;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":"AA0JA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SACEC,UAAU,EACVC,cAAc,EACdC,QAAQ,EACRC,MAAM,EACNC,UAAU,EACVC,QAAQ,EACRC,QAAQ,EACRC,KAAK,EACLC,KAAK,EACLC,MAAM,EACNC,YAAY,QACP,cAAc;AACrB,SAASC,SAAS,QAAQ,YAAY,CAAC,CAAC;AACxC,SAASC,QAAQ,QAAQ,MAAM,CAAC,CAAC;;;;;;;;IAEjC,MAAMC,MAAM,GAAGF,SAAS,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMG,KAAK,GAAGF,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC1B,MAAMG,WAAW,GAAGlB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAC7B,MAAMmB,YAAY,GAAGnB,GAAG,CAAC,cAAc,CAAC,CAAC,CAAC;IAC1C,MAAMoB,WAAW,GAAGpB,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC;IAC5B,MAAMqB,YAAY,GAAGrB,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC;IAC7B,MAAMsB,cAAc,GAAGtB,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;IAChC,MAAMuB,GAAG,GAAGvB,GAAG,CAAC,CACd;MAAEwB,KAAK,EAAE;IAAmB,CAAC,EAC7B;MAAEA,KAAK,EAAE;IAAsB,CAAC,EAChC;MAAEA,KAAK,EAAE;IAAwB,CAAC,CACnC,CAAC;IAEF,MAAMC,WAAW,GAAGA,CAAA,KAAM;MACxBT,MAAM,CAACU,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAY,CAAC,CAAC,CAAC,CAAC;IACtC,CAAC;;IAED;IACA,MAAMC,gBAAgB,GAAG,MAAAA,CAAA,KAAY;MACnC,MAAMX,KAAK,CAACY,QAAQ,CAAC,eAAe,CAAC,CAAC,CAAC;IACzC,CAAC;IACD;IACA,MAAMC,QAAQ,GAAGA,CAAA,KAAM;MACrBd,MAAM,CAACU,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAW,CAAC,CAAC,CAAC,CAAC;IACrC,CAAC;;